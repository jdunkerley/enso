{
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "eslint": "^9.26.0",
    "eslint-plugin-jsdoc": "^50.6.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.5.14"
  },
  "dependencies": {
    "playwright": "catalog:",
    "tslib": "^2.8.1",
    "typescript": "catalog:"
  },
  "name": "root",
  "scripts": {
    "dev:gui": "corepack pnpm run --parallel -r --filter enso-gui --aggregate-output /^^^^dev:/",
    "dev:inspect": "corepack pnpm run -r --filter ydoc-inspect compile && node --inspect app/ydoc-inspect/dist/main.mjs",
    "compile": "corepack pnpm run -r compile",
    "build:gui": "corepack pnpm run -r compile && corepack pnpm run -r --filter enso-gui build",
    "build:ide": "corepack pnpm run -r compile && corepack pnpm run -r --filter enso build",
    "build:icons": "corepack pnpm run -r --filter enso-icons build",
    "build:ydoc-server-polyglot": "corepack pnpm postinstall && corepack pnpm run -r compile",
    "dist:ide": "corepack pnpm run -r --filter enso dist",
    "format": "prettier --write .",
    "format:workflows": "prettier --write .github/workflows",
    "ci-check": "corepack pnpm run -r compile && corepack pnpm run --aggregate-output /^ci:/",
    "ci:prettier": "prettier --check --cache .",
    "ci:lint": "corepack pnpm run -r --parallel lint --output-file eslint_report.json --format json --cache-strategy content",
    "ci:unit-test": "corepack pnpm run -r --parallel test:unit",
    "ci:typecheck": "corepack pnpm run -r --parallel typecheck",
    "git-clean": "node git-clean.mjs",
    "postinstall": "node internal/postinstall.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,cts,mts,ts,tsx,vue,json,jsonc,md,mdx,yml,yaml,html,css,scss}": "prettier --write"
  },
  "//": "To completely ignore deep dependencies, see .pnpmfile.cjs",
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
