{
  "compilerOptions": {
    "composite": true,
    "lib": ["es2017"],
    "module": "es2015",
    "moduleResolution": "bundler",
    "newLine": "lf",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "stripInternal": true,
    "target": "es6"
  },
  "include": ["./src"]
}
