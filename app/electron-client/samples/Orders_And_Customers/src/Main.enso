from Standard.Base import all
from Standard.Table import all
import Standard.Visualization

## Orders and Customers

   Joins orders to the customers who placed them, builds a cross-tab of spend by segment and
   category, and writes it to an Excel workbook.

   Select `spend` and pick the Table visualization to see the cross-tab. Writing a file is only
   previewed while you edit: press Write All (the play icon at the top of the graph) to write
   `output/spend_by_segment.xlsx` in this project, which `saved` then shows.

   The data is `orders.csv` and `customers.csv` in the shared `Samples/Data` folder, found
   relative to this project, so the sample only runs from its place in `Samples`. The data is
   synthetic.
main =
    ## The orders file in the shared Samples/Data folder.
    orders_file = enso_project.root.parent / 'Data' / 'orders.csv'
    ## One row per order.
    orders = Data.read orders_file (..Delimited headers=..Has_Headers)
    ## The customers file in the shared Samples/Data folder.
    customers_file = enso_project.root.parent / 'Data' / 'customers.csv'
    ## One row per customer, with their segment.
    customers = Data.read customers_file (..Delimited headers=..Has_Headers)
    ## Each order, with the customer who placed it.
    joined = orders.join customers (..Inner) [..Equals 'customer_id']
    ## The total spend per segment (rows) and category (columns).
    spend = joined.cross_tab ['segment'] 'category' (..Sum 'total') . sort [..Name 'segment']
    ## Where the workbook goes: the output folder of this project.
    report_file = enso_project.root / 'output' / 'spend_by_segment.xlsx'
    ## The cross-tab, written to a sheet of the workbook.
    saved = spend.write report_file (..Sheet 'Spend by segment') on_existing_file=..Overwrite
    saved



