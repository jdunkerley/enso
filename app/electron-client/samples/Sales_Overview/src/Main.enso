from Standard.Base import all
from Standard.Table import all
import Standard.Visualization

## Sales Overview

   Reads a messy sales CSV, cleans it up, and totals the sales by month and region.

   Select `sales` to see the messy input, and `totals` for the total of each month and region.
   Select `grid` and pick the Table visualization to see the same totals with one row per month
   and one column per region.

   The data is `sales.csv` in the shared `Samples/Data` folder, found relative to this project, so
   the sample only runs from its place in `Samples`. The data is synthetic.
main =
    ## The sales file in the shared Samples/Data folder.
    sales_file = enso_project.root.parent / 'Data' / 'sales.csv'
    ## One row per sale, with repeated sales, missing amounts and untidy region names.
    sales = Data.read sales_file (..Delimited headers=..Has_Headers)
    ## The first copy of each sale.
    unique = sales.distinct 'sale_id'
    ## The sales that have an amount.
    complete = unique.filter 'amount' (..Not_Nothing)
    ## The region names, trimmed and in title case.
    region = (complete.at 'region').map (r-> r.trim.to_case ..Title)
    ## The sales, with the tidy region names.
    cleaned = complete.set region 'region'
    ## The month of each sale, such as 2025-07.
    month = (cleaned.at 'sale_date').format 'yyyy-MM'
    ## The sales, with their month.
    dated = cleaned.set month 'month'
    ## The total sales of each month and region.
    totals = dated.aggregate ['month', 'region'] [..Sum 'amount' 'Total Sales']
    ## The totals, with one row per month and one column per region.
    grid = totals.cross_tab ['month'] 'region' (..Sum 'Total Sales') . sort [..Name 'month']
    grid



