from Standard.Base import all
from Standard.Table import all
from Standard.Database import all
from Standard.SQLite import all
import Standard.Visualization

## Local Database

   Loads a CSV of trips into an in-memory SQLite database, then summarizes it with a query that
   runs inside the database.

   Uploading to a database is only previewed while you edit, so `summary` first shows the SQL it
   would run. Press Write All (the play icon at the top of the graph) to run the upload.
   Select `summary` and pick the Table visualization to see the trips per mode of transport.

   The data is `trips.csv` in the shared `Samples/Data` folder, found relative to this project, so
   the sample only runs from its place in `Samples`. The data is synthetic.
main =
    ## The trips file in the shared Samples/Data folder.
    trips_file = enso_project.root.parent / 'Data' / 'trips.csv'
    ## One row per trip.
    trips = Data.read trips_file (..Delimited headers=..Has_Headers)
    ## SQLite stores dates as text, so the trip date is formatted before the upload.
    trip_date = (trips.at 'trip_date').format 'yyyy-MM-dd'
    ## The trips, with the date as text.
    prepared = trips.set trip_date 'trip_date'
    ## A database that lives in memory while the project is open.
    connection = Database.connect SQLite.In_Memory
    ## The trips, uploaded into a temporary table.
    table = prepared.select_into_database_table connection 'trips' temporary=True
    ## The number of trips, total distance and average time per mode, computed by the database.
    totals = table.aggregate ['mode'] [..Count, ..Sum 'distance_km', ..Average 'minutes']
    ## The modes, with the longest total distance first.
    summary = totals.sort [..Name 'Sum distance_km' ..Descending]
    summary



