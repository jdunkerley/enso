from Standard.Base import all
from Standard.Table import all
import Standard.Visualization

## Text Cleaning

   Tidies a messy contacts table: fixes the spacing and capitalization of names, splits them into
   first and last name, strips the punctuation from phone numbers, and pulls the reference code
   out of a free-text note with a regular expression.

   Select `contacts` to see the messy input, then `codes` for the clean result: a first and last
   name, a phone number of digits only, and the kind and number of each reference code.

   The data is `contacts.csv` in the shared `Samples/Data` folder, found relative to this project,
   so the sample only runs from its place in `Samples`. The data is synthetic.
main =
    ## The contacts file in the shared Samples/Data folder.
    contacts_file = enso_project.root.parent / 'Data' / 'contacts.csv'
    ## One row per contact, with untidy names and phone numbers.
    contacts = Data.read contacts_file (..Delimited headers=..Has_Headers)
    ## The names, with single spaces and in title case.
    name = (contacts.at 'name').map (n-> (n.trim.replace ' +'.to_regex ' ').to_case ..Title)
    ## The contacts, with the tidy names.
    tidy_names = contacts.set name 'name'
    ## The names, split at the space into two columns.
    split = tidy_names.split_to_columns 'name' ' '
    ## The columns, with clear names.
    names = split.rename_columns ['id', 'first_name', 'last_name', 'phone', 'note']
    ## The phone numbers, with only their digits.
    phones = names.text_replace 'phone' '[^0-9]'.to_regex ''
    ## The reference code in each note, as a kind and a number.
    codes = phones.parse_to_columns 'note' '(?<kind>[A-Z]{3})-(?<number>[0-9]+)'
    codes



