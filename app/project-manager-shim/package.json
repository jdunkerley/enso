{
  "name": "project-manager-shim",
  "version": "0.1.0",
  "description": "Shared operations and types for project manager shim",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./handler": {
      "source": "./src/handler/index.ts",
      "types": "./dist/handler/index.d.ts",
      "import": "./dist/handler/index.js"
    },
    "./localMetadata": {
      "source": "./src/localMetadata/index.ts",
      "types": "./dist/localMetadata/index.d.ts",
      "import": "./dist/localMetadata/index.js"
    },
    "./localSecrets": {
      "source": "./src/localSecrets/index.ts",
      "types": "./dist/localSecrets/index.d.ts",
      "import": "./dist/localSecrets/index.js"
    },
    "./localVersioning": {
      "source": "./src/localVersioning/index.ts",
      "types": "./dist/localVersioning/index.d.ts",
      "import": "./dist/localVersioning/index.js"
    },
    "./projectService": {
      "source": "./src/projectService/index.ts",
      "types": "./dist/projectService/index.d.ts",
      "import": "./dist/projectService/index.js"
    }
  },
  "main": "src/index.ts",
  "scripts": {
    "test:unit": "vitest run",
    "compile": "tsc",
    "lint": "eslint . --cache --max-warnings=0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "enso-common": "workspace:*",
    "ksuid": "^3.0.0",
    "portfinder": "^1.0.38",
    "tar": "^7.5.22",
    "trash": "^9.0.0",
    "yaml": "^2.9.1"
  }
}
