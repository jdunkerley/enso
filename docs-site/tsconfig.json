{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "@docusaurus/module-type-aliases", "@docusaurus/theme-classic"],
    "customConditions": ["source"],
    "paths": {
      "@site/*": ["./*"],
      "@/*": ["../app/gui/src/project-view/*"],
      "$/*": ["../app/gui/src/*"],
      "#/*": ["../app/gui/src/dashboard/*"]
    }
  },
  "include": ["generator", "src", "e2e", "scripts", "*.ts"]
}
