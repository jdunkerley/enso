{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java+",
      "request": "launch",
      "name": "Launch Enso File"
    },
    {
      "name": "Listen to 5005",
      "type": "java+",
      "request": "attach",
      "listen": "true",
      "hostName": "localhost",
      "port": "5005"
    },
    {
      "name": "Debug Adapter Protocol",
      "type": "node",
      "debugServer": 4711,
      "request": "attach"
    },
    {
      "name": "Enso GUI",
      "type": "editor-browser",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceRoot}/app/gui",
      "preLaunchTask": "Enso GUI",
    },
  ]
}