## ---
   private: true
   ---
   Make an aggregate column selector.
make_aggregate_column_selector table:Table -> Widget =
    column_widget kinds = ["column", make_column_name_selector table add_expression=True kinds=kinds]
    any_column = column_widget []
    text_column = column_widget [Column_Kind.Textual]
    numeric_column = column_widget [Column_Kind.Numeric]

    count = Option "..Count" "..Count"

    ## Currently can't support nested vector editors so using single picker
    col_list_selector = make_column_name_multi_selector table
    count_distinct = Option "..Count_Distinct" "..Count_Distinct" [["columns", col_list_selector]]

    ## Currently can't support nested vector editors so using single order by picker
    order_by_selector = make_order_by_selector table name_only=True
    first = Option "..First" "..First" [any_column, ["order_by" , order_by_selector]]
    last = Option "..Last" "..Last" [any_column, ["order_by" , order_by_selector]]

    count_not_nothing = Option "..Count_Not_Nothing" "..Count_Not_Nothing" [any_column]
    count_nothing = Option "..Count_Nothing" "..Count_Nothing" [any_column]

    count_not_empty = Option "..Count_Not_Empty" "..Count_Not_Empty" [text_column]
    count_empty = Option "..Count_Empty" "..Count_Empty" [text_column]
    concatenate = Option "..Concatenate" "..Concatenate" [text_column, ["separator", make_separator_selector]]
    shortest = Option "..Shortest" "..Shortest" [text_column]
    longest = Option "..Longest" "..Longest" [text_column]

    sum = Option "..Sum" "..Sum" [numeric_column]
    average = Option "..Average" "..Average" [numeric_column]
    median = Option "..Median" "..Median" [numeric_column]
    percentile = Option "..Percentile" "..Percentile" [numeric_column]
    mode = Option "..Mode" "..Mode" [any_column]
    standard_deviation = Option "..Standard_Deviation" "..Standard_Deviation" [numeric_column]

    # Should be a list of comparable columns only
    maximum = Option "..Maximum" "..Maximum" [any_column]
    minimum = Option "..Minimum" "..Minimum" [any_column]

    ## Spatial Aggregation Functions
    spatial_aggregations = if table.is_a Spatial_Table == False then [] else
        spatial_widget_selector = make_column_name_selector table add_expression=True
        spatial_widget = ["column", spatial_widget_selector]
        [Option "..ST_Union" "..ST_Union" [spatial_widget], Option "..ST_Intersection" "..ST_Intersection" [spatial_widget], Option "..ST_Extent" "..ST_Extent" [spatial_widget]]

    ## SQL Aggregation Function
    sql_function = if table.underlying.is_a In_Memory_Table then [] else
        [Option "<SQL Function>" "..SQL" [["arguments", col_list_selector]]]

    Single_Choice values=[count, sum, average, maximum, minimum, count_distinct, first, last, count_not_nothing, count_nothing, count_not_empty, count_empty, concatenate, shortest, longest, median, percentile, mode, standard_deviation]+spatial_aggregations+sql_function

## ---
   private: true
   ---
   Make an Aggregate_Column list editor
make_aggregate_column_vector_selector table:Table -> Widget =
    item_editor = make_aggregate_column_selector table
    # TODO this is a workaround for a dropdown issue
    Vector_Editor item_editor=item_editor item_default="..Count"

## ---
   private: true
   ---
   Make a column name selector.
   The picker names the call's subject, not the `table` passed in.
make_column_name_selector table:(Table|Row) add_expression:Boolean=False kinds:Vector=[] -> Widget =
    _ = table
    Widget.Column_Name kinds=kinds expression=add_expression

## ---
   private: true
   ---
   Make a multiple column name selector.
   The picker names the call's subject, not the `table` passed in.
make_column_name_vector_selector table:Table -> Widget =
    _ = table
    Widget.Column_Vector

## ---
   private: true
   ---
   Make a multiple column-name selector that allows each value to be selected at
   most once.
   The picker names the call's subject, not the `table` passed in.
make_column_name_multi_selector table:Table add_regex:Boolean=False add_by_type:Boolean=False kinds:Vector=[] -> Widget =
    _ = table
    Widget.Column_Names kinds=kinds regex=add_regex by_type=add_by_type

## ---
   private: true
   ---
   Make a column reference by name selector.
   The picker names the call's subject, not the `table` passed in.
make_column_ref_by_name_selector table add_text:Boolean=False add_regex:Boolean=False add_number:Boolean=False add_boolean:Boolean=False add_named_pattern:Boolean=False add_date:Boolean=False add_time:Boolean=False add_date_time:Boolean=False add_nothing:Boolean=False columns_first:Boolean=False kinds:Vector=[] -> Widget =
    constants = make_any_selector add_text=add_text add_regex=add_regex add_named_pattern=add_named_pattern add_number=add_number add_boolean=add_boolean add_date=add_date add_time=add_time add_date_time=add_date_time add_nothing=add_nothing . values
    if table.is_nothing then Single_Choice values=constants else
        Widget.Column_Name kinds=kinds reference=True expression=True extra=constants columns_first=columns_first

## ---
   private: true
   ---
   Make a column reference by name selector filtered by type.

   The numeric types all offer the `Numeric` kind, so
   `if_value_type_numeric_include_all_numeric` no longer changes the answer.
make_column_ref_by_name_selector_for_type table value_type:Value_Type add_nothing:Boolean=False if_value_type_numeric_include_all_numeric:Boolean=False -> Widget =
    _ = if_value_type_numeric_include_all_numeric
    is_all = _include_all value_type
    include_number = is_all || value_type.is_numeric
    include_text = is_all || value_type.is_text
    include_boolean = is_all || value_type.is_boolean
    include_date = is_all || value_type.is_date
    include_date_time = is_all || value_type.is_date_time
    include_time = is_all || value_type.is_time

    constants = make_any_selector add_text=include_text add_number=include_number add_boolean=include_boolean add_date=include_date add_time=include_time add_date_time=include_date_time add_nothing=add_nothing . values
    if table.is_nothing then Single_Choice values=constants else
        Widget.Column_Name kinds=(_kinds_for [value_type]) reference=True expression=True extra=constants

## ---
   private: true
   ---
   If `column_source` is Nothing, `Column_Ref` options will not be added.
make_fill_default_value_selector column_source=Nothing value_types=Value_Type.Mixed add_nothing:Boolean=False -> Widget =
    types = Vector.unify_vector_or_element value_types
    to_add = Types_To_Include.Value types
    constants = make_any_selector add_text=to_add.text add_number=to_add.number add_boolean=to_add.boolean add_date=to_add.date add_time=to_add.time add_date_time=to_add.date_time add_nothing=add_nothing . values
    previous_value = [Option 'Previous Value' 'Previous_Value']
    if column_source.is_nothing then Single_Choice values=(previous_value+constants) else
        Widget.Column_Name kinds=(_kinds_for types) reference=True expression=True extra=(previous_value+constants)

## ---
   private: true
   ---
   Make a filter condition selector: a resolver of the table and the `column`
   argument (its value type decides the conditions offered).
make_filter_condition_selector table (column = Nothing) -> Widget =
    column_value_type = _get_column_value_type table column
    column_chooser = make_column_ref_by_name_selector_for_type table add_nothing=False value_type=column_value_type if_value_type_numeric_include_all_numeric=True
    regex_chooser = make_column_ref_by_name_selector table add_regex=True kinds=[Column_Kind.Textual]

    is_all = _include_all column_value_type
    include_text = is_all || column_value_type.is_text
    include_boolean = is_all || column_value_type.is_boolean
    include_floating = is_all || column_value_type.is_floating_point

    options = Vector.build builder->
        builder.append (Option "..Equal" parameters=[["to", column_chooser]])
        builder.append (Option "..Not_Equal" parameters=[["to", column_chooser]])
        builder.append (Option "..Is_Nothing")
        builder.append (Option "..Not_Nothing")
        value_editor = Widget.Vector_Editor item_editor=column_chooser item_default='""'
        builder.append (Option "..Is_In" parameters=[["values", value_editor]])

        if column_value_type.has_ordering && column_value_type!=Value_Type.Boolean then
            comparison_options = Vector.build comparison_builder->
                comparison_builder.append (Option "..Less" parameters=[["than", column_chooser]])
                comparison_builder.append (Option "..Equal_Or_Less" parameters=[["than", column_chooser]])
                comparison_builder.append (Option "..Greater" parameters=[["than", column_chooser]])
                comparison_builder.append (Option "..Equal_Or_Greater" parameters=[["than", column_chooser]])
                comparison_builder.append (Option "..Between" parameters=[["lower", column_chooser], ["upper", column_chooser]])
            builder.append (Option "Comparisons" comparison_options)

        if include_text then
            text_options = Vector.build text_builder->
                text_builder.append (Option "..Is_Empty")
                text_builder.append (Option "..Not_Empty")
                text_builder.append (Option "..Equal_Ignore_Case" parameters=[["to", column_chooser]])
                text_builder.append (Option "..Starts_With" parameters=[["prefix", column_chooser]])
                text_builder.append (Option "..Ends_With" parameters=[["suffix", column_chooser]])
                text_builder.append (Option "..Contains" parameters=[["substring", column_chooser]])
                text_builder.append (Option "..Like" parameters=[["pattern", column_chooser]])
                text_builder.append (Option "..Regex_Match" "..Regex_Match (regex '.*')" parameters=[["pattern", regex_chooser]])
            builder.append (Option "Text" text_options)

        if include_boolean then
            boolean_options = Vector.build boolean_builder->
                boolean_builder.append (Option "..Is_True")
                boolean_builder.append (Option "..Is_False")
            builder.append (Option "Boolean" boolean_options)

        if include_floating then
            numeric_options = Vector.build numeric_builder->
                numeric_builder.append (Option "..Is_Finite")
                numeric_builder.append (Option "..Is_Infinite")
                numeric_builder.append (Option "..Is_Nan")
                numeric_builder.append (Option "..Not_Nan")
            builder.append (Option "Numeric" numeric_options)

    Single_Choice options

## ---
   private: true
   ---
   Make a join condition selector: a resolver of the table and the `right`
   argument. The pickers name the call's subject (and `from="right"`), not the
   `table` passed in; `table` only decides whether spatial conditions are
   offered, and `right` whether its columns can be picked.
make_join_condition_selector table:Table (right = Nothing) -> Widget =
    self_selector = Widget.Column_Name
    right_selector = if right.is_nothing then Text_Input else
        Widget.Column_Name from="right"
    text_self_selector = Widget.Column_Name kinds=[Column_Kind.Textual]
    text_right_selector = if right.is_nothing then Text_Input else
        Widget.Column_Name kinds=[Column_Kind.Textual] from="right"

    equals = Option "Equals" "..Equals" [["left", self_selector], ["right", right_selector]]
    equals_ci = Option "Equals (Ignore Case)" "..Equals_Ignore_Case" [["left", text_self_selector], ["right", text_right_selector]]
    between = Option "Between" "..Between" [["left", self_selector], ["right_lower", right_selector], ["right_upper", right_selector]]
    names=[equals, equals_ci, between]

    spatial = if table.is_a Spatial_Table then [Spatial_Join_Condition.widget_option self_selector right_selector] else []

    item_editor = Single_Choice values=names+spatial
    first_name = (table.at 0).name
    Vector_Editor item_editor=item_editor item_default="(..Equals "+first_name.pretty+")"

## ---
   private: true
   ---
make_grouping_method_selector table:Table -> Widget =
    column_selector = make_column_name_selector table
    columns_selector = make_column_name_multi_selector table

    unique = Option "..Unique" "..Unique" [["on", columns_selector]]
    equal_count = Option "..Equal_Count" "..Equal_Count" [["order_by", columns_selector]]
    equal_sum = Option "..Equal_Sum" "..Equal_Sum" [["on", column_selector], ["order_by", columns_selector]]
    standard_deviation = Option "..Standard_Deviation" "..Standard_Deviation" [["on", column_selector]]
    names=[unique, equal_count, equal_sum, standard_deviation]

    Single_Choice values=names

## ---
   private: true
   ---
   Make a column name selector.
   The picker names the call's subject, not the `table` passed in.
make_order_by_selector table:Table name_only:Boolean=False -> Widget =
    _ = table
    Widget.Order_By name_only=name_only

## ---
   private: true
   ---
   Make a column rename name selector: a resolver of the table and the
   `column_map` argument (the names it already uses).
make_rename_name_vector_selector table:Table (column_map = Nothing) -> Widget =
    col_names = table.column_names

    ## Resolved Used Names
    col_map = column_map
    used_names = case col_map of
        _ : Dictionary -> col_map
        _ : Vector ->
            pairs =  col_map.map_with_index i-> p-> if p.is_a Text then [col_names.get i, p] else p
            Dictionary.from_vector pairs
        _ -> Dictionary.empty
    first_name = if used_names.length == 0 then col_names.first else
        col_names.find n->(used_names.contains_key n . not) if_missing=col_names.first

    new_name_i = 0.up_to used_names.length include_end=True . find i->
        target = if i == 0 then 'New Name' else 'New Name '+i.to_text
        used_names.values.contains target . not
    new_name = if new_name_i == 0 then 'New Name' else 'New Name '+new_name_i.to_text

    fqn = Pair.to Meta.Type . qualified_name
    name = Option "Name" fqn+".Value" [["first", Widget.Column_Name extra=[Option "<Regular Expression>" "(regex '^.*$')"]]]
    item_editor = Single_Choice values=[name]
    Vector_Editor item_editor=item_editor item_default="(Pair.Value "+first_name.pretty+" "+new_name.pretty+")"

## ---
   private: true
   ---
   Selector for type argument on `Column.parse`.
parse_type_selector -> Widget =
    valid_parse_targets = Parse_Values_Helper.valid_parse_targets

    names = ['Auto'] + valid_parse_targets

    choice = names.map n-> if n=='Auto' then (Auto.to Meta.Type . qualified_name) else n

    options = names.zip choice . map pair-> Option pair.first pair.second
    Single_Choice values=options

## ---
   private: true
   ---
   Selector for writing a table to a file.
write_table_selector -> Widget =
    can_write type = if type==JSON_Format || type==JSON_Lines_Format then True else
        Meta.meta type . methods . contains "write_table"
    all_types = [Auto_Detect] + (File_Format_SPI.get_types.filter can_write)
    Single_Choice values=(all_types.flat_map .get_dropdown_options)

## ---
   private: true
   ---
   Make a format chooser for a selection of columns: a resolver of the table
   and the `columns` argument (their value types decide the formats offered).
make_format_chooser_for_selection table (columns = Nothing) =
    types = if columns.is_nothing then [Value_Type.Mixed] else
        ##  (selectors:(Text | Integer | Regex | By_Type | Vector)) (case_sensitivity:Case_Sensitivity) (reorder:Boolean) (error_on_missing_columns:Boolean) (on_problems:Problem_Behavior) (error_on_empty:Boolean=True) =
        real_columns = table.columns_helper.select_columns columns case_sensitivity=..Sensitive reorder=False error_on_missing_columns=False on_problems=..Ignore error_on_empty=False
        if real_columns.length == 0 then [Value_Type.Mixed] else real_columns.map .value_type
    make_format_chooser_for_type types

## ---
   private: true
   ---
   Make a format chooser for a parse function: a resolver of the table (or
   column) and the `type` argument.
make_format_chooser_for_parse table (type = Nothing) =
    _ = table
    make_format_chooser_for_type (type.if_nothing Value_Type.Mixed)

## ---
   private: true
   ---
   Make format selector based off value type
make_format_chooser_for_type : Value_Type | Vector -> Widget
make_format_chooser_for_type value_types =
    vector = Vector.unify_vector_or_element value_types
    include_number    = vector.any value_type-> value_type.is_numeric || value_type==Value_Type.Mixed
    include_date      = vector.any value_type-> value_type==Value_Type.Date || value_type==Value_Type.Mixed
    include_date_time = vector.any value_type-> value_type.is_date_time || value_type==Value_Type.Mixed
    include_time      = vector.any value_type-> value_type==Value_Type.Time || value_type==Value_Type.Mixed
    include_boolean   = vector.any value_type-> value_type.is_boolean || value_type==Value_Type.Mixed
    make_format_chooser include_number include_date include_date_time include_time include_boolean

## ---
   private: true
   ---
   Make value type selector for type filtering
make_value_type_vector_selector : Widget
make_value_type_vector_selector =
    meta = Meta.meta Value_Type
    options = meta.constructors.map c-> Option c.name ".."+c.name
    item_editor = Single_Choice values=options
    Vector_Editor item_editor=item_editor item_default="..Boolean"

## ---
   private: true
   ---
   Make a replace builder.
make_replace_selector : Widget
make_replace_selector =
    key_selector = make_any_selector add_text=True add_regex=True add_number=True add_boolean=True add_named_pattern=True add_date=True add_time=True add_date_time=True add_nothing=False
    value_selector = make_any_selector add_text=True add_regex=True add_number=True add_boolean=True add_named_pattern=True add_date=True add_time=True add_date_time=True add_nothing=True
    fqn = Pair.to Meta.Type . qualified_name
    name = Option "Pair" fqn+".Value" [["first", key_selector], ["second", value_selector]]
    item_editor = Single_Choice values=[name]
    Vector_Editor item_editor=item_editor item_default="(Pair.Value 'Current' 'New')"

## PRVIATE Make widget for choosing whether or not to ignore length differences
   in columns and tables. The `Report_Unmatched` option additionally requests a
   warning or error on such length differences.
make_keep_unmatched_selector =
    make_single_choice [["True", "Boolean.True"], ["False", "Boolean.False"], ["Report", Report_Unmatched.to Meta.Type . qualified_name]]

## ---
   private: true
   ---
type Types_To_Include
    ## ---
       private: true
       ---
    private Value types:Vector

    ## ---
       group: Standard.Base.Metadata
       icon: metadata
       ---
       Are there any number columns?
    number self = self.types.any value_type-> value_type.is_numeric || value_type==Value_Type.Mixed

    ## ---
       group: Standard.Base.Metadata
       icon: metadata
       ---
       Are there any boolean columns?
    boolean self = self.types.any value_type-> value_type.is_boolean || value_type==Value_Type.Mixed

    ## ---
       group: Standard.Base.Metadata
       icon: metadata
       ---
       Are there any text columns?
    text self = self.types.any value_type-> value_type.is_text || value_type==Value_Type.Mixed

    ## ---
       group: Standard.Base.Metadata
       icon: metadata
       ---
       Are there any date columns?
    date self = self.types.any value_type-> value_type.is_date || value_type==Value_Type.Mixed

    ## ---
       group: Standard.Base.Metadata
       icon: metadata
       ---
       Are there any time columns?
    time self = self.types.any value_type-> value_type.is_time || value_type==Value_Type.Mixed

    ## ---
       group: Standard.Base.Metadata
       icon: metadata
       ---
       Are there any date_time columns?
    date_time self = self.types.any value_type-> value_type.is_date_time || value_type==Value_Type.Mixed

## ---
   private: true
   ---
   The value type of the column `raw_column` names (a name, an expression or
   a column), or `default`.
private _get_column_value_type table raw_column default:Value_Type=Value_Type.Mixed =
    column = case raw_column of
        Nothing -> Nothing
        _ : Text -> table.get raw_column
        _ : Expression -> table.evaluate_expression raw_column ..Ignore
        _ -> raw_column
    Panic.catch Any handler=_->default <|
        if Nothing == column then default else column.value_type

## ---
   private: true
   ---
   Treat Value_Type as if it could be any type (i.e. include all constants and
   types).
private _include_all value_type:Value_Type -> Boolean =
    case value_type of
        Value_Type.Mixed -> True
        Value_Type.Unsupported_Data_Type _ _  -> True
        _ -> False

## ---
   private: true
   ---
   The kinds of column that hold values of the given types; none (every kind)
   when any type could be anything.
private _kinds_for value_types:Vector -> Vector Column_Kind =
    if value_types.any (t-> (_include_all t) || (t == Value_Type.Null)) then [] else
        value_types.map Column_Kinds.of_value_type . distinct
