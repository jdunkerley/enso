private

import Standard.Base.Data.Read.Return_As
import Standard.Base.System.File_Format.File_Format_SPI

import project.Delimited.Delimited_Format.Delimited_Format
import project.Return_As_Table.Return_As_Table

type Impl

File_Format_SPI.from (that:Impl) =
    _ = that
    File_Format_SPI.new Delimited_Format "delimited"

Return_As.SPI.from (that:Impl) =
    _ = that
    Return_As.SPI.new Return_As_Table
