from Standard.Base import all

import Standard.Visualization.Internal.View_Json
from Standard.Visualization.Internal.View_Json import View_Column, View_Link
import Standard.Visualization.Viz_Action.Viz_Action
import Standard.Visualization.Viz_Actions.Viz_Actions
import Standard.Visualization.Viz_Cell.Viz_Cell
from Standard.Visualization.Viz_Column_Kind import Viz_Column_Kind, Viz_Kind

import project.Value_Type.Value_Type

polyglot java import org.enso.table.util.TableValueCache

## ---
   private: true
   ---
   Visualization's kind for a column of this value type.
column_kind (value_type : Value_Type) -> Viz_Column_Kind =
    kind = if value_type.is_numeric then Viz_Kind.Numeric else
        if value_type.is_text then Viz_Kind.Textual else
            if value_type.is_boolean then Viz_Kind.Logical else
                case value_type of
                    Value_Type.Date -> Viz_Kind.Date_Only
                    Value_Type.Date_Time _ -> Viz_Kind.Date_And_Time
                    Value_Type.Time -> Viz_Kind.Time_Only
                    _ -> Viz_Kind.Other
    Viz_Column_Kind.Value kind value_type.to_name

## ---
   private: true
   ---
column_kinds table -> Vector Viz_Column_Kind =
    table.columns.map (c-> column_kind c.value_type)

## ---
   private: true
   ---
table_cell table (level : Integer) -> Text =
    if level != 0 then "Table{" + table.row_count.to_text + " rows x " + table.column_count.to_text + " columns}" else
        truncated = table.columns.take 5 . map _.name
        prepared = if table.column_count > 5 then truncated + ["… " + (table.column_count - 5).to_text+ " more"] else truncated
        "Table{" + table.row_count.to_text + " rows x [" + (prepared.join ", ") + "]}"

## ---
   private: true
   ---
column_cell column (level : Integer) -> Text =
    if level != 0 then "Column{" + column.name + ": " + column.row_count.to_text + " rows}" else
        items = Viz_Cell.render_value column.to_vector level
        "Column{" + column.name + ": " + items + "}"

## ---
   private: true
   ---
row_cell row (level : Integer) -> Text =
    if level != 0 then "Row{" + row.length + " columns}" else
        truncated = row.column_names.take 5 . map _.to_text
        prepared = if row.length > 5 then truncated + ["… " + (row.length - 5).to_text+ " more"] else truncated
        "Row{" + (prepared.join ", ") + "}"

## ---
   private: true
   ---
   The table view of a single row: a `column` column that links to the value,
   and a `value` column.
row_table_view_json row -> Text =
    values = (0.up_to row.length).map idx-> Viz_Cell.render_value (row.get idx)
    columns = [View_Column.Value "column" (View_Link.Value "at {{@column}}"), View_Column.Value "value"]
    View_Json.grid_json (columns.map .to_json_text) [row.column_names.to_json, values.to_json] row.length

## ---
   private: true
   ---
   The node actions of a table, in memory or in a database: a row, a column,
   a cell, the table toolbar's sort, filter and column changes, and the
   scatter plot's brush. A small fixed vector.
table_actions -> Viz_Actions = Viz_Actions.Value <|
    open_row = Viz_Action.chain "open_row" "Get Row" "select_row" "get_row {{#index}}"
    open_column = Viz_Action.chain "open_column" "Get Column" "select_column" "at {{@column}}"
    open_cell = Viz_Action.chain "open_cell" "Get Value" "select_cell" "get_value {{@column}} {{#index}}"
    sort = Viz_Action.chain "sort" "Sort" "" "sort {{columns*}}"
    filter = Viz_Action.chain "filter" "Filter" "" "filter {{@column}} {{condition}}"
    remove_columns = Viz_Action.chain "remove_columns" "Remove Columns" "" "remove_columns {{@columns*}}"
    reorder_columns = Viz_Action.chain "reorder_columns" "Reorder Columns" "" "reorder_columns {{@columns*}}"
    brush_filter = Viz_Action.chain "brush_filter" "Filter To Selection" "" "filter {{@column}} (..Between {{#min}} {{#max}})"
    [open_row, open_column, open_cell, sort, filter, remove_columns, reorder_columns, brush_filter]

## ---
   private: true
   ---
   The node actions of a table, as `table_actions` but with their JSON kept:
   it is the same for every table, and writing it costs more than the rest of
   adding it to a message.
cached_table_actions -> Viz_Actions = cached_actions "viz_actions:table" table_actions

## ---
   private: true
   ---
   The node actions of a column, in memory or in a database: a value by
   number.
column_actions -> Viz_Actions =
    Viz_Actions.Value [Viz_Action.chain "open_row" "Get Value" "select_cell" "at {{#index}}"]

## ---
   private: true
   ---
   The node actions of a column, as `column_actions` but with their JSON kept.
cached_column_actions -> Viz_Actions = cached_actions "viz_actions:column" column_actions

## ---
   private: true
   ---
   `actions` with their JSON written once per engine, kept in the shared
   `TableValueCache` under `key`. A message touches the key, so it stays
   recent. Only the text is kept: `actions` itself is built only when its
   `actions` vector is read.
private cached_actions (key : Text) ~actions -> Viz_Actions =
    cached = TableValueCache.get key
    if Nothing != cached then Viz_Actions.Json cached actions.actions else
        text = actions.to_json_text
        TableValueCache.put key text
        Viz_Actions.Json text actions.actions
