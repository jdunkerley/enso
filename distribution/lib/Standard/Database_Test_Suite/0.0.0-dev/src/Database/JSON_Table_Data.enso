from Standard.Base import all

type JSON_Table_Data
    Value ~connection

    expected self =
        _ = self
        ['{"defaultMargin": 22}', 'null', 'true', 'false', '123', '"string value"', '{"defaultMargin": 22, "otherValue": "test", "nestedObject": {"nestedKey": "nestedValue"}}', '[1, 2, 3, 4, 5]', '["string1", "string2", "string3"]', '[{"key1": "value1"}, {"key2": "value2"}, {"key3": "value3"}]', '3.14159267', Nothing]

    expected_objects self =
        self.expected.map e-> if e.is_nothing then e else e.parse_json

    setup create_connection_fn types =
        make_connection =
            connection = create_connection_fn Nothing
            types.each type_name->
                table_name = 'tbl_' + type_name + '_test'
                make_table_sql = 'DROP TABLE IF EXISTS ' + table_name + '; CREATE TEMPORARY TABLE ' + table_name + '(id INTEGER PRIMARY KEY, payload ' + type_name + '); INSERT INTO ' + table_name + ' VALUES (0, \'{"defaultMargin": 22}\'), (1, \'null\'), (2, \'true\'), (3, \'false\'), (4, \'123\'), (5, \'"string value"\'), (6, \'{"defaultMargin": 22, "otherValue": "test", "nestedObject": {"nestedKey": "nestedValue"}}\'), (7, \'[1, 2, 3, 4, 5]\'), (8, \'["string1", "string2", "string3"]\'), (9, \'[{"key1": "value1"}, {"key2": "value2"}, {"key3": "value3"}]\'), (10, \'3.14159267\'), (11, null);'
                connection.execute_update make_table_sql
            connection
        JSON_Table_Data.Value make_connection

    teardown self =
        self.connection.close
