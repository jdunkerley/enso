from Standard.Base import all

polyglot java import org.enso.fixed_width.FixedWidthLineTooLongException

## Indicates that when loading a fixed-width file, a row was encountered which
   was not long enough for the specified fixed-width column layout.
   Only the first 10 rows are reported, any additional ones are aggregated into a
   single instance of `Additional_Invalid_Rows`.
type Invalid_Fixed_Width_Row
    ## ---
       private: true
       ---
    Error (source_line_number : Integer) (table_row_number : Integer | Nothing) (line_length : Integer | Nothing) (minimum_line_length : Integer | Nothing)

    ## ---
       private: true
       ---
       Create a human-readable version of the error.
    to_display_text : Text
    to_display_text self =
        table_loc = case self.table_row_number of
            Nothing -> ""
            _ -> ", table row "+self.table_row_number.to_text
        loc = "(line "+self.source_line_number.to_text+table_loc+")"
        "The row " + loc + " had length " + self.line_length.to_text + ", but a length of at least " + self.minimum_line_length.to_text + " was expected"

## Indicates that when loading a fixed-width file, the lines did not all have the
   same length
type Inconsistent_Fixed_Width_Lengths
    ## ---
       private: true
       ---
    Error

    ## ---
       private: true
       ---
       Create a human-readable version of the error.
    to_display_text : Text
    to_display_text self =
        "The fixed-width file had lines of differing lengths."

## Indicates that a fixed-width file contains a line that is too long.
type Fixed_Width_Line_Too_Long
    ## ---
       private: true
       ---
    private Error source_line_number:Integer max_line_length:Integer

    ## ---
       private: true
       ---
    to_display_text self -> Text = "Fixed width file line " + self.source_line_number.to_text + " is longer than the maximum length of " + self.max_line_length.to_text

    ## ---
       private: true
       ---
    private handle_java_exception =
        Panic.catch FixedWidthLineTooLongException handler=(e -> Error.throw (Fixed_Width_Line_Too_Long.Error e.payload.sourceLineNumber e.payload.maxLineLength))

    ## ---
       private: true
       ---
    to_js_object : JS_Object
    to_js_object self =
        JS_Object.from_pairs [["type", "Fixed_Width_Line_Too_Long"], ["sourceLineNumber", self.sourceLineNumber], ["maxLineLength", self.maxLineLength]]

