import project.Data.Dictionary.Dictionary
import project.Data.Json.JS_Object
import project.Data.Text.Text
import project.Data.Vector.Vector
import project.Enso_Cloud.Enso_File.Enso_Asset_Type
import project.Enso_Cloud.Enso_File.Enso_File
import project.Enso_Cloud.Internal.Enso_Path.Enso_Path
import project.Enso_Cloud.Internal.Existing_Enso_Asset.Credential_Secret_Metadata
import project.Enso_Cloud.Internal.Existing_Enso_Asset.Existing_Enso_Asset
import project.Enso_Cloud.Internal.Utils
import project.Errors.File_Error.File_Error
import project.Errors.Illegal_Argument.Illegal_Argument
import project.Network.HTTP.HTTP_Method.HTTP_Method
import project.Network.URI.URI
import project.Panic.Panic
import project.Runtime
import project.Runtime.Context
from project.Data.Boolean import Boolean, False, True
from project.Data.Text.Extensions import all
from project.Enso_Cloud.Enso_File import list_assets
from project.Error import all
from project.Nothing import all

polyglot java import org.enso.base.enso_cloud.EnsoSecretHelper
polyglot java import org.enso.base.enso_cloud.EnsoHideableValue
polyglot java import org.enso.base.enso_cloud.LocalSecretException
polyglot java import org.enso.base.enso_cloud.LocalSecrets

## A reference to a secret stored locally (`secret://name`) or in the Enso
   Cloud (`enso://…`).

   Local secrets are kept encrypted in `~/.enso/secrets.json`. See
   `docs/local-secrets.md` in the Enso repository for where the file is, how
   the key is found and how to use local secrets on a server.
type Enso_Secret
    ## ---
       private: true
       ---
    private Value internal_name:Text id:Text internal_path:Enso_Path credential_metadata:Credential_Secret_Metadata|Nothing

    ## ---
       private: true
       ---
       A secret in the local secrets store. Its `id` is `local:<name>` and its
       path is `secret://<name>`.
    private Local internal_name:Text id:Text internal_path:Text credential_metadata:Nothing

    ## ---
       group: Metadata
       icon: metadata
       ---
       The name of the secret.
    name : Text
    name self = self.internal_name

    ## ---
       group: Metadata
       icon: metadata
       ---
       The path of the secret.
    path : Text
    path self = self.internal_path.to_text

    ## ---
       group: EnsoCloud
       icon: edit
       ---
       Create a new secret.

       ## Arguments
        - `name`: The name of the secret
        - `value`: The value of the secret
        - `parent`: The Enso Cloud folder for the secret. If `Nothing` then it
          will be created in the local secrets store, as `secret://<name>`.
    create : Text -> Text -> Enso_File | Nothing -> Enso_Secret
    create name:Text value:Text parent:(Enso_File | Nothing)=Nothing =
        _validate_name name
        Context.Output.check_enabled disabled_message="As writing is disabled, cannot create a secret. Press the Write button ▶ to perform the operation."
        case parent of
            Nothing ->
                if name.length > 200 then Error.throw (Illegal_Argument.Error "Secret name cannot be longer than 200 characters.") else
                    _local name (LocalSecrets.create name value) . if_not_error <|
                        _make_local name
            parent_dir : Enso_File -> _create_in_cloud name value parent_dir

    ## ---
       group: Output
       icon: trash
       ---
       Deletes a secret.
    delete : Enso_Secret
    delete self =
        Context.Output.check_enabled disabled_message="As writing is disabled, cannot delete secret. Press the Write button ▶ to perform the operation."
        case self of
            Enso_Secret.Local _ _ _ _ ->
                _local self.name (LocalSecrets.delete self.name) . if_not_error <|
                    EnsoSecretHelper.deleteSecretFromCache self.id
                    self
            _ ->
                uri = URI.from (secret_asset_uri self) . add_query_argument "force" "true"
                response = Utils.http_request HTTP_Method.Delete uri
                response.if_not_error self

    ## ---
       group: EnsoCloud
       icon: key
       ---
       Gets a list of all the secrets in the folder.

       ## Arguments
        - `folder`: The Enso Cloud folder to get the secrets from. If `Nothing`
          then will list the secrets in the local secrets store.
    list : Enso_File | Nothing -> Vector Enso_Secret
    list parent:(Enso_File | Nothing)=Nothing = case parent of
        Nothing ->
            names = _local Nothing LocalSecrets.list
            names.if_not_error <|
                Vector.from_polyglot_array names . map _make_local
        effective_parent : Enso_File ->
            secrets_as_assets = list_assets effective_parent . filter f-> f.asset_type == Enso_Asset_Type.Secret
            secrets_as_assets.map asset->
                _from_asset asset (effective_parent.enso_path.resolve asset.title)

    ## ---
       group: EnsoCloud
       icon: key
       suggested: 6
       ---
       Gets a Secret, either from the local secrets store or from the Enso
       Cloud.

       ## Arguments
        - `name`: The name of the secret, a `secret://` path to a local secret,
          or an `enso://` path to a secret in the Enso Cloud.
        - `parent`: The Enso Cloud folder for the secret, if resolving by name.
          If `Nothing` then a name is looked up in the local secrets store. If
          an `enso://` path is provided, the parent argument is not considered
          and must be `Nothing`.
    get : Text -> Enso_File | Nothing -> Enso_Secret ! Enso_Secret_Error
    get name:Text parent:(Enso_File | Nothing)=Nothing =
        is_path = name.starts_with Enso_Path.protocol_prefix
        is_local_path = name.starts_with LocalSecrets.PATH_PREFIX
        case is_path of
            True ->
                if parent != Nothing then Error.throw (Illegal_Argument.Error "Parent argument must be Nothing when resolving by `enso://` path.") else
                    Enso_Secret.resolve_path name
            False -> case parent of
                _ : Enso_File ->
                    if is_local_path then Error.throw (Illegal_Argument.Error "Parent argument must be Nothing when resolving by `secret://` path.") else
                        cloud_path = parent.enso_path.resolve name . to_text
                        Enso_Secret.resolve_path cloud_path
                Nothing ->
                    local_name = if is_local_path then name.drop LocalSecrets.PATH_PREFIX.length else name
                    found = _local local_name (LocalSecrets.exists local_name)
                    found.if_not_error <|
                        if found then _make_local local_name else
                            Error.throw (Enso_Secret_Error.Not_Found LocalSecrets.PATH_PREFIX+local_name)

    ## ---
       private: true
       ---
    resolve_path (path:Text) -> Enso_Secret ! Enso_Secret_Error =
        resolved_path = Enso_Path.parse path
        resolved_path.if_not_error <|
            asset = Existing_Enso_Asset.resolve_path resolved_path.to_text if_not_found=(Error.throw (Enso_Secret_Error.Not_Found resolved_path.to_text))
            if asset.asset_type != Enso_Asset_Type.Secret then Error.throw (Illegal_Argument.Error "The provided path points to "+asset.asset_type.to_text+", not a Secret.") else
                _from_asset asset resolved_path

    ## ---
       group: EnsoCloud
       icon: metadata
       ---
       Checks if a Secret exists.

       ## Arguments
        - `name`: The name of the secret
        - `parent`: The Enso Cloud folder for the secret. If `Nothing` then will
          check in the local secrets store.
    exists : Text -> Enso_File | Nothing -> Boolean
    exists name:Text parent:(Enso_File | Nothing)=Nothing =
        local_name = if parent.is_nothing && name.starts_with LocalSecrets.PATH_PREFIX then name.drop LocalSecrets.PATH_PREFIX.length else name
        Enso_Secret.list parent . any s-> s.name == local_name

    ## ---
       group: Output
       icon: edit
       ---
       Updates the value of a secret.

       ## Arguments
        - `new_value`: The new value of the secret

       ## Remarks

       ### Secret Caching
       Note that secret values are cached, so the update may not be visible in
       other workflows unless they are restarted. You can also use the
       `Enso_User.flush_caches` function to flush the caches.
    update_value : Text -> Enso_Secret
    update_value self (new_value : Text) =
        Context.Output.check_enabled disabled_message="As writing is disabled, cannot update secret. Press the Write button ▶ to perform the operation."
        response = case self of
            Enso_Secret.Local _ _ _ _ ->
                _local self.name (LocalSecrets.update self.name new_value)
            _ ->
                body = JS_Object.from_pairs [["value", new_value]]
                Utils.http_request HTTP_Method.Put (secret_resource_uri self) body
        Error.return_if_error response

        EnsoSecretHelper.deleteSecretFromCache self.id
        self

    ## ---
       private: true
       ---
       Returns a text representation of the secret.
    to_text : Text
    to_text self =
        "Enso_Secret" + (_credential_info_text self) + " " + self.path.to_text

    ## ---
       private: true
       ---
       Returns a display text representation of the secret.
    to_display_text : Text
    to_display_text self =
        "Enso_Secret {" + self.name + (_credential_info_text self) + "}"

    ## ---
       private: true
       ---
       Converts the secret to a JSON object.
    to_js_object : JS_Object
    to_js_object self =
        extra = if self.credential_metadata.is_nothing then [] else
            [["credential_for", self.credential_metadata.service_name]]
        JS_Object.from_pairs [["type", "Enso_Secret"], ["constructor", "get"], ["path", self.path.to_text]]+extra

    ## ---
       private: true
       group: convert
       icon: enso_logo
       ---
       Convert the value to a corresponding Enso code representation.
    pretty : Text
    pretty self = "Enso_Secret.get " + self.path.to_text.pretty

    ## ---
       private: true
       ---
       Checks if this secret is a regular text value or a credential used for
       connecting with external services.
       Regular secrets and credentials can be used in different contexts.
    is_credential self -> Boolean = self.credential_metadata.is_nothing.not

    ## ---
       private: true
       ---
       Returns the name of the service that this credential is associated with,
       or Nothing if this secret is not a credential.
       Useful in filtering credentials for widgets.
    credential_service_name self -> Text | Nothing =
        self.credential_metadata.if_not_nothing <|
            self.credential_metadata.service_name

## ---
   private: true
   ---
type Enso_Secret_Error
    ## ---
       private: true
       ---
    Access_Denied
    ## ---
       private: true
       ---
    Not_Found resolved_path

    ## ---
       private: true
       ---
       The local secrets store has secrets, but no key to decrypt them.
    Locked

    ## ---
       private: true
       ---
       The local secrets store was written with a different key.
    Wrong_Key

    ## ---
       private: true
       ---
    to_display_text : Text
    to_display_text self = case self of
        Enso_Secret_Error.Access_Denied -> "Cannot read secret value into Enso."
        Enso_Secret_Error.Not_Found resolved_path -> "Cannot find secret: "+resolved_path
        Enso_Secret_Error.Locked -> "Local secrets are locked: set ENSO_SECRETS_KEY or use Enso on the desktop where they were created."
        Enso_Secret_Error.Wrong_Key -> "The local secrets file was created with a different key."

## A derived value that may be derived from secrets.
type Derived_Secret_Value
    ## ---
       private: true
       ---
    Plain_Text (text : Text)

    ## ---
       private: true
       ---
    Secret_Value (secret : Enso_Secret)

    ## ---
       private: true
       ---
    Concat (left : Derived_Secret_Value) (right : Derived_Secret_Value)

    ## ---
       private: true
       ---
    Base_64_Encode (value : Derived_Secret_Value)

    ## ---
       private: true
       ---
       Interprets the value as a Private Key.
    Interpret_As_Private_Key (secret : Enso_Secret)

    ## ---
       private: true
       ---
    + self (other : Derived_Secret_Value) = Derived_Secret_Value.Concat self other

    ## ---
       private: true
       ---
       Converts to a plain text value, if the value contains no secrets.
       If the value contains secrets, it raises an error.
    to_plain_text : Text ! Enso_Secret_Error
    to_plain_text self =
        derived = Derived_Secret_Value.from self
        if EnsoHideableValue.containsSecrets derived then
            Error.throw Enso_Secret_Error.Access_Denied
        EnsoHideableValue.safeResolve derived

    ## ---
       private: true
       ---
    to_text : Text
    to_text self =
        derived = Derived_Secret_Value.from self
        EnsoHideableValue.render derived

    ## ---
       private: true
       ---
    to_display_text self -> Text = self.to_text.to_display_text

    ## ---
       private: true
       ---
       If this value does not contains any secrets, it will be simplified to a
       plain Text value, otherwise it will be returned as is.
    simplify : Derived_Secret_Value | Text
    simplify self = self.to_plain_text.catch Enso_Secret_Error _->self

    ## ---
       private: true
       ---
    value_type self -> Text = case self of
        Derived_Secret_Value.Plain_Text _ -> EnsoHideableValue.PLAIN_TYPE
        Derived_Secret_Value.Secret_Value _ -> EnsoHideableValue.SECRET_TYPE
        Derived_Secret_Value.Concat _ _ -> EnsoHideableValue.CONCAT_TYPE
        Derived_Secret_Value.Base_64_Encode _ -> EnsoHideableValue.BASE64_TYPE
        Derived_Secret_Value.Interpret_As_Private_Key _ -> EnsoHideableValue.PRIVATE_KEY_TYPE

    ## ---
       private: true
       ---
    text_value self -> Text | Nothing = case self of
        Derived_Secret_Value.Plain_Text text -> text
        Derived_Secret_Value.Secret_Value secret -> secret.id
        _ -> Nothing

    ## ---
       private: true
       ---
    children self -> Vector Derived_Secret_Value = case self of
        Derived_Secret_Value.Concat left right -> [left, right]
        Derived_Secret_Value.Base_64_Encode inner -> [inner]
        Derived_Secret_Value.Interpret_As_Private_Key secret -> [Derived_Secret_Value.Secret_Value secret]
        _ -> []

## ---
   private: true
   ---
Derived_Secret_Value.from (that : Text) = Derived_Secret_Value.Plain_Text that

## ---
   private: true
   ---
Derived_Secret_Value.from (that : Enso_Secret) = Derived_Secret_Value.Secret_Value that

## ---
   private: true
   ---
   Used by library implementations to convert an Enso object into the Java
   counterpart.
as_credential_reference (secret : Enso_Secret) credential_reference =
    case secret.credential_metadata of
        Nothing ->
            Error.throw (Illegal_Argument.Error "Secret "+secret.name+" is not a credential.")
        metadata ->
            credential_reference.new secret.id metadata.service_name

## ---
   private: true
   ---
secret_resource_uri secret =
    Utils.secrets_api + "/" + secret.id

## ---
   private: true
   ---
secret_asset_uri secret =
    Utils.assets_api + "/" + secret.id

## Checks a secret name against the rules shared by local and cloud secrets.
private _validate_name name:Text -> Nothing =
    if name == "" then Error.throw (Illegal_Argument.Error "Secret name cannot be empty") else
        if name.starts_with "connection-" then Error.throw (Illegal_Argument.Error "Secret name cannot start with 'connection-'") else
            if name.contains "/" then Error.throw (Illegal_Argument.Error "Secret name cannot contain `/`.") else
                if name.starts_with LocalSecrets.PATH_PREFIX then Error.throw (Illegal_Argument.Error "Secret name cannot start with 'secret://'.") else
                    Nothing

## Runs a call into the local secrets store, turning its failures into
   dataflow errors. `name` is the secret the call is about, if any.
private _local name:Text|Nothing ~action =
    handle_store_error caught =
        Error.throw (local_secret_error caught.payload name)
    ## An unreadable or unwritable file, or a lock that could not be taken, is
       an `IOException`: report it as the `File_Error` the standard library
       gives any other file problem.
    File_Error.handle_java_exceptions Nothing <|
        Panic.catch LocalSecretException action handle_store_error

## ---
   private: true
   ---
   The error for a `LocalSecretException` from the local secrets store: an
   `Enso_Secret_Error` for a missing secret, a locked store or another key, and
   an `Illegal_Argument` for anything else. `name` is the secret the call was
   about, if the exception does not say.

   `EnsoSecretHelper` calls this when resolving a local secret's value for an
   HTTP request fails, so that using the secret is a dataflow error rather
   than a Java panic.
local_secret_error e name:Text|Nothing=Nothing =
    secret_name = if e.secretName.is_nothing then name else e.secretName
    case e.kind.name of
        "NOT_FOUND" -> Enso_Secret_Error.Not_Found (if secret_name.is_nothing then e.getMessage else LocalSecrets.PATH_PREFIX+secret_name)
        "LOCKED" -> Enso_Secret_Error.Locked
        "WRONG_KEY" -> Enso_Secret_Error.Wrong_Key
        _ -> Illegal_Argument.Error e.getMessage

## ---
   private: true
   ---
   Runs `action`, which may resolve local secrets' values in Java (for example
   a JDBC connection's credentials), turning a `LocalSecretException` it panics
   with into the matching dataflow error.
handle_local_secret_panics ~action =
    Panic.catch LocalSecretException action caught->
        Error.throw (local_secret_error caught.payload)

private _make_local name:Text -> Enso_Secret =
    Enso_Secret.Local name LocalSecrets.ID_PREFIX+name LocalSecrets.PATH_PREFIX+name Nothing

private _create_in_cloud name:Text value:Text parent_dir:Enso_File -> Enso_Secret =
    path = parent_dir.enso_path.resolve name
    Error.return_if_error path

    parent_dir_asset = Existing_Enso_Asset.get_asset_reference_for parent_dir
    body = JS_Object.from_pairs <|
        [["name", name], ["value", value], ["parentDirectoryId", parent_dir_asset.id]]
    handle_already_exists _ =
        message = "A secret with the name " + name.pretty + " already exists inside of directory " + parent_dir.name + "."
        Error.throw (Illegal_Argument.Error message)
    error_handlers = Dictionary.from_vector [["resource_already_exists", handle_already_exists]]
    id = Utils.http_request_as_json HTTP_Method.Post Utils.secrets_api body error_handlers=error_handlers
    # A secret created using the regular flow is a normal secret, so it does not contain credential metadata
    credential_metadata = Nothing
    Enso_Secret.Value name id path credential_metadata

private _from_asset (asset : Existing_Enso_Asset) (path : Enso_Path) -> Enso_Secret =
    Runtime.assert (asset.metadata != Nothing)
    Enso_Secret.Value asset.title asset.id path asset.metadata.credential_metadata

private _credential_info_text (secret : Enso_Secret) -> Text =
    case secret.credential_metadata of
        Nothing -> ""
        credential_metadata ->
            state_suffix = case credential_metadata.state of
                "Expired" -> " (expired)"
                "WaitingForAuthentication" -> " (waiting for authentication)"
                _ -> ""
            " (credentials for "+credential_metadata.service_name+state_suffix+")"
