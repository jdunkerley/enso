type File_Action
    ## The File or Folder is for reading from.
    Open

    ## The File or Folder is for writing to.
    Save

    ## ---
       private: true
       ---
       In-lined JSON representation of the File_Action.
    to_json self = case self of
        File_Action.Open -> '{"constructor":"Open"}'
        File_Action.Save -> '{"constructor":"Save"}'

type Choice
    ## Describes an entry in a Single_Choice or Multiple_Choice widget.

       ## Arguments
        - `label`: The text to display for the entry.
        - `value`: The code to insert for the entry. By default, the `label` is
          used.
        - `parameters`: A list of parameters for the arguments for the `value`.
          This provides the structure needed for nested widgets.
        - `icon`: The icon to display for the entry. By default, no icon is used.
        - `requires`: The fully qualified name of a type whose library the entry
          needs, e.g. `"Standard.SQLite.SQLite_Format.SQLite_Format"`. Choosing
          the entry adds that library's import. By default, none.
        - `patterns`: The file name patterns (e.g. `*.db`) of the files the
          entry reads. When a path argument of the same call changes, a single
          matching entry adds the import of its `requires`. By default, none.
    Option label:Text value:(Text | Vector Choice)=label parameters:(Vector (Pair Text Widget))=[] icon:Text="" requires:Text="" patterns:(Vector Text)=[]

    ## ---
       private: true
       ---
       In-lined JSON representation of the Choice. `requires` and `patterns`
       appear only when set, so an option without them serialises as before.
    to_json self -> Text =
        parameter_json = if self.parameters.length == 0 then '[]' else
            '[' + ((self.parameters.map p-> '[' + p.first.to_json + ',' + p.second.to_json + ']').join ',') + ']'
        requires_json = if self.requires == "" then "" else ',"requires":' + self.requires.to_json
        patterns_json = if self.patterns.is_empty then "" else ',"patterns":' + self.patterns.to_json
        value_json = case self.value of
            _ : Vector -> '[' + (self.value.map v-> v.to_json).join ',' + ']'
            _ -> self.value.to_json
        '{"label":' + self.label.to_json + ',"value":' + value_json + ',"parameters":' + parameter_json + ',"icon":' + self.icon.to_json + requires_json + patterns_json + '}'

type File_Type
    ## Describes a file type.

       ## Arguments
        - `label`: The text to display for the file type.
        - `extensions`: A list of extensions for the file type. Extensions do not
          include the dot, the only supported glob pattern is '*' (all files).
        - `icon`: The icon to display for the file type.
    Option label:Text extensions:(Vector Text)=[label] icon:Text=""

type Widget
    ## Describes a single value widget (dropdown).

       ## Arguments
        - `values`: A list of choices to display.
        - `allow_custom`: Allow the user to enter a value not in the list?
    Single_Choice values:(Vector Choice) allow_custom:Boolean=True

    ## Describes a list editor widget producing a Vector.
       Items can be dragged around to change the order, or dragged out to be
       deleted from the Vector.

       ## Arguments
        - `item_editor`: The widget to use for editing the items.
        - `item_default`: The default value for new items inserted when the user
          clicks the `+` button.
    Vector_Editor item_editor:Widget item_default:Text

    ## Describes a multi value widget.
    Multiple_Choice values:(Vector Choice) quote_values:Boolean=False

    ## Describe a boolean parameter.
    Boolean_Input

    ## Describe a numeric parameter.
    Numeric_Input
        minimum:Integer|Nothing=Nothing
        maximum:Integer|Nothing=Nothing
        step:Number=1
        decimal_places:Integer=0
        allow_outside:Boolean=True

    ## Describes a text widget.
    Text_Input
        quote_values:Boolean = True
        suggestions:(Vector Text) = []
        syntax:Nothing|Text = Nothing

    ## Describes a folder chooser.
    Folder_Browse

    ## Describes a file chooser.
    File_Browse
        existing_only:Boolean=True
        action:File_Action=..Open
        file_types:(Vector File_Type)=[File_Type.Option "All Files" ["*"]]

    ## Describes a secret chooser.
    Secret_Browse

    ## ---
       private: true
       ---
       The date picker.
    Date_Input

    ## ---
       private: true
       ---
       The date-and-time picker.
    Date_Time_Input

    ## ---
       private: true
       ---
       The time-of-day picker.
    Time_Input

    ## Describes possible target types for Any.to conversion.
    Any_To_Target

    ## Describes an argument that takes one of several kinds of value: the IDE
       shows a picker of the kinds in front of the chosen kind's widget.

       Its JSON is
       `{"constructor":"Union","kinds":[["<label>",<widget>],…],"include_nothing":<Boolean>}`:
       each kind a pair of its label and its widget's JSON, in picker order.
       With no kinds and `include_nothing=True`
       (`{"constructor":"Union","kinds":[],"include_nothing":true}`), `Nothing`
       is the only kind, and an unset argument shows `Nothing`.

       ## Arguments
        - `kinds`: The kinds, in the order the picker lists them: a label and
          the widget for a value of that kind.
        - `include_nothing`: Whether `Nothing` is a kind too (listed last).
    Union kinds:(Vector (Pair Text Widget)) include_nothing:Boolean=False

    ## ---
       private: true
       ---
       A regular-expression input: the IDE edits the pattern's text and writes
       `regex '…'`.
    Regex_Input

    ## Describes a column name chooser, for a parameter that takes the name of a
       column of a table.

       ## Arguments
        - `kinds`: The kinds of column offered; empty offers every column.
        - `from`: The name of the argument holding the table the columns come
          from; `Nothing` means the table the node is called on.
        - `expression`: Also accept an expression in place of a name?
        - `reference`: Offer the names as column references?
        - `extra`: Further entries offered alongside the columns.
        - `columns_first`: List the columns before the extra entries?
    Column_Name kinds:(Vector Column_Kind)=[] from:(Text|Nothing)=Nothing expression:Boolean=False reference:Boolean=False extra:(Vector Choice)=[] columns_first:Boolean=False

    ## Describes a chooser of several column names.

       ## Arguments
        - `kinds`: The kinds of column offered; empty offers every column.
        - `from`: The name of the argument holding the table the columns come
          from; `Nothing` means the table the node is called on.
        - `regex`: Also accept a regular expression?
        - `by_type`: Also accept a selection by column type?
    Column_Names kinds:(Vector Column_Kind)=[] from:(Text|Nothing)=Nothing regex:Boolean=False by_type:Boolean=False

    ## Describes a chooser of a vector of columns.

       ## Arguments
        - `kinds`: The kinds of column offered; empty offers every column.
        - `from`: The name of the argument holding the table the columns come
          from; `Nothing` means the table the node is called on.
    Column_Vector kinds:(Vector Column_Kind)=[] from:(Text|Nothing)=Nothing

    ## Describes a chooser of sort orders over the columns of a table.

       ## Arguments
        - `from`: The name of the argument holding the table the columns come
          from; `Nothing` means the table the node is called on.
        - `name_only`: Offer plain column names rather than ordering objects?
    Order_By from:(Text|Nothing)=Nothing name_only:Boolean=False

    ## ---
       private: true
       ---
       A widget computed from the call by `function`, a resolver: its first
       parameter receives the call's subject, every other parameter an
       argument of the call by name (defaulted to `Nothing`) or `search : Text
       = ""`, the text typed in the argument (see
       `Standard.Base.Metadata.Widget_Resolver`). Only ever an argument's whole
       widget, or a type's default: nested in another widget, its JSON is an
       error.

       ## Arguments
        - `function`: The resolver.
    Resolver function:Function

    ## ---
       private: true
       ---
       A resolver's text names it, not its function.
    to_text self -> Text = case self of
        Widget.Resolver _ -> "Widget.Resolver"
        _ -> Any.to_text self=self

    ## ---
       private: true
       ---
       Inlined JSON representation specifically paired with `app/gui/src/project-view/providers/widgetRegistry/configuration.ts`.
    to_json self -> Text = case self of
        Widget.Single_Choice values _ ->
            values_json = if values.length == 0 then '[]' else '[' + (values.map v-> v.to_json).join ',' + ']'
            '{"constructor":"Single_Choice","values":' + values_json + '}'
        Widget.Vector_Editor item_editor item_default ->
            '{"constructor":"Vector_Editor","item_editor":' + item_editor.to_json + (if item_default==Nothing then ',"item_default":"_"' else ',"item_default":' + item_default.to_json) + '}'
        Widget.Multiple_Choice values _ ->
            values_json = if values.length == 0 then '[]' else '[' + (values.map v-> v.to_json).join ',' + ']'
            '{"constructor":"Multiple_Choice","values":' + values_json + '}'
        Widget.Boolean_Input -> '{"constructor":"Boolean_Input"}'
        Widget.Numeric_Input minimum maximum _ _ _ ->
            '{"constructor":"Numeric_Input"' + (if minimum.is_nothing then '' else ',"minimum":' + minimum.to_json) + (if maximum.is_nothing then '' else ',"maximum":' + maximum.to_json) + '}'
        Widget.Text_Input _ _ syntax ->
            '{"constructor":"Text_Input"' + (if syntax.is_nothing then '' else ',"syntax":' + syntax.to_json) + '}'
        Widget.Folder_Browse -> '{"constructor":"Folder_Browse"}'
        Widget.File_Browse existing_only action file_types ->
            action_json = case action of
                File_Action.Save -> '"Save"'
                _ -> '"Open"'
            '{"constructor":"File_Browse","existing_only":' + (if existing_only then "true" else "false") + ',"action":' + action_json + ',"file_types":' + file_types.to_json + '}'
        Widget.Secret_Browse -> '{"constructor":"Secret_Browse"}'
        Widget.Date_Input -> '{"constructor":"Date_Input"}'
        Widget.Date_Time_Input -> '{"constructor":"Date_Time_Input"}'
        Widget.Time_Input -> '{"constructor":"Time_Input"}'
        Widget.Union kinds include_nothing ->
            kinds_json = '[' + (kinds.map p-> '[' + p.first.to_json + ',' + p.second.to_json + ']').join ',' + ']'
            '{"constructor":"Union","kinds":' + kinds_json + ',"include_nothing":' + (if include_nothing then "true" else "false") + '}'
        Widget.Regex_Input -> '{"constructor":"Regex_Input"}'
        Widget.Column_Name kinds source expression reference extra columns_first ->
            '{"constructor":"Column_Name","kinds":' + '[' + (kinds.map .to_json . join ',') + ']' + ',"from":' + source.to_json + ',"expression":' + expression.to_json + ',"reference":' + reference.to_json + ',"extra":' + '[' + (extra.map .to_json . join ',') + ']' + ',"columns_first":' + columns_first.to_json + '}'
        Widget.Column_Names kinds source regex by_type ->
            '{"constructor":"Column_Names","kinds":' + '[' + (kinds.map .to_json . join ',') + ']' + ',"from":' + source.to_json + ',"regex":' + regex.to_json + ',"by_type":' + by_type.to_json + '}'
        Widget.Column_Vector kinds source ->
            '{"constructor":"Column_Vector","kinds":' + '[' + (kinds.map .to_json . join ',') + ']' + ',"from":' + source.to_json + '}'
        Widget.Order_By source name_only ->
            '{"constructor":"Order_By","from":' + source.to_json + ',"name_only":' + name_only.to_json + '}'
        Widget.Resolver _ -> Widget.nested_resolver_error
        _ -> self.to_js_object.to_json

    ## ---
       private: true
       ---
       The distinct `from` values of every column picker in the widget, in the
       order first seen, looking through choices, vector editors and union
       kinds. `Nothing` stands for the table the node is called on.
    column_sources self -> Vector (Text | Nothing) =
        Vector.build builder-> self.collect_column_sources builder

    ## ---
       private: true
       ---
       Appends the sources of the pickers in this widget to the builder, each
       once.
    collect_column_sources self builder -> Nothing = case self of
        Widget.Column_Name _ source _ _ _ _ -> add_source builder source
        Widget.Column_Names _ source _ _ -> add_source builder source
        Widget.Column_Vector _ source -> add_source builder source
        Widget.Order_By source _ -> add_source builder source
        Widget.Single_Choice values _ -> collect_choice_sources values builder
        Widget.Multiple_Choice values _ -> collect_choice_sources values builder
        Widget.Vector_Editor item_editor _ -> item_editor.collect_column_sources builder
        Widget.Union kinds _ -> kinds.each pair-> pair.second.collect_column_sources builder
        _ -> Nothing

    ## ---
       private: true
       ---
       The error of a `Resolver` asked for its JSON: the widget query runs a
       resolver, it never serialises one.
    nested_resolver_error -> Any =
        Error.throw (Illegal_Argument.Error "A Widget.Resolver can only be an argument's whole widget.")

    ## ---
       private: true
       ---
       Override the to_js_object and don't include Nothing.
    to_js_object : JS_Object
    to_js_object self = case self of
        Widget.Resolver _ -> Widget.nested_resolver_error
        _ ->
            type_pair = [["type", Meta.type_of self . to_text]]

            m = Meta.meta self
            cons = m.constructor
            cons_pair = [["constructor", cons.name]]

            fs = m.fields
            field_names = cons.fields
            field_pairs = 0.up_to field_names.length . filter (i-> fs.at i . is_nothing . not) . map i->
                [field_names.at i, fs.at i . to_js_object]

            JS_Object.from_pairs (type_pair + cons_pair + field_pairs)

## ---
   private: true
   ---
make_single_choice values:Vector -> Widget =
    make_option value = case value of
        _ : Vector -> Choice.Option value.first value.second
        _ : Text -> Choice.Option value value.pretty
        _ : Choice -> value
    Widget.Single_Choice (values.map make_option)

## ---
   private: true
   ---
   The default widget for arguments of type `Boolean`.
Widget.from (that : Boolean.type) -> Widget =
    _ = that
    Widget.Boolean_Input

## ---
   private: true
   ---
   The default widget for arguments of type `Integer`.
Widget.from (that : Integer.type) -> Widget =
    _ = that
    Widget.Numeric_Input

## ---
   private: true
   ---
   The default widget for arguments of type `Float`.
Widget.from (that : Float.type) -> Widget =
    _ = that
    Widget.Numeric_Input

## ---
   private: true
   ---
   The default widget for arguments of type `Number`.
Widget.from (that : Number.type) -> Widget =
    _ = that
    Widget.Numeric_Input

## ---
   private: true
   ---
   The default widget for arguments of type `Text`.
Widget.from (that : Text.type) -> Widget =
    _ = that
    Widget.Text_Input

## ---
   private: true
   ---
   The default widget for arguments of type `Date`.
Widget.from (that : Date.type) -> Widget =
    _ = that
    Widget.Date_Input

## ---
   private: true
   ---
   The default widget for arguments of type `Date_Time`.
Widget.from (that : Date_Time.type) -> Widget =
    _ = that
    Widget.Date_Time_Input

## ---
   private: true
   ---
   The default widget for arguments of type `Time_Of_Day`.
Widget.from (that : Time_Of_Day.type) -> Widget =
    _ = that
    Widget.Time_Input

## ---
   private: true
   ---
   The default widget for arguments of type `File`.
Widget.from (that : File.type) -> Widget =
    _ = that
    Widget.File_Browse

## ---
   private: true
   ---
   The default widget for arguments of type `Writable_File`.
Widget.from (that : Writable_File.type) -> Widget =
    _ = that
    Widget.File_Browse existing_only=False action=..Save

## ---
   private: true
   ---
   The default widget for arguments of type `Enso_Secret`.
Widget.from (that : Enso_Secret.type) -> Widget =
    _ = that
    Widget.Secret_Browse

## ---
   private: true
   ---
   The default widget for arguments of type `Regex`.
Widget.from (that : Regex.type) -> Widget =
    _ = that
    Widget.Regex_Input

## Appends the sources of the column pickers in the parameters of the choices
   to the builder, looking into nested choices.
private collect_choice_sources values builder -> Nothing =
    values.each choice->
        choice.parameters.each pair-> pair.second.collect_column_sources builder
        case choice.value of
            nested : Vector -> collect_choice_sources nested builder
            _ -> Nothing

## Appends the source unless the builder already holds it.
private add_source builder source -> Nothing =
    seen = 0.up_to builder.length . any i-> builder.at i == source
    if seen.not then builder.append source
