import project.Any.Any
import project.Data.Array_Proxy.Array_Proxy
import project.Data.Filter_Condition.Filter_Condition
import project.Data.Json.JS_Object
import project.Data.Numbers.Integer
import project.Data.Pair.Pair
import project.Data.Text.Text
from project.Data.Text.Extensions import all
import project.Data.Time.Date.Date
import project.Data.Time.Date_Period.Date_Period
import project.Data.Time.Period.Period
import project.Data.Vector.Vector
import project.Error.Error
import project.Errors.Common.Index_Out_Of_Bounds
import project.Errors.Common.Not_Found
import project.Errors.Empty_Error.Empty_Error
import project.Errors.Illegal_Argument.Illegal_Argument
import project.Function.Function
from project.Data.Boolean import Boolean, False, True
from project.Data.Range.Extensions import all
from project.Data.Time.Date import make_period_selector
from project.Internal.Predicate_Helpers import unify_condition_or_predicate, unify_condition_predicate_or_element
from project.Metadata import Widget
from project.Nothing import all
from project.Runtime import assert

polyglot java import org.enso.base.Time_Utils

## Represents a range of dates.
type Date_Range
    ## ---
       private: true
       ---
       Never use the constructor directly to construct a range, as it does not
       allow to verify invariants and may lead to unexpected behavior.
    Internal_Constructor (start_internal : Date) (end_internal : Date) (step_internal : Period) (increasing_internal : Boolean) (cached_length_internal : Integer)

    ## ---
       icon: time
       arguments:
         start: always
         end: always
       ---
       Creates a range of dates from `start` up to, but not including, `end`.
       The range is increasing if `start` is before `end`, and decreasing if it
       is after.

       ## Arguments
       - `start`: The first date of the range. It is included.
       - `end`: The end of the range. It is excluded.
       - `step`: The step between dates, a `Date_Period` or a `Period`. It must
         be positive: to count down, put the later date in `start`.

       ## Examples
       ### The days from 5 to 8 December
       ```
       range = Date_Range.new (Date.new 2021 12 5) (Date.new 2021 12 8)
       days = range.to_vector
       # → [2021-12-05, 2021-12-06, 2021-12-07]
       ```

       ### A decreasing range
       ```
       range = Date_Range.new (Date.new 2021 12 8) (Date.new 2021 12 5)
       days = range.to_vector
       # → [2021-12-08, 2021-12-07, 2021-12-06]
       ```

       ### The last day of each month
       ```
       range = Date_Range.new (Date.new 2021 1 31) (Date.new 2021 5 1) Date_Period.Month
       days = range.to_vector
       # → [2021-01-31, 2021-02-28, 2021-03-31, 2021-04-30]
       ```

       ## Remarks

       ### A step that is not positive
       A `Period` step must have no negative part and at least one positive part.
       Otherwise the result is an `Illegal_Argument` error.
    @step make_period_selector
    new (start : Date = Date.today) (end : Date = Date.today) (step : Date_Period | Period = Date_Period.Day) -> Date_Range ! Illegal_Argument =
        increasing = start <= end
        Date_Range.new_internal start end increasing step

    ## ---
       private: true
       ---
    new_internal : Date -> Date -> Boolean -> Date_Period|Period -> Date_Range
    new_internal start end increasing step =
        one_day = Period.new days=1
        base_length = start.days_until end . abs
        Date_Range.Internal_Constructor start end one_day increasing base_length . with_step step

    ## ---
       group: Metadata
       icon: metadata
       ---
       Gets the date the range starts from. The range includes it, unless the range
       is empty.

       ## Examples
       ### The start of a range
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 4 8)
       start = range.start
       # → 2023-04-05
       ```
    start self -> Date = self.start_internal

    ## ---
       group: Metadata
       icon: metadata
       ---
       Gets the date the range stops before. The range does not include it.

       ## Examples
       ### The end of a range
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 4 8)
       end = range.end
       # → 2023-04-08
       ```
    end self -> Date = self.end_internal

    ## ---
       group: Metadata
       icon: metadata
       ---
       Gets the step between the dates of the range, as a `Period`.

       ## Examples
       ### The step of a range of days
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 4 8)
       step = range.step.days
       # → 1
       ```

       ### The step of a monthly range
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 8 8) . with_step Date_Period.Month
       step = range.step.total_months
       # → 1
       ```
    step self -> Period = self.step_internal

    ## ---
       group: Metadata
       icon: metadata
       ---
       Checks whether the dates of the range go forward in time. A range from a
       later date down to an earlier one is not increasing.

       ## Examples
       ### A range made with `up_to`
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 4 8)
       increasing = range.increasing
       # → True
       ```

       ### A range made with `down_to`
       ```
       range = (Date.new 2023 4 8).down_to (Date.new 2023 4 5)
       increasing = range.increasing
       # → False
       ```
    increasing self -> Boolean = self.increasing_internal

    ## ---
       group: Calculations
       icon: time
       ---
       Creates a copy of this range with a different step.

       ## Arguments
       - `new_step`: The new step, a `Date_Period` or a `Period`. A `Period`
         must be positive: none of `years`, `months` and `days` may be negative,
         and at least one must be positive.

       ## Examples
       ### The first day of every month in a quarter
       ```
       range = (Date.new 2020 1 1).up_to (Date.new 2020 4 1)
       monthly = range.with_step Date_Period.Month
       days = monthly.to_vector
       # → [2020-01-01, 2020-02-01, 2020-03-01]
       ```

       ### Every other day of a decreasing range
       ```
       range = (Date.new 2022 10 7).down_to (Date.new 2022 10 1)
       stepped = range.with_step (Period.new days=2)
       days = stepped.to_vector
       # → [2022-10-07, 2022-10-05, 2022-10-03]
       ```
    @new_step make_period_selector
    with_step self (new_step : Date_Period | Period) -> Date_Range ! Illegal_Argument =
        case new_step of
            _ : Period ->
                effective_length = compute_length_and_verify self.start self.end new_step self.increasing
                Date_Range.Internal_Constructor self.start self.end new_step self.increasing effective_length
            _ : Date_Period ->
                self.with_step new_step.to_period

    ## ---
       private: true
       ---
       Convert to a textual representation.
    to_text : Text
    to_text self =
        middle = if self.increasing then " up to " else " down to "
        step = if self.step == (Period.new days=1) then "" else
            " by " + self.step.to_display_text
        "(Date_Range from " + self.start.to_text + middle + self.end.to_text + step + ")"

    ## ---
       private: true
       ---
       Convert to a display representation.
    to_display_text : Text
    to_display_text self =
        start = "[" + self.start.to_display_text + " .. " + self.end.to_display_text
        step = if self.step == (Period.new days=1) then "" else
            effective_step = if self.increasing then self.step else -self.step
            " by " + effective_step.to_display_text
        start + step + "]"

    ## ---
       private: true
       group: convert
       icon: enso_logo
       ---
       Convert the value to a corresponding Enso code representation.

       ## Examples
       ### Getting the Enso code of the date range 10-September-2024 until
         29-October-2024.

       ```
             (Date.new 2024 09 10).up_to (Date.new 2024 10 29) . pretty
       ```
       Returns a Text

                Date_Range.new (Date.new 2024 09 10) (Date.new 2024 10 29)
    pretty : Text
    pretty self =
        start = self.start.pretty
        end = self.end.pretty
        "Date_Range.new (" + start + ") (" + end + (if self.step == (Period.new days=1) then ")" else ") (" + self.step.pretty + ")")

    ## ---
       private: true
       ---
       Converts this value to a JSON serializable object.
    to_js_object : JS_Object
    to_js_object self =
        JS_Object.from_pairs [["type", "Date_Range"], ["start", self.start.to_js_object], ["end", self.end.to_js_object], ["step", self.step.to_js_object], ["increasing", self.increasing]]

    ## ---
       group: Selections
       icon: parse
       ---
       Returns the first date in the range, or an `Index_Out_Of_Bounds` error if
       the range is empty.

       ## Examples
       ### The first day of a range
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 4 8)
       first = range.first
       # → 2023-04-05
       ```
    first self -> Date ! Index_Out_Of_Bounds =
        if self.is_empty then Error.throw (Index_Out_Of_Bounds.Error 0 0) else self.start

    ## ---
       group: Selections
       icon: parse
       ---
       Returns the second date in the range, or an `Index_Out_Of_Bounds` error
       if the range has fewer than two dates.

       ## Examples
       ### The second day of a range
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 4 8)
       second = range.second
       # → 2023-04-06
       ```

       ### The second day of a decreasing range
       ```
       range = (Date.new 2023 4 8).down_to (Date.new 2023 4 5)
       second = range.second
       # → 2023-04-07
       ```
    second self -> Date ! Index_Out_Of_Bounds =
        if self.length < 2 then Error.throw (Index_Out_Of_Bounds.Error 1 self.length) else self.internal_at 1

    ## ---
       group: Selections
       icon: select_row
       ---
       Returns the last date in the range, or an `Index_Out_Of_Bounds` error if
       the range is empty.

       ## Examples
       ### The last day of a range
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 4 8)
       last = range.last
       # → 2023-04-07
       ```

       ### The last day of a range with a step
       ```
       range = (Date.new 2023 1 31).up_to (Date.new 2023 6 1) . with_step Date_Period.Month
       last = range.last
       # → 2023-05-31
       ```
    last self -> Date ! Index_Out_Of_Bounds =
        if self.is_empty then Error.throw (Index_Out_Of_Bounds.Error 0 0) else
            self.internal_at (self.length - 1)

    ## ---
       group: Metadata
       icon: metadata
       ---
       Gets the number of dates in the range.

       ## Examples
       ### The number of days in a range
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 4 7)
       length = range.length
       # → 2
       ```
    length self -> Integer = self.cached_length_internal

    ## ---
       group: Selections
       icon: parse
       arguments:
         index: always
       ---
       Gets the date at a position in the range, counting from 0, or an
       `Index_Out_Of_Bounds` error if there is none.

       ## Arguments
       - `index`: The position to read. A negative index counts from the end, so
         -1 is the last date.

       ## Examples
       ### The second day of a range
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 4 7)
       day = range.at 1
       # → 2023-04-06
       ```

       ### The last day of a range with a step
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 10 7) . with_step Date_Period.Month
       day = range.at -1
       # → 2023-10-05
       ```
    @index (t-> Widget.Numeric_Input minimum=0 maximum=t.length-1)
    at self (index : Integer = 0) -> Date ! Index_Out_Of_Bounds =
        self.get index (Error.throw (Index_Out_Of_Bounds.Error index self.length))

    ## ---
       icon: parse
       arguments:
         index: always
       ---
       Gets the date at a position in the range, counting from 0, or
       `if_missing` if there is none.

       ## Arguments
       - `index`: The position to read. A negative index counts from the end, so
         -1 is the last date.
       - `if_missing`: The value to return if the position is outside the range.

       ## Examples
       ### The second day of a range
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 4 8)
       day = range.get 1
       # → 2023-04-06
       ```

       ### A position outside the range
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 4 8)
       day = range.get 10 if_missing="no such day"
       # → no such day
       ```

       ## Remarks

       ### `if_missing`
       It is returned in place of a date, so it can be any value. It is only
       evaluated when the position is outside the range.
    @index (t-> Widget.Numeric_Input minimum=0 maximum=t.length-1)
    get self (index : Integer = 0) ~if_missing=Nothing -> Any =
        len = self.length
        effective_index = if index < 0 then len + index else index
        if effective_index >= 0 && effective_index < len then self.internal_at effective_index else
            if_missing

    ## ---
       private: true
       ---
       Generates the i-th element of the range.
       This method does no bounds checking, it should be used only internally.
    internal_at self i =
        nth_element_of_range self.start self.step self.increasing i

    ## ---
       icon: column_add
       ---
       Applies a function to each date in the range, giving a vector of the
       results.

       ## Arguments
       - `function`: The function to apply to each date.

       ## Examples
       ### The day of the month of each date
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 4 8)
       days = range.map .day
       # → [5, 6, 7]
       ```

       ### The day of the week of each date
       ```
       range = (Date.new 2023 4 5).up_to (Date.new 2023 4 8)
       weekdays = range.map (date-> date.day_of_week.to_text)
       # → [Wednesday, Thursday, Friday]
       ```
    map self (function : Date -> Any) -> Vector Any =
        Vector.new self.length (i -> function (self.internal_at i))

    ## ---
       group: Conversions
       icon: convert
       ---
       Converts the range to a vector of its dates.

       ## Examples
       ### The days from 7 to 10 May 2021
       ```
       range = (Date.new 2021 5 7).up_to (Date.new 2021 5 10)
       days = range.to_vector
       # → [2021-05-07, 2021-05-08, 2021-05-09]
       ```
    to_vector self -> Vector Date =
        proxy = Array_Proxy.new self.length (self.at _)
        Vector.from_polyglot_array proxy

    ## ---
       group: Logical
       icon: metadata
       ---
       Checks whether the range has no dates.

       ## Examples
       ### A range of three years
       ```
       range = (Date.new 2020).up_to (Date.new 2023)
       empty = range.is_empty
       # → False
       ```

       ### A range that ends where it starts
       ```
       range = (Date.new 2023 1 1).up_to (Date.new 2023 1 1)
       empty = range.is_empty
       # → True
       ```
    is_empty self -> Boolean = self.length == 0

    ## ---
       group: Logical
       icon: metadata
       ---
       Checks whether the range has at least one date.

       ## Examples
       ### A range of three years
       ```
       range = (Date.new 2020).up_to (Date.new 2023)
       not_empty = range.not_empty
       # → True
       ```

       ### A range that ends where it starts
       ```
       range = (Date.new 2023 1 1).up_to (Date.new 2023 1 1)
       not_empty = range.not_empty
       # → False
       ```
    not_empty self -> Boolean = self.is_empty.not

    ## ---
       group: Selections
       icon: preparation
       ---
       Gets the dates in the range that satisfy a condition, as a vector.

       ## Arguments
       - `filter`: A `Filter_Condition`, or a function that takes a date and
         returns a boolean saying whether to keep it.

       ## Examples
       ### The dates after 12 October
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 15)
       kept = range.filter (..Greater than=(Date.new 2020 10 12))
       # → [2020-10-13, 2020-10-14]
       ```

       ### The Mondays of a range
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 15)
       mondays = range.filter (date-> date.day_of_week == Day_Of_Week.Monday)
       # → [2020-10-05, 2020-10-12]
       ```
    @filter date_range_default_filter_condition_widget
    filter self (filter : Filter_Condition | (Date -> Boolean)) -> Vector Date =
        predicate = unify_condition_or_predicate filter
        Vector.build builder->
            self.map elem->
                if predicate elem then builder.append elem else builder

    ## ---
       group: Selections
       icon: preparation
       ---
       Splits the range into the dates that satisfy a condition and those that
       do not.
       Returns a `Pair` whose `first` is a vector of the dates that satisfy the
       condition and whose `second` is a vector of the others. Each keeps the
       order of the range.

       ## Arguments
       - `condition`: A `Filter_Condition`, or a function that takes a date and
         returns a boolean.

       ## Examples
       ### The weekends of a week
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 8)
       is_weekend = day-> [Day_Of_Week.Saturday, Day_Of_Week.Sunday].contains day.day_of_week
       split = range.partition is_weekend
       weekend = split.first
       # → [2020-10-03, 2020-10-04]
       ```

       ### The dates from 4 October on
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 6)
       split = range.partition (..Less than=(Date.new 2020 10 4))
       later = split.second
       # → [2020-10-04, 2020-10-05]
       ```
    @condition date_range_default_filter_condition_widget
    partition self (condition : Filter_Condition | (Date -> Boolean)) -> Pair (Vector Date) (Vector Date) =
        predicate = unify_condition_or_predicate condition
        vecs = Vector.build_multiple 2 builders->
            self.map elem->
                case predicate elem of
                    True -> builders.at 0 . append elem
                    False -> builders.at 1 . append elem
        Pair.new (vecs.at 0) (vecs.at 1)

    ## ---
       private: true
       advanced: true
       ---
       Applies a function for each element in the range.
       This method does not return the results, so it is only useful for
       performing computations with side-effects.
       If the function returns a dataflow error, the error is converted to a
       panic and thrown immediately stopping further processing.

       ## Arguments
        - `function`: The function to apply to each integer in the range.

       ## Examples
       ### To print all dates from 2020-10-01 to 2020-10-05.
       ```
             (Date.new 2020 10 01).up_to (Date.new 2020 10 05) include_end=True . each IO.println
       ```
    each : (Date -> Any) -> Nothing
    each self function =
        (0.up_to self.length).each ix->
            function (self.internal_at ix)

    ## ---
       private: true
       advanced: true
       ---
       Applies a function to each element of the range.
       Essentially acts like `range.to_vector.each_with_index`, but it is more
       efficient.

       ## Arguments
        - `function`: A function to apply that takes two parameters: first the
          index of a given range element and then the actual range element.
    each_with_index : (Integer -> Date -> Nothing) -> Nothing
    each_with_index self function =
        (0.up_to self.length).each_with_index ix->
            function ix (self.internal_at ix)

    ## ---
       icon: transform
       ---
       Combines the dates of the range into one value, by applying a function to
       a running result and each date in turn.

       ## Arguments
       - `init`: The starting value of the running result.
       - `function`: A function that takes the running result and a date, and
         returns the new running result.

       ## Examples
       ### The number of Mondays in October 2020
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 31)
       mondays = range.fold 0 (count-> date-> if date.day_of_week == Day_Of_Week.Monday then count + 1 else count)
       # → 4
       ```

       ### The sum of the days of the month
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 5)
       total = range.fold 0 (sum-> date-> sum + date.day)
       # → 10
       ```

       ## Remarks

       ### `init`
       The running result can be any value, so `init` takes anything.
    fold self (init : Any) (function : Any -> Date -> Any) -> Any =
        (0.up_to self.length).fold init acc-> ix->
            function acc (self.internal_at ix)

    ## ---
       icon: column_add
       ---
       Combines the dates of the range as `fold` does, but keeps the running
       result after each date, giving a vector with one value per date.

       ## Arguments
       - `init`: The starting value of the running result.
       - `function`: A function that takes the running result and a date, and
         returns the new running result.

       ## Examples
       ### The running total of the days of the month
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 5)
       totals = range.running_fold 0 (sum-> date-> sum + date.day)
       # → [1, 3, 6, 10]
       ```

       ## Remarks

       ### `init`
       The running result can be any value, so `init` takes anything.
    running_fold self (init : Any) (function : Any -> Date -> Any) -> Vector Any =
        (0.up_to self.length).running_fold init acc-> ix->
            function acc (self.internal_at ix)

    ## ---
       group: Logical
       icon: preparation
       ---
       Checks whether every date in the range satisfies a condition.

       ## Arguments
       - `condition`: A `Filter_Condition`, or a function that takes a date and
         returns a boolean.

       ## Examples
       ### All the dates are after 30 September
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 31)
       after = range.all (..Greater than=(Date.new 2020 9 30))
       # → True
       ```

       ### Not all the dates are Mondays
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 31)
       mondays = range.all (date-> date.day_of_week == Day_Of_Week.Monday)
       # → False
       ```
    @condition date_range_default_filter_condition_widget
    all self (condition : Filter_Condition | (Date -> Boolean)) -> Boolean =
        predicate = unify_condition_or_predicate condition
        self . any (predicate >> .not) . not

    ## ---
       group: Logical
       icon: preparation
       ---
       Checks whether any date in the range satisfies a condition.

       ## Arguments
       - `condition`: A `Filter_Condition`, or a function that takes a date and
         returns a boolean.

       ## Examples
       ### Some date is after 30 October
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 31)
       any = range.any (..Greater than=(Date.new 2020 10 30))
       # → False
       ```

       ### Some date is a Monday
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 31)
       any = range.any (date-> date.day_of_week == Day_Of_Week.Monday)
       # → True
       ```
    @condition date_range_default_filter_condition_widget
    any self (condition : Filter_Condition | (Date -> Boolean)) -> Boolean =
        self.find condition if_missing=Nothing . is_nothing . not

    ## ---
       group: Selections
       icon: find
       ---
       Gets the first date in the range that satisfies a condition, or
       `if_missing` if there is none.

       ## Arguments
       - `condition`: A `Filter_Condition`, or a function that takes a date and
         returns a boolean.
       - `start`: The position to start searching from. A negative position
         counts from the end of the range.
       - `if_missing`: The value to return if no date satisfies the condition.
         By default the result is a `Not_Found` error.

       ## Examples
       ### The first Monday
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 31)
       monday = range.find (date-> date.day_of_week == Day_Of_Week.Monday)
       # → 2020-10-05
       ```

       ### No date matches
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 31)
       none = range.find (..Greater than=(Date.new 2021 1 1)) if_missing=Nothing
       # → Nothing
       ```

       ## Remarks

       ### `if_missing`
       It is returned in place of a date, so it can be any value. It is only
       evaluated when no date satisfies the condition.
    @condition date_range_default_filter_condition_widget
    find self (condition : Filter_Condition | (Date -> Boolean)) (start : Integer = 0) ~if_missing=(Error.throw Not_Found) -> Any =
        predicate = unify_condition_or_predicate condition
        index = self.index_of predicate start
        case index of
            Nothing -> if_missing
            _ : Integer -> self.internal_at index

    ## ---
       group: Logical
       icon: preparation
       ---
       Checks whether the range contains a date.

       ## Arguments
       - `value`: The date to look for.

       ## Examples
       ### A date that is in the range
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 31) . with_step (Period.new days=2)
       contains = range.contains (Date.new 2020 10 15)
       # → True
       ```

       ### A date that is not
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 31) . with_step (Period.new days=2)
       contains = range.contains (Date.new 2020 10 16)
       # → False
       ```
    contains self (value : Date) -> Boolean =
        self.find (== value) if_missing=Nothing . is_nothing . not

    ## ---
       group: Values
       icon: find
       ---
       Gets the position of the first date that matches, or `Nothing` if none
       does.

       ## Arguments
       - `condition`: The date to look for, a `Filter_Condition`, or a function
         that takes a date and returns a boolean.
       - `start`: The position to start searching from. A negative position
         counts from the end of the range.

       ## Examples
       ### The position of the first Monday
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 31)
       index = range.index_of (date-> date.day_of_week == Day_Of_Week.Monday)
       # → 4
       ```

       ### The position of a date
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 31)
       index = range.index_of (Date.new 2020 10 15)
       # → 14
       ```
    @condition date_range_default_filter_condition_widget
    index_of self (condition : Date | Filter_Condition | (Date -> Boolean)) (start : Integer = 0) -> Integer | Nothing =
        predicate = unify_condition_for_index_of condition
        (0.up_to self.length).index_of (ix-> predicate (self.internal_at ix)) start

    ## ---
       group: Values
       icon: find
       ---
       Gets the position of the last date that matches, or `Nothing` if none
       does.

       ## Arguments
       - `condition`: The date to look for, a `Filter_Condition`, or a function
         that takes a date and returns a boolean.
       - `start`: The position to start searching backwards from. A negative
         position counts from the end of the range.

       ## Examples
       ### The position of the last Monday
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 31)
       index = range.last_index_of (date-> date.day_of_week == Day_Of_Week.Monday)
       # → 25
       ```
    @condition date_range_default_filter_condition_widget
    last_index_of self (condition : Date | Filter_Condition | (Date -> Boolean)) (start : Integer = -1) -> Integer | Nothing =
        predicate = unify_condition_for_index_of condition
        (0.up_to self.length).last_index_of (ix-> predicate (self.internal_at ix)) start

    ## ---
       group: Selections
       icon: order
       ---
       Gets the dates of the range in the opposite order, as a vector.

       ## Examples
       ### The days of a range, last first
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 4)
       days = range.reverse
       # → [2020-10-03, 2020-10-02, 2020-10-01]
       ```

       ## Remarks

       ### Returning a `Vector`
       This method cannot return a `Date_Range`, as some ranges are not
       reversible. For example, the range `(Date.new 2020 02 29).up_to (Date.new
       2023) . with_step Date_Period.Year` will have `2022-02-28` as its last
       entry. But if we create a range starting at `2022-02-28` and going
       backwards by a year, its last element will be `2020-02-28` and not
       `2020-02-29` as in the original.
       Thus, to preserve the contents we need to return a vector.
    reverse self -> Vector Date = self.to_vector.reverse

    ## ---
       icon: preparation
       ---
       Combines all the dates of a non-empty range into one, using a function.
       If the range is empty, returns `if_empty`.

       ## Arguments
       - `function`: A function that takes the result so far and the next date,
         and returns a date.
       - `if_empty`: The value to return if the range is empty. By default the
         result is an `Empty_Error`.

       ## Examples
       ### The latest date of a range
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 4)
       latest = range.reduce (a-> b-> if a > b then a else b)
       # → 2020-10-03
       ```

       ### An empty range
       ```
       range = (Date.new 2020 10 1).up_to (Date.new 2020 10 1)
       latest = range.reduce (a-> b-> if a > b then a else b) if_empty=Nothing
       # → Nothing
       ```

       ## Remarks

       ### `if_empty`
       It is returned in place of a date, so it can be any value. It is only
       evaluated when the range is empty.
    reduce self (function : Date -> Date -> Date) ~if_empty=(Error.throw (Empty_Error.Error Date_Range)) -> Any =
        case self.length of
            0 -> if_empty
            1 -> self.start
            length ->
                (1.up_to length).fold self.start acc-> ix->
                    function acc (self.internal_at ix)

    ## ---
       private: true
       ---
       Default column name based on step.
    default_column_name : Text
    default_column_name self =
        periods = [Date_Period.Year, Date_Period.Quarter, Date_Period.Month, Date_Period.Week, Date_Period.Day].map _.to_period
        names = ["Year", "Quarter", "Month", "Week", "Date"]
        index = periods.index_of self.step
        if index == Nothing then "Date" else names.get index

## ---
   private: true
   ---
   Computes the length of the range and verifies its invariants.
   If any of the invariants are violated, a dataflow error is raised.
compute_length_and_verify : Date -> Date -> Period -> Boolean -> Integer ! Illegal_Argument
compute_length_and_verify start end step increasing =
    if is_period_positive step . not then Error.throw (Illegal_Argument.Error "The step `Period` for `Date_Range` must be positive, i.e. all of `years`, `months` and `days` must be non-negative and at least one of them must be strictly positive.") else
        is_range_empty = case increasing of
            True -> start >= end
            False -> start <= end
        if is_range_empty then 0 else
            # First a few heuristics for a fast path.
            # If there are no years or months, we can perform a simple computation on day difference.
            if step.total_months == 0 then compute_length_step_days start end step.days increasing else
                # Similarly, if we are only shifting by months, we can rely on a simpler computation.
                if step.days == 0 then compute_length_step_months start end step.total_months increasing else
                    # Then we go brute force for the general case.
                    compute_length_step_brute_force start end step increasing

## ---
   private: true
   ---
is_period_positive period =
    if (period.years < 0) || (period.months < 0) || (period.days < 0) then False else
        (period.total_months > 0) || (period.days > 0)

## ---
   private: true
   ---
   Assumes that the range is not empty.
compute_length_step_days : Date -> Date -> Integer -> Boolean -> Integer
compute_length_step_days start end step increasing =
    # Logic analogous to `Range.length`.
    diff = case increasing of
        True  -> Time_Utils.days_between start end
        False -> Time_Utils.days_between end start
    assert (diff >= 0)
    steps = diff . div step
    exact_fit = diff % step == 0
    if exact_fit then steps else steps+1

## ---
   private: true
   ---
   Assumes that the range is not empty.
compute_length_step_months start end step increasing =
    diff = case increasing of
        True  -> Time_Utils.months_between start end
        False -> Time_Utils.months_between end start
    assert (diff >= 0)
    steps = diff . div step
    exact_fit = case increasing of
        True  -> start + Period.new months=steps*step == end
        False -> start - Period.new months=steps*step == end
    if exact_fit then steps else steps+1


## ---
   private: true
   ---
nth_element_of_range start step increasing n = case increasing of
    True  -> start + step*n
    False -> start - step*n

## ---
   private: true
   ---
compute_length_step_brute_force start end step increasing =
    is_exceeded = case increasing of
        True -> (x -> x >= end)
        False -> (x -> x <= end)
    go current_date acc_length =
        if is_exceeded current_date then acc_length else
            next_date = nth_element_of_range start step increasing (acc_length + 1)
            @Tail_Call go next_date (acc_length + 1)
    go start 0

## ---
   private: true
   ---
   This adds an additional type check.
unify_condition_for_index_of (condition : Date | Filter_Condition | Function) =
    unify_condition_predicate_or_element condition

## ---
   private: true
   ---
date_range_default_filter_condition_widget =
    (Widget.from Filter_Condition include_text=False include_boolean=False include_numeric=False include_nullable=False include_time=False include_date_time=False)

## ---
   private: true
   ---
Vector.from (that:Date_Range) = that.to_vector
