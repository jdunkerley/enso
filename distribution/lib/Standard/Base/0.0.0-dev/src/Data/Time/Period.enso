import project.Any.Any
import project.Data.Boolean.Boolean
import project.Data.Json.JS_Object
import project.Data.Numbers.Integer
import project.Data.Ordering.Comparable
import project.Data.Text.Text
import project.Data.Time.Date.Date
import project.Data.Time.Duration.Duration
import project.Data.Vector.Vector
import project.Error.Error
import project.Errors.Common.Incomparable_Values
import project.Errors.Illegal_Argument.Illegal_Argument
import project.Errors.Time_Error.Time_Error
import project.Meta
import project.Panic.Panic
from project.Data.Text.Extensions import all
from project.Metadata import Widget
from project.Metadata.Choice import Option

polyglot java import java.lang.ArithmeticException
polyglot java import java.time.DateTimeException
polyglot java import java.time.Period as Java_Period

## ---
   private: true
   ---
ensure_period : Any -> (Any -> Any) -> Text -> Any ! (Time_Error | Illegal_Argument)
ensure_period object ~action error_msg="Cannot use Duration as a parameter" =
    case object of
        _ : Period -> action
        _ : Duration ->
            Error.throw (Time_Error.Error error_msg)
        x ->
            Error.throw (Illegal_Argument.Error ("Expected Period type, got: " + (x.to Meta.Type . qualified_name)))

## A date-based amount of time in the ISO-8601 calendar system, such as '2 years,
   3 months and 4 days'.
   This type models an amount of time in terms of years, months and days.
   `Duration` is its time-based equivalent. Moreover, `Period` counts with
   daylight saving time. This means that a Period of 1 day does not necessarily
   have to be 24 hours of Duration.
type Period
    ## ---
       icon: time
       ---
       Creates a Period from the time between two dates.

       The result is negative when `end_date_exclusive` is before
       `start_date_inclusive`.

       ## Arguments
       - `start_date_inclusive`: The start date of the period, included.
       - `end_date_exclusive`: The end date of the period, excluded.

       ## Examples
       ### The period between two dates
       ```
       start = Date.new 2022 9 12
       end = Date.new 2022 10 21
       period = Period.between start end
       # → 1M 9D
       ```

       ### The months between a later and an earlier date
       ```
       start = Date.new 2022 10 21
       end = Date.new 2022 9 12
       period = Period.between start end
       months = period.total_months
       # → -1
       ```
    between (start_date_inclusive : Date) (end_date_exclusive : Date) -> Period =
        Period.Value (Java_Period.between start_date_inclusive end_date_exclusive)

    ## ---
       icon: time
       arguments:
         years: always
         months: always
         days: always
       ---
       Creates a Period from a number of years, months and days.

       ## Arguments
       - `years`: The number of years.
       - `months`: The number of months. It is not limited to 11: 18 months stay
         18 months.
       - `days`: The number of days.

       ## Examples
       ### A period of years and days
       ```
       period = Period.new 2 0 5
       # → 2Y 0M 5D
       ```

       ### A period of months only
       ```
       period = Period.new months=18
       # → 1Y 6M
       ```

       ### An empty period
       ```
       period = Period.new
       # → 0D
       ```
    new (years : Integer = 0) (months : Integer = 0) (days : Integer = 0) -> Period =
        Period.Value (Java_Period.of years months days)

    ## ---
       private: true
       ---

       ## Arguments
        - `internal_period`: An internal representation of period of type
          java.time.Period.
    Value (internal_period : Java_Period)

    ## ---
       group: DateTime
       icon: time
       ---
       The years part of this period.

       The years and the months are kept separately: use `total_months` to count
       them together.

       ## Examples
       ### The years of a period
       ```
       period = Period.new years=2 months=3 days=4
       years = period.years
       # → 2
       ```
    years self -> Integer = self.internal_period.getYears

    ## ---
       group: DateTime
       icon: time
       ---
       The months part of this period, not including its years.

       ## Examples
       ### The months of a period
       ```
       period = Period.new years=2 months=3 days=4
       months = period.months
       # → 3
       ```

       ### Months that do not roll over into years
       ```
       period = Period.new months=18
       months = period.months
       # → 18
       ```
    months self -> Integer = self.internal_period.getMonths

    ## ---
       group: DateTime
       icon: time
       ---
       The years and months of this period together, as a number of months.

       Every year counts as 12 months.

       ## Examples
       ### The total months of a period
       ```
       period = Period.new years=2 months=3 days=4
       total = period.total_months
       # → 27
       ```
    total_months self -> Integer = self.internal_period.toTotalMonths

    ## ---
       group: DateTime
       icon: time
       ---
       The days part of this period.

       ## Examples
       ### The days of a period
       ```
       period = Period.new years=2 months=3 days=4
       days = period.days
       # → 4
       ```
    days self -> Integer = self.internal_period.getDays

    ## ---
       aliases: [add period]
       group: Operators
       icon: time
       ---
       Adds another period to this one.

       Returns a `Time_Error` if `other_period` is a `Duration`, and an
       `Illegal_Argument` if it is anything but a `Period`.

       ## Arguments
       - `other_period`: The period to add to this one.

       ## Examples
       ### Add a day to a month
       ```
       period = Period.new months=1
       other = Period.new days=1
       total = period + other
       # → 1M 1D
       ```

       ### Add months to months
       ```
       period = Period.new months=8
       other = Period.new months=5
       total = period + other
       # → 1Y 1M
       ```

       ## Remarks

       ### The `other_period` argument
       This argument is not typed, so a `Duration` gives a `Time_Error` and any
       other value an `Illegal_Argument`, rather than a `Type_Error`. It starts
       from `Period.new`, which you then complete: `(Period.new months=1)`.
    @other_period make_period_choice
    + self other_period -> Period ! (Time_Error | Illegal_Argument) =
        ensure_period other_period <|
            catch_java_exceptions "Period.+" <|
                Period.Value (self.internal_period.plus other_period.internal_period)

    ## ---
       aliases: [subtract period]
       group: Operators
       icon: time
       ---
       Subtracts another period from this one.

       Returns a `Time_Error` if `other_period` is a `Duration`, and an
       `Illegal_Argument` if it is anything but a `Period`.

       ## Arguments
       - `other_period`: The period to subtract from this one.

       ## Examples
       ### Subtract 3 months from a year and a half
       ```
       period = Period.new years=1 months=6
       other = Period.new months=3
       result = period - other
       # → 1Y 3M
       ```

       ## Remarks

       ### The `other_period` argument
       This argument is not typed, so a `Duration` gives a `Time_Error` and any
       other value an `Illegal_Argument`, rather than a `Type_Error`. It starts
       from `Period.new`, which you then complete: `(Period.new months=1)`.
    @other_period make_period_choice
    - self other_period -> Period ! (Time_Error | Illegal_Argument) =
        ensure_period other_period <|
            catch_java_exceptions "Period.-" <|
                Period.Value (self.internal_period.minus other_period.internal_period)

    ## ---
       aliases: [multiply, times]
       group: Operators
       icon: time
       ---
       Multiplies every part of this period by a whole number.

       Returns a `Time_Error` if the result is too large for a period.

       ## Arguments
       - `factor`: The number to multiply by. A negative factor reverses the
         period.

       ## Examples
       ### Double a period
       ```
       period = Period.new years=1 months=2
       doubled = period * 2
       # → 2Y 4M
       ```

       ### Triple a number of days
       ```
       period = Period.new days=10
       tripled = period * 3
       # → 30D
       ```
    * self (factor : Integer) -> Period ! Time_Error =
        catch_java_exceptions "Period.*" <|
            Period.Value (self.internal_period.multipliedBy factor)

    ## ---
       aliases: [greater than]
       group: Operators
       icon: operators
       ---
       Checks if this period is greater than `that`.

       Periods have no order, because a month is not a fixed number of days. They
       can only be compared with an equal period, so this is `False` for that and
       an `Incomparable_Values` error for any other.

       ## Arguments
       - `that`: The period to compare with.

       ## Examples
       ### Periods that cannot be ordered
       ```
       period = Period.new months=1
       other = Period.new days=30
       result = (period > other).is_error
       # → True
       ```

       ### A period compared with an equal one
       ```
       period = Period.new months=1
       other = Period.new months=1
       result = period > other
       # → False
       ```

       ## Remarks

       ### The `that` argument
       This argument is not typed and has no widget (#797): typing it would turn
       the `Incomparable_Values` error for a `Duration` into a `Type_Error`.
       Connect a period, or type one such as `Period.new months=1`.
    > self that -> Boolean ! Incomparable_Values = Comparable.> self=self that

    ## ---
       aliases: [greater than or equal]
       group: Operators
       icon: operators
       ---
       Checks if this period is greater than or equal to `that`.

       Periods have no order, because a month is not a fixed number of days. They
       can only be compared with an equal period, so this is `True` for that and
       an `Incomparable_Values` error for any other.

       ## Arguments
       - `that`: The period to compare with.

       ## Examples
       ### A period compared with an equal one
       ```
       period = Period.new months=1
       other = Period.new months=1
       result = period >= other
       # → True
       ```

       ### Periods that cannot be ordered
       ```
       period = Period.new months=1
       other = Period.new days=30
       result = (period >= other).is_error
       # → True
       ```

       ## Remarks

       ### The `that` argument
       This argument is not typed and has no widget (#797): typing it would turn
       the `Incomparable_Values` error for a `Duration` into a `Type_Error`.
       Connect a period, or type one such as `Period.new months=1`.
    >= self that -> Boolean ! Incomparable_Values = Comparable.>= self=self that

    ## ---
       aliases: [less than]
       group: Operators
       icon: operators
       ---
       Checks if this period is less than `that`.

       Periods have no order, because a month is not a fixed number of days. They
       can only be compared with an equal period, so this is `False` for that and
       an `Incomparable_Values` error for any other.

       ## Arguments
       - `that`: The period to compare with.

       ## Examples
       ### Periods that cannot be ordered
       ```
       period = Period.new days=1
       other = Period.new months=1
       result = (period < other).is_error
       # → True
       ```

       ### A period compared with an equal one
       ```
       period = Period.new days=1
       other = Period.new days=1
       result = period < other
       # → False
       ```

       ## Remarks

       ### The `that` argument
       This argument is not typed and has no widget (#797): typing it would turn
       the `Incomparable_Values` error for a `Duration` into a `Type_Error`.
       Connect a period, or type one such as `Period.new months=1`.
    < self that -> Boolean ! Incomparable_Values = Comparable.< self=self that

    ## ---
       aliases: [less than or equal]
       group: Operators
       icon: operators
       ---
       Checks if this period is less than or equal to `that`.

       Periods have no order, because a month is not a fixed number of days. They
       can only be compared with an equal period, so this is `True` for that and
       an `Incomparable_Values` error for any other.

       ## Arguments
       - `that`: The period to compare with.

       ## Examples
       ### A period compared with an equal one
       ```
       period = Period.new days=1
       other = Period.new days=1
       result = period <= other
       # → True
       ```

       ### Periods that cannot be ordered
       ```
       period = Period.new days=1
       other = Period.new months=1
       result = (period <= other).is_error
       # → True
       ```

       ## Remarks

       ### The `that` argument
       This argument is not typed and has no widget (#797): typing it would turn
       the `Incomparable_Values` error for a `Duration` into a `Type_Error`.
       Connect a period, or type one such as `Period.new months=1`.
    <= self that -> Boolean ! Incomparable_Values = Comparable.<= self=self that

    ## ---
       group: Operators
       icon: operators
       ---
       Negates every part of this period.

       This turns a period used for going forward in time into one for going
       backwards.

       ## Examples
       ### Negate a period
       ```
       period = Period.new months=3 days=5
       negated = period.negate
       months = negated.months
       # → -3
       ```
    negate self -> Period = Period.Value (self.internal_period.negated)

    ## ---
       private: true
       ---
       Convert Period to a friendly string.
    to_display_text : Text
    to_display_text self = if self == Period.new then "0D" else
        years = self.years + (self.months/12).floor
        y = if years == 0 then "" else years.to_text + "Y "

        d = if self.days == 0 then "" else self.days.to_text + "D "

        months = self.months % 12
        m = if months == 0 && (y=="" || d=="") then "" else months.to_text + "M "

        (y + m + d) . trim

    ## ---
       private: true
       ---
       Convert to a JavaScript Object representing a Period.

       ## Examples
       ### Convert a period of 10 months to a JS_Object.

       ```
             example_to_json = (Period.new months=10).to_js_object
       ```
    to_js_object : JS_Object
    to_js_object self =
        v = Vector.build initial_capacity=7 builder->
            builder.append ["type", "Period"]
            builder.append ["constructor", "new"]
            if self.years==0 . not then builder.append ["years", self.years]
            if self.months==0 . not then builder.append ["months", self.months]
            if self.days==0 . not then builder.append ["days", self.days]
        JS_Object.from_pairs v

    ## ---
       private: true
       group: convert
       icon: enso_logo
       ---
       Convert the value to a corresponding Enso code representation.

       ## Examples
       ### Getting the Enso code of the period 1 month and 2 days.

       ```
             (Period.new months=1 days=2).pretty
       ```
       Returns a Text

                Period.new months=1 days=2
    pretty : Text
    pretty self =
        parts = Vector.build builder->
            builder.append "Period.new"
            if self.years != 0 then builder.append ((if builder.length!=1 then " years=" else " ") + self.years.to_text)
            if self.months != 0 then builder.append ((if builder.length!=2 then " months=" else " ") + self.months.to_text)
            if self.days != 0 then builder.append ((if builder.length!=3 then " days=" else " ") + self.days.to_text)
        parts.join ""

## ---
   private: true
   ---
   The choices for the period added to, or subtracted from, a Period: `Period.new`,
   written in parentheses so that it can be completed with its arguments.
make_period_choice -> Widget =
    Widget.Single_Choice values=[Option "Period.new" "(Period.new)"]

## ---
   private: true
   ---
catch_java_exceptions operation ~action =
    handle_arithmetic_exception caught_panic =
        Error.throw (Time_Error.Error "An overflow has occurred during the "+operation+" operation:"+caught_panic.payload.getMessage)
    handle_date_time_exception caught_panic =
        Error.throw (Time_Error.Error "The operation "+operation+" has failed:"+caught_panic.payload.getMessage)
    Panic.catch ArithmeticException handler=handle_arithmetic_exception <|
        Panic.catch DateTimeException handler=handle_date_time_exception <|
            action
