## This type represents a date, often viewed as year-month-day.
   For example, the value "2nd October 2007" can be stored in a `Date`.
   This class does not store or represent a time or timezone. Instead, it is a
   description of the date, as used for birthdays. It cannot represent an instant
   on the time-line without additional information such as an offset or timezone.
@Builtin_Type
type Date
    ## ---
       aliases: [current date, now]
       group: DateTime
       icon: calendar
       ---
       Obtains the current date from the system clock in the system timezone.

       ## Examples
       ### The date today
       ```
       date = Date.today
       ```
    today -> Date = Date_Helpers.today

    ## ---
       aliases: [previous day]
       group: DateTime
       icon: calendar
       ---
       The day before today, from the system clock in the system timezone.

       ## Examples
       ### The day before today
       ```
       date = Date.yesterday
       ```
    yesterday -> Date = Date.today.previous

    ## ---
       aliases: [next day]
       group: DateTime
       icon: calendar
       ---
       The day after today, from the system clock in the system timezone.

       ## Examples
       ### The day after today
       ```
       date = Date.tomorrow
       ```
    tomorrow -> Date = Date.today.next

    ## ---
       group: Constants
       icon: calendar
       arguments:
         month: always
         day: always
       ---
       Constructs a new Date from a year, month, and day.

       Returns a `Time_Error` if the provided time is not valid.

       ## Arguments
       - `year`: The year to represent.
       - `month`: The month-of-year to represent, from 1 (January) to 12 (December).
       - `day`: The day-of-month to represent, from 1 to 31. It must be valid for the
         year and month.

       ## Examples
       ### A date from its year, month and day
       ```
       date = Date.new 2020 12 23
       # → 2020-12-23
       ```

       ### The first day of a year
       ```
       date = Date.new 1970
       # → 1970-01-01
       ```
    @year (Widget.Numeric_Input)
    @month (Widget.Numeric_Input minimum=1 maximum=12)
    @day make_day_picker
    new : Integer -> Integer -> Integer -> Date ! Time_Error
    new year:Integer (month:Integer=1) (day:Integer=1) =
        Panic.catch JException (Date_Helpers.new_date_builtin year month day) caught->
            Error.throw (Time_Error.Error caught.payload.getMessage)

    ## ---
       aliases: [date from text]
       group: Conversions
       icon: convert
       arguments:
         format: always
       ---
       Converts text containing a date into a Date object.

       Returns a `Time_Error` if the provided `text` cannot be parsed using the
       provided `format`.

       ## Arguments
       - `text`: The text to try and parse as a date.
       - `format`: A pattern describing how to parse the text, or a
         `Date_Time_Formatter`. By default the text is read as an ISO-8601 date.

       ## Examples
       ### Parse an ISO date
       ```
       date = Date.parse "2020-12-23"
       # → 2020-12-23
       ```

       ### Parse a date with a custom format
       ```
       date = Date.parse "23/12/2020" "dd/MM/yyyy"
       # → 2020-12-23
       ```

       ### Fall back to a default date when the text is not a date
       ```
       parsed = Date.parse "my birthday"
       date = parsed.catch Any _-> Date.new 2000 1 1
       # → 2000-01-01
       ```

       ## Remarks

       ### Default Date Formatting
       Unless you provide a custom format, the text must represent a valid date
       that can be parsed using the ISO-8601 extended local date format. The
       format consists of:
       - Four digits or more for the year. Years in the range 0000 to 9999 will
       be pre-padded by zero to ensure four digits. Years outside that range will
       have a prefixed positive or negative symbol.
       - A dash  - Two digits for the month-of-year. This is pre-padded by zero
       to ensure two digits.
       - A dash  - Two digits for the day-of-month. This is pre-padded by zero to
       ensure two digits.

       ### Pattern Syntax
       If the pattern is provided as `Text`, it is parsed using the format
       described below. See `Date_Time_Formatter` for more options.
       - y: Year. The number of pattern letters determines the minimum number of
       digits.
       - y: The year using any number of digits.
       - yy: The year, using at most two digits. The default range is 1950-2049,
       but this can be changed by including the end year in braces e.g.
       `yy{2099}`.
       - yyyy: The year, using exactly four digits.
       - M: Month of year. The number of pattern letters determines the format:
       - M: Any number (1-12).
       - MM: Month number with zero padding required (01-12).
       - MMM: Short name of the month (Jan-Dec).
       - MMMM: Full name of the month (January-December).
       The month names depend on the selected locale.
       - d: Day. The number of pattern letters determines the format:
       - d: Any number (1-31).
       - dd: Day number with zero padding required (01-31).
       - ddd: Short name of the day of week (Mon-Sun).
       - dddd: Full name of the day of week (Monday-Sunday).
       The weekday names depend on the selected locale.
       Both day of week and day of month may be included in a single pattern - in
       such case the day of week is used as a sanity check.
       - Q: Quarter of year.
       If only year and quarter are provided in the pattern, when parsing a date,
       the result will be the first day of that quarter.
    @format make_date_format_selector
    parse : Text -> Date_Time_Formatter -> Date ! Time_Error
    parse text:Text format:Date_Time_Formatter=Date_Time_Formatter.iso_date =
        format.parse_date text

    ## ---
       group: Metadata
       icon: metadata
       ---
       The year of this date.

       ## Examples
       ### The year of a date
       ```
       date = Date.new 2020 12 23
       year = date.year
       # → 2020
       ```
    year : Integer
    year self -> Integer = Date_Helpers.year self

    ## ---
       group: Metadata
       icon: metadata
       ---
       The month of this date, as a number from 1 (January) to 12 (December).

       ## Examples
       ### The month of a date
       ```
       date = Date.new 2020 12 23
       month = date.month
       # → 12
       ```
    month self -> Integer = Date_Helpers.month self 

    ## ---
       group: Metadata
       icon: metadata
       ---
       The day of the month of this date, from 1 to 31.

       ## Examples
       ### The day of the month of a date
       ```
       date = Date.new 2020 12 23
       day = date.day
       # → 23
       ```
    day self -> Integer = Date_Helpers.day self

    ## ---
       icon: metadata
       ---
       The number of the week of the year this date falls into.
       Produces a warning for a Date that is before epoch start.

       ## Arguments
       - `locale`: The locale that defines the notion of weeks of year. If no locale
         is given, the ISO 8601 week of year is used.

       ## Examples
       ### The ISO week of a date at the start of a year
       ```
       date = Date.new 2021 1 1
       week = date.week_of_year
       # → 53
       ```

       ### The week of the same date in the US
       ```
       date = Date.new 2021 1 1
       week = date.week_of_year Locale.us
       # → 1
       ```

       ## Remarks

       ### Locale Dependency
       Note that this operation is locale-specific. It varies both by the local
       definition of the first day of week and the definition of the first week
       of year. For example, in the US, the first day of the week is Sunday and
       week 1 is the week containing January 1. In the UK on the other hand, the
       first day of the week is Monday, and week 1 is the week containing the
       first Thursday of the year. Therefore it is important to properly specify
       the `locale` argument.
    week_of_year self (locale : Locale | Nothing = Nothing) -> Integer =
        ensure_in_epoch self <|
            if locale.is_nothing then Time_Utils.get_field_as_localdate self IsoFields.WEEK_OF_WEEK_BASED_YEAR else
                Time_Utils.week_of_year_localdate self locale.java_locale

    ## ---
       group: DateTime
       icon: metadata
       ---
       Whether this date is in a leap year.
       Produces a warning for a Date that is before epoch start.

       ## Examples
       ### A leap year
       ```
       date = Date.new 2000 3 1
       is_leap = date.is_leap_year
       # → True
       ```

       ### A century that is not a leap year
       ```
       date = Date.new 1900 3 1
       is_leap = date.is_leap_year
       # → False
       ```
    is_leap_year : Boolean
    is_leap_year self =
        ensure_in_epoch self <|
            Time_Utils.is_leap_year self

    ## ---
       group: DateTime
       icon: metadata
       ---
       The number of days in the year of this date, 365 or 366.
       Produces a warning for a Date that is before epoch start.

       ## Examples
       ### The length of a leap year
       ```
       date = Date.new 2020 3 1
       days = date.length_of_year
       # → 366
       ```
    length_of_year : Integer
    length_of_year self = if self.is_leap_year then 366 else 365

    ## ---
       icon: metadata
       ---
       The century of this date, counting 2000 as the last year of the 20th century.
       Returns an `Illegal_Argument` error for a year before the common era.

       ## Examples
       ### The century of the year 2000
       ```
       date = Date.new 2000 1 1
       century = date.century
       # → 20
       ```
    century : Integer
    century self = if self.year > 0 then (self.year - 1).div 100 + 1 else
        Error.throw (Illegal_Argument.Error "Century can only be given for AD years.")

    ## ---
       group: Metadata
       icon: metadata
       ---
       The quarter of the year this date falls into, from 1 to 4.

       ## Examples
       ### The first day of the second quarter
       ```
       date = Date.new 2020 4 1
       quarter = date.quarter
       # → 2
       ```
    quarter : Integer
    quarter self = Time_Utils.get_field_as_localdate self IsoFields.QUARTER_OF_YEAR

    ## ---
       group: DateTime
       icon: metadata
       ---
       The number of days in the month of this date.
       Produces a warning for a Date that is before epoch start.

       ## Examples
       ### The length of February in a leap year
       ```
       date = Date.new 2020 2 10
       days = date.length_of_month
       # → 29
       ```
    length_of_month : Integer
    length_of_month self =
        ensure_in_epoch self <|
            Time_Utils.length_of_month self

    ## ---
       group: DateTime
       icon: metadata
       ---
       The first day of the month of this date.

       ## Examples
       ### The first day of December
       ```
       date = Date.new 2020 12 23
       first = date.first_of_month
       # → 2020-12-01
       ```
    first_of_month self -> Date =
        Time_Utils.first_of_month self

    ## ---
       group: DateTime
       icon: metadata
       ---
       The last day of the month of this date.

       ## Examples
       ### The last day of a leap-year February
       ```
       date = Date.new 2020 2 10
       last = date.end_of_month
       # → 2020-02-29
       ```
    end_of_month self -> Date =
        Time_Utils.end_of_month self

    ## ---
       icon: metadata
       ---
       The day of the year of this date, counting 1 January as day 1.

       ## Examples
       ### The last day of a leap year
       ```
       date = Date.new 2020 12 31
       day = date.day_of_year
       # → 366
       ```
    day_of_year : Integer
    day_of_year self = Time_Utils.get_field_as_localdate self ChronoField.DAY_OF_YEAR

    ## ---
       group: Metadata
       icon: metadata
       ---
       The day of the week of this date.
       Produces a warning for a Date that is before epoch start.

       ## Examples
       ### The day of the week of a date
       ```
       date = Date.new 2020 12 23
       day = date.day_of_week
       # → Wednesday
       ```
    day_of_week : Day_Of_Week
    day_of_week self =
        ensure_in_epoch self <|
            Day_Of_Week.from (Time_Utils.get_field_as_localdate self ChronoField.DAY_OF_WEEK) Day_Of_Week.Monday

    ## ---
       group: DateTime
       icon: time
       ---
       The first date of the period of the given kind that contains this date.

       ## Arguments
       - `period`: The kind of period to find the start of: year, quarter, month, week
         or day.

       ## Examples
       ### The start of the quarter
       ```
       date = Date.new 2020 12 23
       start = date.start_of Date_Period.Quarter
       # → 2020-10-01
       ```
    start_of self (period : Date_Period = ..Month) -> Date = period.adjust_start self

    ## ---
       group: DateTime
       icon: time
       ---
       The last date of the period of the given kind that contains this date.

       ## Arguments
       - `period`: The kind of period to find the end of: year, quarter, month, week or
         day.

       ## Examples
       ### The end of the week
       ```
       date = Date.new 2020 12 23
       last = date.end_of Date_Period.Week
       # → 2020-12-27
       ```
    end_of self (period : Date_Period = ..Month) -> Date = period.adjust_end self

    ## ---
       group: DateTime
       icon: time
       ---
       The date after this one: a day later, or one of the given period.
       Produces a warning for a Date that is before epoch start.
       See `Date_Time.enso_epoch_start`.

       ## Arguments
       - `period`: The period to add to this date.

       ## Examples
       ### The day after the last day of a year
       ```
       date = Date.new 2020 12 31
       next = date.next
       # → 2021-01-01
       ```

       ### A month later, clamped to the end of a shorter month
       ```
       date = Date.new 2020 1 31
       next = date.next Date_Period.Month
       # → 2020-02-29
       ```
    next : Date_Period -> Date
    next self period:Date_Period=..Day = self + period.to_period

    ## ---
       group: DateTime
       icon: time
       ---
       The date before this one: a day earlier, or one of the given period.
       Produces a warning for a Date that is before epoch start.
       See `Date_Time.enso_epoch_start`.

       ## Arguments
       - `period`: The period to subtract from this date.

       ## Examples
       ### The day before the first day of a year
       ```
       date = Date.new 2021 1 1
       previous = date.previous
       # → 2020-12-31
       ```

       ### A month earlier, clamped to the end of a shorter month
       ```
       date = Date.new 2020 3 31
       previous = date.previous Date_Period.Month
       # → 2020-02-29
       ```
    previous : Date_Period -> Date
    previous self period:Date_Period=..Day = self - period.to_period

    ## ---
       group: DateTime
       icon: time
       ---
       Creates a `Period` between this date and the provided end date.
       Produces a warning for a Date that is before epoch start.
       See `Date_Time.enso_epoch_start`.

       ## Arguments
       - `end`: The date the period runs up to.

       ## Examples
       ### The period between two dates
       ```
       date = Date.new 2020 1 15
       period = date.until (Date.new 2020 12 23)
       # → Period.Value P11M8D
       ```
    until self (end : Date) -> Period =
        ensure_in_epoch self <| ensure_in_epoch end <|
            Period.between self end

    ## ---
       group: DateTime
       icon: time
       ---
       Counts the days between this date (inclusive) and the provided end date
       (exclusive, or inclusive if `include_end_date` is on).
       Produces a warning for a Date that is before epoch start.
       See `Date_Time.enso_epoch_start`.

       ## Arguments
       - `end`: The date to count the days up to.
       - `include_end_date`: Whether to count the end date too.

       ## Examples
       ### The days to the start of the next year
       ```
       date = Date.new 2020 12 20
       days = date.days_until (Date.new 2021 1 1)
       # → 12
       ```

       ### Counting the end date too
       ```
       date = Date.new 2020 12 20
       days = date.days_until (Date.new 2021 1 1) include_end_date=True
       # → 13
       ```
    days_until self (end : Date) (include_end_date : Boolean = False) -> Integer =
        if end < self then -(end.days_until self include_end_date) else
            ensure_in_epoch self <| ensure_in_epoch end <|
                (Time_Utils.days_between self end) + if include_end_date then 1 else 0

    ## ---
       group: DateTime
       icon: time
       ---
       A part of this date, as a number: the year, quarter, month, week of the year or
       day of the month.
       Produces a warning for a Date that is before epoch start.
       See `Date_Time.enso_epoch_start`.

       ## Arguments
       - `period`: Which part of the date to return.

       ## Examples
       ### The quarter of a date
       ```
       date = Date.new 2020 12 23
       quarter = date.date_part Date_Period.Quarter
       # → 4
       ```
    date_part : Date_Period -> Integer
    date_part self (period : Date_Period) =
        case period of
            Date_Period.Year    -> self.year
            Date_Period.Quarter -> self.quarter
            Date_Period.Month   -> self.month
            Date_Period.Week _  -> self.week_of_year locale=Nothing
            Date_Period.Day     -> self.day

    ## ---
       group: DateTime
       icon: time
       ---
       Computes the difference between two dates as a whole number of periods.
       The difference is positive if `end` is after this date.
       Produces a warning for a Date that is before epoch start.
       See `Date_Time.enso_epoch_start`.

       ## Arguments
       - `end`: The date to compute the difference to.
       - `period`: The kind of period to count.

       ## Examples
       ### The whole months between two dates
       ```
       date = Date.new 2020 1 1
       months = date.date_diff (Date.new 2020 12 23) Date_Period.Month
       # → 11
       ```
    date_diff : Date -> Date_Period -> Integer
    date_diff self (end : Date) (period : Date_Period) = ensure_in_epoch self <|
        Time_Utils.unit_date_difference period.to_java_unit self end

    ## ---
       group: DateTime
       icon: time
       ---
       Shifts this date by a number of periods.
       Produces a warning for a Date that is before epoch start.
       See `Date_Time.enso_epoch_start`.

       ## Arguments
       - `amount`: How many periods to shift the date by. A negative number shifts it
         back.
       - `period`: The kind of period to shift by.

       ## Examples
       ### A month after the end of January
       ```
       date = Date.new 2020 1 31
       shifted = date.date_add 1 Date_Period.Month
       # → 2020-02-29
       ```
    date_add : Integer -> Date_Period -> Date
    date_add self (amount : Integer) (period : Date_Period) = ensure_in_epoch self <|
        Time_Utils.unit_date_add period.to_java_unit self amount

    ## ---
       group: DateTime
       icon: time
       ---
       Counts the working days from this date (inclusive) up to the provided end date
       (exclusive, or inclusive if `include_end_date` is on). Weekends are not
       counted.
       Produces a warning for a Date that is before epoch start.
       See `Date_Time.enso_epoch_start`.

       ## Arguments
       - `end`: The date to count the working days up to.
       - `holidays`: Dates to skip as well. Weekends are already skipped.
       - `include_end_date`: Whether to count the end date too, as Excel's `NETWORKDAYS`
         does.

       ## Examples
       ### The working days of January 2020
       ```
       date = Date.new 2020 1 1
       days = date.work_days_until (Date.new 2020 2 1)
       # → 23
       ```

       ### Skipping a holiday
       ```
       date = Date.new 2020 1 1
       holidays = [Date.new 2020 1 1]
       days = date.work_days_until (Date.new 2020 2 1) holidays
       # → 22
       ```

       ### Counting the end date too
       ```
       date = Date.new 2020 1 6
       days = date.work_days_until (Date.new 2020 1 10) include_end_date=True
       # → 5
       ```

       ## Remarks

       ### Including the end date
       To be consistent with how we usually represent intervals (in an
       end-exclusive manner), by default the end date is not included in the
       count. This has the nice property that for example to count the work days
       within the next week you can do `date.work_days_until (date + (Period.new
       days=7))` and it will look at the 7 days starting from the current `date`
       and not 8 days. This also gives us a property that `date.work_days_until
       (date.add_work_days N) == N` for any non-negative N. On the other hand,
       sometimes we may want the end date to be included in the count, so we
       provide the `include_end_date` argument for that purpose. Setting it to
       `True` should make the result consistent with the `NETWORKDAYS` function
       in Excel and similar products.
    work_days_until self (end : Date) (holidays : Vector Date = []) (include_end_date : Boolean = False) -> Integer =
        ensure_in_epoch self <|
            if include_end_date then self.work_days_until (end + (Period.new days=1)) holidays include_end_date=False else
                weekdays = week_days_between self end
                ## We count holidays that occurred within the period, but not on the
                   weekends (as weekend days have already been excluded from the count).
                   We also need to ensure we exclude each holiday only once, even if the
                   user provided it multiple times.
                overlapping_holidays = holidays.filter holiday->
                    fits_in_range self end holiday && (is_weekend holiday).not
                weekdays - overlapping_holidays.distinct.length

    ## ---
       aliases: [date to time]
       group: Conversions
       icon: convert
       ---
       Combines this date with a time of day to create a point in time.

       ## Arguments
       - `time_of_day`: The time of day to combine with the date. By default it is
         midnight.
       - `zone`: The time zone in which to create the time. By default it is the
         system time zone.

       ## Examples
       ### A date at half past noon, UTC
       ```
       date = Date.new 2020 2 3
       time = date.to_date_time (Time_Of_Day.new 12 30) Time_Zone.utc
       # → 2020-02-03 12:30:00Z[UTC]
       ```
    to_date_time self (time_of_day : Time_Of_Day = Time_Of_Day.new) (zone : Time_Zone = Time_Zone.system) -> Date_Time =
        Time_Utils.make_zoned_date_time self time_of_day zone

    ## ---
       aliases: [add period]
       group: Operators
       icon: time
       ---
       Adds an amount of time to this date to get another date.

       ## Arguments
       - `amount`: The amount of time to add: a `Date_Period`, or a `Period` for a
         custom number of years, months and days.

       ## Examples
       ### Add six months to the end of August
       ```
       date = Date.new 2020 8 31
       later = date + (Period.new months=6)
       # → 2021-02-28
       ```

       ### Add a month to a date
       ```
       date = Date.new 2020 12 23
       later = date + Date_Period.Month
       # → 2021-01-23
       ```
    @amount make_period_selector
    + : Period | Date_Period -> Date ! (Time_Error | Illegal_Argument)
    + self (amount : Period | Date_Period) =
        case amount of
            period : Period ->
                Time_Utils.date_adjust self Time_Utils.AdjustOp.PLUS period.internal_period
            date_period : Date_Period ->
                self + date_period.to_period

    ## ---
       aliases: [date range]
       group: Input
       icon: time
       ---
       Creates an increasing range of dates from this date to `end`.

       ## Arguments
       - `end`: The end of the range.
       - `include_end`: Whether the range includes `end`. By default the range is
         right-exclusive.
       - `step`: The step of the range, a `Date_Period` or a `Period`. By default the
         step is one day.

       ## Examples
       ### The days from 5 to 10 December
       ```
       start = Date.new 2021 12 5
       range = start.up_to (Date.new 2021 12 10)
       days = range.to_vector
       # → [2021-12-05, 2021-12-06, 2021-12-07, 2021-12-08, 2021-12-09]
       ```

       ### Include the end date
       ```
       start = Date.new 2021 12 5
       range = start.up_to (Date.new 2021 12 6) include_end=True
       days = range.to_vector
       # → [2021-12-05, 2021-12-06]
       ```

       ### Step a week at a time
       ```
       start = Date.new 2021 12 5
       range = start.up_to (Date.new 2022 1 1) step=Date_Period.Week
       days = range.to_vector
       # → [2021-12-05, 2021-12-12, 2021-12-19, 2021-12-26]
       ```
    @step make_period_selector
    up_to : Date -> Boolean -> Date_Period|Period -> Date_Range
    up_to self end:Date include_end:Boolean=False step:Date_Period|Period=Date_Period.Day =
        effective_end = if include_end then end.next else end
        day_range = Date_Range.new_internal self effective_end increasing=True step=(Period.new days=1)
        if step == Date_Period.Day then day_range else day_range.with_step step

    ## ---
       aliases: [date range]
       group: Input
       icon: time
       ---
       Creates a decreasing range of dates from this date to `end`.

       ## Arguments
       - `end`: The end of the range.
       - `include_end`: Whether the range includes `end`. By default the range is
         right-exclusive.
       - `step`: The step of the range, a `Date_Period` or a `Period`. By default the
         step is one day.

       ## Examples
       ### The days from 10 down to 5 December
       ```
       start = Date.new 2021 12 10
       range = start.down_to (Date.new 2021 12 5)
       days = range.to_vector
       # → [2021-12-10, 2021-12-09, 2021-12-08, 2021-12-07, 2021-12-06]
       ```

       ### Include the end date
       ```
       start = Date.new 2021 12 6
       range = start.down_to (Date.new 2021 12 5) include_end=True
       days = range.to_vector
       # → [2021-12-06, 2021-12-05]
       ```
    @step make_period_selector
    down_to : Date -> Boolean -> Date_Period|Period -> Date_Range
    down_to self end:Date include_end:Boolean=False step:Date_Period|Period=Date_Period.Day =
        effective_end = if include_end then end.previous else end
        day_range = Date_Range.new_internal self effective_end increasing=False step=(Period.new days=1)
        if step == Date_Period.Day then day_range else day_range.with_step step

    ## ---
       group: DateTime
       icon: time
       ---
       Shifts this date by a number of working days, Monday to Friday.
       Produces a warning for a Date that is before epoch start.
       See `Date_Time.enso_epoch_start`.

       ## Arguments
       - `days`: The number of working days to shift the date by. A negative number
         shifts it back.
       - `holidays`: Dates to skip as well. Weekends are already skipped.

       ## Examples
       ### The next working day after a Friday
       ```
       date = Date.new 2020 2 7
       next = date.add_work_days 1
       # → 2020-02-10
       ```

       ### Skipping a holiday
       ```
       date = Date.new 2020 12 24
       holidays = [Date.new 2020 12 25]
       next = date.add_work_days 1 holidays
       # → 2020-12-28
       ```

       ## Remarks

       ### Which day you land on
       The result is always a working day: with a shift of zero, the closest following
       working day is returned. For the shift, a weekend or holiday counts as if the
       count started on the next working day, so shifting a Sunday by zero days gives
       Monday, and shifting it by one day gives Tuesday. For a negative shift, shifting
       a Saturday or Sunday back one day gives Friday, and so does shifting a Monday.
       The logic is consistent with `work_days_until`, so that
       `date.work_days_until (date.add_work_days N) == N` for any `N >= 0` and
       `(date.add_work_days N).work_days_until date == -N` for any `N < 0`.
    add_work_days self (days : Integer = 1) (holidays : Vector Date = []) -> Date =
        ensure_in_epoch self <|
            self.internal_add_work_days days holidays

    ## ---
       private: true
       ---
       ensure_in_epoch breaks tail call annotation and causes stack overflow.
       That is why `add_work_days` method is split into two methods.
    internal_add_work_days self (days : Integer = 1) (holidays : Vector Date = []) -> Date =
        case days >= 0 of
            True ->
                full_weeks = days.div 5
                remaining_days = days % 5

                # If the current day is a Saturday, the ordinal will be 6.
                ordinal = self.day_of_week.to_integer first_day=Day_Of_Week.Monday start_at_zero=False

                ## If the current day is a Sunday, we just need to shift by one day
                   to 'escape' the weekend, regardless of the overall remaining
                   shift. On any other day, we check if current day plus the shift
                   overlaps a weekend, we need the shift to be 2 days since we need
                   to skip both Saturday and Sunday.
                additional_shift = if ordinal == 7 then 1 else
                    if ordinal + remaining_days > 5 then 2 else 0

                days_to_shift = full_weeks*7 + remaining_days + additional_shift
                end = self + (Period.new days=days_to_shift)

                ## We have shifted the date so that weekends are taken into account,
                   but other holidays may have happened during that shift period.
                   Thus we may have shifted by less workdays than really desired. We
                   compute the difference and if there are still remaining workdays
                   to shift by, we re-run the whole shift procedure.
                workdays = self.work_days_until end holidays include_end_date=False
                diff = days - workdays
                if diff > 0 then @Tail_Call end.internal_add_work_days diff holidays else
                    ## Otherwise we have accounted for all workdays we were asked
                       to. But that is still not the end - we still need to ensure
                       that the final day on which we have 'landed' is a workday
                       too. Our procedure ensures that it is not a weekend, but it
                       can still be a holiday. So we will be shifting the end date
                       as long as needed to fall on a non-weekend non-holiday
                       workday.
                    go end_date =
                        if holidays.contains end_date || is_weekend end_date then @Tail_Call go (end_date + (Period.new days=1)) else end_date
                    go end
            False ->
                ## We shift a bit so that if shifting by N full weeks, the 'last'
                   shift is done on `remaining_days` and not full weeks. That is
                   because shifting a Saturday back 5 days does not want us to get
                   to the earlier Saturday and fall back to the Friday before it,
                   but we want to stop at the Monday just after that Saturday.
                full_weeks = (days + 1).div 5
                remaining_days = (days + 1) % 5 - 1

                # If the current day is a Sunday, the ordinal will be 1.
                ordinal = self.day_of_week.to_integer first_day=Day_Of_Week.Sunday start_at_zero=False

                ## If we overlapped the weekend, we need to increase the shift by
                   one day (our current shift already shifts us by one day, but we
                   need one more to skip the whole two-day weekend).
                additional_shift = if ordinal == 1 then -1 else
                    if ordinal + remaining_days <= 1 then -2 else 0

                ## The rest of the logic is analogous to the positive case, we
                   just need to correctly handle the reverse order of dates. The
                   `days_to_shift` will be negative so `end` will come _before_
                   `self`.
                days_to_shift = full_weeks*7 + remaining_days + additional_shift
                end = self + (Period.new days=days_to_shift)
                workdays = end.work_days_until self holidays include_end_date=False

                ## `days` is negative but `workdays` is positive, `diff` will be
                   zero if we accounted for all days or negative if there are
                   still workdays we need to shift by - then it will be exactly
                   the remaining offset that we need to shift by.
                diff = days + workdays
                if diff < 0 then @Tail_Call end.internal_add_work_days diff holidays else
                    ## As in the positive case, if the final end date falls on a
                       holiday, we need to ensure that we move it - this time
                       backwards - to the first workday.
                    go end_date =
                        if holidays.contains end_date || is_weekend end_date then @Tail_Call go (end_date - (Period.new days=1)) else end_date
                    go end

    ## ---
       aliases: [subtract period]
       group: Operators
       icon: time
       ---
       Subtracts an amount of time from this date to get another date.

       ## Arguments
       - `amount`: The amount of time to subtract: a `Date_Period`, or a `Period` for a
         custom number of years, months and days.

       ## Examples
       ### The day before 1 March
       ```
       date = Date.new 2020 3 1
       earlier = date - (Period.new days=1)
       # → 2020-02-29
       ```

       ### Subtract a month from a date
       ```
       date = Date.new 2020 3 31
       earlier = date - Date_Period.Month
       # → 2020-02-29
       ```
    @amount make_period_selector
    - : Period | Date_Period -> Date ! (Time_Error | Illegal_Argument)
    - self amount:(Period | Date_Period) =
        case amount of
            period : Period ->
                new_java_date = Time_Utils.date_adjust self Time_Utils.AdjustOp.MINUS period.internal_period
                Date.new new_java_date.year new_java_date.month new_java_date.day
            date_period : Date_Period ->
                self - date_period.to_period

    ## ---
       private: true
       ---
       Convert to a display representation of this Date.
    to_display_text : Text
    to_display_text self =
        self.format "yyyy-MM-dd"

    ## ---
       private: true
       ---
       Convert to a JS_Object representing this Date.

       ## Examples
       ### Convert the current date to a JS_Object.

       ```
             example_to_json = Date.today.to_js_object
       ```
    to_js_object : JS_Object
    to_js_object self =
        type_pair = ["type", "Date"]
        cons_pair = ["constructor", "new"]
        JS_Object.from_pairs [type_pair, cons_pair, ["day", self.day], ["month", self.month], ["year", self.year]]

    ## ---
       group: Conversions
       icon: convert
       arguments:
         format: always
       ---
       Formats this date as text using the provided format specifier.

       ## Arguments
       - `format`: A pattern describing how to format the text, or a
         `Date_Time_Formatter`. By default the date is written as an ISO-8601 date.

       ## Examples
       ### Format a date with the month's name
       ```
       date = Date.new 2020 6 2
       text = date.format "d MMMM yyyy"
       # → "2 June 2020"
       ```

       ### Format a date with a short weekday and month
       ```
       date = Date.new 2020 6 2
       text = date.format "ddd MMM d"
       # → "Tue Jun 2"
       ```

       ### Format a date with the weekday's full name
       ```
       date = Date.new 2020 6 2
       text = date.format "dddd, dd MMMM yyyy"
       # → "Tuesday, 02 June 2020"
       ```

       ### Format a date in a particular locale
       ```
       date = Date.new 2020 6 21
       formatter = Date_Time_Formatter.from "d. MMMM yyyy" (Locale.new "fr")
       text = date.format formatter
       # → "21. juin 2020"
       ```

       ## Remarks

       ### Pattern Syntax
       If the pattern is provided as `Text`, it is parsed using the format
       described below. See `Date_Time_Formatter` for more options.
       - y: Year. The number of pattern letters determines the minimum number of
       digits.
       - y: The year using any number of digits.
       - yy: The year, using at most two digits. The default range is 1950-2049,
       but this can be changed by including the end year in braces e.g.
       `yy{2099}`.
       - yyyy: The year, using exactly four digits.
       - M: Month of year. The number of pattern letters determines the format:
       - M: Any number (1-12).
       - MM: Month number with zero padding required (01-12).
       - MMM: Short name of the month (Jan-Dec).
       - MMMM: Full name of the month (January-December).
       The month names depend on the selected locale.
       - d: Day. The number of pattern letters determines the format:
       - d: Any number (1-31).
       - dd: Day number with zero padding required (01-31).
       - ddd: Short name of the day of week (Mon-Sun).
       - dddd: Full name of the day of week (Monday-Sunday).
       The weekday names depend on the selected locale.
       Both day of week and day of month may be included in a single pattern - in
       such case the day of week is used as a sanity check.
       - Q: Quarter of year.
       If only year and quarter are provided in the pattern, when parsing a date,
       the result will be the first day of that quarter.
    @format make_date_format_selector
    format : Date_Time_Formatter -> Text
    format self format:Date_Time_Formatter=Date_Time_Formatter.iso_date =
        format.format_date self

    ## ---
       private: true
       group: convert
       icon: enso_logo
       ---
       Convert the value to a corresponding Enso code representation.

       ## Examples
       ### Getting the Enso code of the date 29-October-2024.

       ```
             (Date.new 2024 10 29).pretty
       ```
       Returns a Text

                Date.new 2024 10 29
    pretty : Text
    pretty self = "Date.new " + self.year.to_text + " " + self.month.to_text + " " + self.day.to_text

    ## ---
       aliases: [greater than]
       group: Operators
       icon: operators
       ---
       Checks if this date is after `that` date.

       ## Arguments
       - `that`: The date to compare with.

       ## Examples
       ### A date after another
       ```
       date = Date.new 2020 12 23
       other = Date.new 2020 1 1
       result = date > other
       # → True
       ```

       ## Remarks

       ### The `that` argument
       This argument has no date picker. Connect a date, or type one such as
       `Date.new 2020 1 1`.
    > self that = Comparable.> self=self that

    ## ---
       aliases: [greater than or equal]
       group: Operators
       icon: operators
       ---
       Checks if this date is the same as, or after, `that` date.

       ## Arguments
       - `that`: The date to compare with.

       ## Examples
       ### A date compared with itself
       ```
       date = Date.new 2020 12 23
       other = Date.new 2020 12 23
       result = date >= other
       # → True
       ```

       ## Remarks

       ### The `that` argument
       This argument has no date picker. Connect a date, or type one such as
       `Date.new 2020 1 1`.
    >= self that = Comparable.>= self=self that

    ## ---
       aliases: [less than]
       group: Operators
       icon: operators
       ---
       Checks if this date is before `that` date.

       ## Arguments
       - `that`: The date to compare with.

       ## Examples
       ### A date before another
       ```
       date = Date.new 2020 1 1
       other = Date.new 2020 12 23
       result = date < other
       # → True
       ```

       ## Remarks

       ### The `that` argument
       This argument has no date picker. Connect a date, or type one such as
       `Date.new 2020 1 1`.
    < self that = Comparable.< self=self that

    ## ---
       aliases: [less than or equal]
       group: Operators
       icon: operators
       ---
       Checks if this date is the same as, or before, `that` date.

       ## Arguments
       - `that`: The date to compare with.

       ## Examples
       ### A date after another
       ```
       date = Date.new 2020 12 23
       other = Date.new 2020 1 1
       result = date <= other
       # → False
       ```

       ## Remarks

       ### The `that` argument
       This argument has no date picker. Connect a date, or type one such as
       `Date.new 2020 1 1`.
    <= self that = Comparable.<= self=self that

## ---
   private: true
   ---
   The choices for an amount of time added to, or stepped from, a Date: each
   `Date_Period`, written autoscoped (`..Day`), and `Period.new` for a custom
   number of years, months and days. `..Day` resolves against the
   `Period | Date_Period` union: the engine tries each member in turn, and
   only `Date_Period` has a `Day` constructor.
make_period_selector -> Widget =
    periods = ["Year", "Quarter", "Month", "Week", "Day"].map name->
        code = ".." + name
        Option code code
    Widget.Single_Choice values=(periods + [Option "Period.new" "(Period.new)"])

## ---
   private: true
   ---
week_days_between start end =
    ## We split the interval into 3 periods: the first week (containing the
       starting point), the last week (containing the end point), and the full
       weeks in between those. In some cases there may be no weeks in-between
       and the first and last week can be the same week.
    start_of_first_full_week = (start.start_of Date_Period.Week) + (Period.new days=7)
    start_of_last_week = end.start_of Date_Period.Week
    full_weeks_between = (Time_Utils.days_between start_of_first_full_week start_of_last_week).div 7
    case full_weeks_between < 0 of
        # Either start is before end or they both lie within the same week.
        True ->
            days_between = Time_Utils.days_between start end
            if days_between <= 0 then 0 else
                ## The end day is not counted, but if the end day was a Sunday,
                   the last day was a Saturday and it should not be counted
                   either, so we need to subtract it.
                case end.day_of_week of
                    Day_Of_Week.Sunday -> days_between - 1
                    _ -> days_between
        False ->
            # We count the days in the first week up until Friday - the weekend is not counted.
            first_week_days = (Time_Utils.days_between start (start_of_first_full_week - (Period.new days=2))).max 0
            # We count the days in the last week, not including the weekend.
            last_week_days = (Time_Utils.days_between start_of_last_week end).min 5
            full_weeks_between * 5 + first_week_days + last_week_days

## ---
   private: true
   ---
is_weekend date =
    dow = date.day_of_week
    (dow == Day_Of_Week.Saturday) || (dow == Day_Of_Week.Sunday)

## ---
   private: true
   ---
fits_in_range start end date =
    (start <= date) && (date < end)

## ---
   private: true
   ---
Date.from (that:JS_Object) =
    if that.get "type" == "Date" && ["year", "month", "day"].all that.contains_key then Date.new (that.get "year") (that.get "month") (that.get "day") else
        Error.throw (Illegal_Argument.Error "Invalid JS_Object for Date.from.")

## ---
   private: true
   ---
private make_day_picker value (year = Nothing) (month = Nothing) =
    _ = value
    days = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    max = if month.is_nothing then 31 else
        if month != 2 || year.is_nothing then days.at (month - 1) else
            if Date.new year 1 1 . is_leap_year then 29 else 28
    Widget.Numeric_Input minimum=1 maximum=max
