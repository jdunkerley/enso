from Standard.Base import all
import Standard.Base.Runtime.State
from Standard.Base.Logging import all

polyglot java import org.enso.base.Text_Utils

## ---
   private: true
   ---
   Truncate message to the provided max length.
truncate : Text -> Integer -> Text -> Text
truncate message max_length=256 suffix='...' =
    if message.length > max_length then message.take max_length-suffix.length + suffix else message

## ---
   private: true
   ---
   Truncated display text for logging
private short_display value = if value.is_error then "<ERROR>" else
    case value of
        Nothing -> "Nothing"
        _ : Dictionary -> "Dictionary(" + value.length.to_text + ")"
        _ : Vector -> "Vector(" + value.length.to_text + ")"
        _ : Array -> "Array(" + value.length.to_text + ")"
        _ : Text ->
            sub = value.take 20
            if sub != value then sub + "..." else sub
        _ : File -> "File(" + value.name + ")"
        _ : Enso_File -> "Enso_File(" + value.name + ")"
        _ -> value.to_display_text

## ---
   private: true
   ---
   If ENSO_TIME_VIZZES is set, then log the time it took to compute the function
private time_visualization module ~name ~action =
    wrapped =
        result = Panic.catch Any action handler=caught_panic->
            module.log_internal ("Visualization "+name+" failed (panic): " + caught_panic.payload.to_text) ..Severe
            Panic.throw caught_panic
        if result.is_error then module.log_internal ("Visualization "+name+" failed (error): " + result.catch.to_text) ..Warning
        result
    # TBD: also need to replace this usage of Logging.Profile
    _time_execution _profile_level label=name module=module suffix_callback=_profile_suffix wrapped

private _profile_suffix value = case value of
    _:Text -> " length=" + (Text_Utils.char_length value).to_text
    Nothing -> " result=Nothing"
    _ -> " result=" + (Meta.meta value).qualified_name

private _profile_level = State.get Helpers if_missing=_profile_level_from_env

private _profile_level_from_env =
    env_val = Environment.get "ENSO_PROFILE_VIZZES"
    if env_val == Nothing then Nothing else
        level = Log_Level.from env_val
        if level.is_error then Nothing else level

## ---
   advanced: true
   icon: time
   ---
   Time the evaluation of a function, log the duration and return the result.

   ## Arguments
    - `level`: Log level to log the duration at. If `Nothing`, the duration is not logged.
    - `label`: Label to log with the duration.
    - `function`: Function to execute.
    - `suffix_callback`: Optional callback to generate a suffix for the log message based
       on the result of the function. The callback is only called if `level` is not `Nothing`.
    - `module`: Module to log the message to. Defaults to `Profile`.
private _time_execution level:(Log_Level | Nothing) ~label:Text ~function suffix_callback=Nothing module =
    if Nothing == level then @Tail_Call function else
        pair = Duration.time_execution function

        ## If the function threw an error, we just return the error
        Error.return_if_error pair.second

        duration = pair.first
        suffix = if suffix_callback == Nothing then "" else suffix_callback pair.second
        module.log_internal ("Execution time for " + label + ": " + duration.to_text + suffix) level
        pair.second
