from Standard.Base import all

## ---
   private: true
   ---
   An ID used by the visualization system to identify different ways of
   displaying data.
type Id
    ## ---
       private: true
       ---
       A builtin visualization, implemented in the graphical interface and not
       imported from any library.
    Builtin name

    ## ---
       private: true
       ---
       A visualization shipped by a library in its `visualizations/` folder.
       `library` is the library's qualified name (`Standard.Image`); `name` is
       the visualization's `name` export.
    Library library name

    ## ---
       private: true
       ---
       Serializes this ID to a JSON format understandable by the graphical
       interface: `library` is `null` for a builtin, else `{"name": library}`.
    to_js_object : JS_Object
    to_js_object self = case self of
        Id.Builtin name -> JS_Object.from_pairs [["library", Nothing], ["name", name]]
        Id.Library library name ->
            JS_Object.from_pairs [["library", JS_Object.from_pairs [["name", library]]], ["name", name]]

    ## ---
       private: true
       ---
       An identifier for the builtin JSON visualization
    json : Id
    json = Id.Builtin "JSON"

    ## ---
       private: true
       ---
       An identifier for the builtin Scatter Plot visualization
    scatter_plot : Id
    scatter_plot = Id.Builtin "Scatter Plot"

    ## ---
       private: true
       ---
       An identifier for the builtin Table visualization
    table : Id
    table = Id.Builtin "Table"

    ## ---
       private: true
       ---
       An identifier for the builtin Geo Map visualization
    geo_map : Id
    geo_map = Id.Builtin "Geo Map"

## ---
   private: true
   ---
   Any value opens in the Table visualization, unless its type picks another
   one with a conversion `Id.from (that:Its_Type)` in its own module.
Id.from (that:Any) =
    _ = that
    Id.table

## ---
   private: true
   ---
   A JS_Object opens in the JSON visualization.
Id.from (that:JS_Object) =
    _ = that
    Id.json
