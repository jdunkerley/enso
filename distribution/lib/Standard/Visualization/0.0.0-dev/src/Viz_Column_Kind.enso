from Standard.Base import all
import Standard.Base.Metadata.Column_Kind.Column_Kind

## ---
   private: true
   ---
   A column's kind, and the name the column's library gives its type (Table's
   `Value_Type.to_name`), which charts put in their JSON.
type Viz_Column_Kind
    ## ---
       private: true
       ---
    Value (kind : Column_Kind) (display_name : Text)

    ## ---
       private: true
       ---
    is_numeric self -> Boolean = self.kind == Column_Kind.Numeric

    ## ---
       private: true
       ---
    is_date_or_time self -> Boolean =
        [Column_Kind.Date_Only, Column_Kind.Date_And_Time, Column_Kind.Time_Only].contains self.kind

    ## ---
       private: true
       ---
       Infers the kind of a vector of values held in memory. `Nothing` values
       are ignored; an empty or mixed vector is `Other`.
    infer (values : Vector) -> Viz_Column_Kind =
        present = values.filter (v-> v.is_nothing.not)
        all_are predicate = present.not_empty && (present.all predicate)
        if all_are (v-> v.is_a Integer) then Viz_Column_Kind.Value Column_Kind.Numeric "Integer" else
            if all_are (v-> v.is_a Number) then Viz_Column_Kind.Value Column_Kind.Numeric "Float" else
                if all_are (v-> v.is_a Text) then Viz_Column_Kind.Value Column_Kind.Textual "Char" else
                    if all_are (v-> v.is_a Boolean) then Viz_Column_Kind.Value Column_Kind.Logical "Boolean" else
                        if all_are (v-> v.is_a Date_Time) then Viz_Column_Kind.Value Column_Kind.Date_And_Time "Date_Time" else
                            if all_are (v-> v.is_a Date) then Viz_Column_Kind.Value Column_Kind.Date_Only "Date" else
                                if all_are (v-> v.is_a Time_Of_Day) then Viz_Column_Kind.Value Column_Kind.Time_Only "Time" else
                                    Viz_Column_Kind.Value Column_Kind.Other "Mixed"
