from Standard.Base import all

from project.Helpers import time_visualization, short_display
from project.Viz_Actions import remove_warnings_action

## ---
   private: true
   ---
   Default preprocessor for the warnings visualization.
   Generates JSON text describing the warnings visualization: an object with
   the `warnings` (a vector of their display texts) and the `actions` the
   visualization offers, the single action `remove_warnings`. The visualization
   draws its button from that action.

   ## Arguments
    - `value`: the value to be visualized.
process_to_json_text : Any -> Text
process_to_json_text value = time_visualization Warnings ("process_to_json_text: " + (short_display value)) <|
    warnings = Warning.get_all value wrap_errors=True
    texts = warnings.map w->w.value.to_display_text
    vec = case Warning.limit_reached value of
        True -> texts + ["Warnings limit reached."]
        False -> texts
    '{"warnings":' + vec.to_json + ',"actions":[' + remove_warnings_action.to_json_text + ']}'
