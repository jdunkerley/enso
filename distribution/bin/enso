#!/usr/bin/env sh
ENGINE_ROOT=$(dirname "$(dirname "$(realpath "$0")")")
COMP_PATH=$ENGINE_ROOT/component
JAVA_OPTS="--enable-native-access=org.graalvm.truffle --sun-misc-unsafe-memory-access=allow --add-opens=java.base/java.nio=ALL-UNNAMED"
# A bundle (e.g. the IDE's) places the engine at <root>/dist/<version> and its
# JDK at <root>/runtime/graalvm-*. Prefer that JDK, so the engine still starts
# when `java` is not on PATH (the IDE launched from Finder or the Dock).
JAVA=java
for candidate in "$ENGINE_ROOT"/../../runtime/graalvm-*/bin/java; do
  if [ -x "$candidate" ]; then
    JAVA=$candidate
    break
  fi
done
exec "$JAVA" --module-path "$COMP_PATH" $JAVA_OPTS -m org.enso.runner/org.enso.runner.Main "$@"
exit
