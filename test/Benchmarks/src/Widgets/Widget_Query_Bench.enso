from Standard.Base import all
import Standard.Base.Metadata.Widget_Query
from Standard.Base.Metadata.Widget_Query import Widget_Method

from Standard.Table import Table
from Standard.Database import all
from Standard.SQLite import all
from Standard.DuckDB import all

from Standard.Test import Bench

options = Bench.options . set_warmup (Bench.phase_conf 1 2) . set_measure (Bench.phase_conf 1 3)

column_count = 500
row_count = 1000

## A table of `width` columns of five kinds (integer, float, text, date,
   boolean) and `row_count` rows. SQLite stores dates as text.
make_table width (date_as_text : Boolean = False) =
    columns = 0.up_to width . map i->
        values = case i % 5 of
            0 -> 0.up_to row_count . map j-> j+i
            1 -> 0.up_to row_count . map j-> (j*0.5)+i
            2 -> 0.up_to row_count . map j-> "t"+(j%50).to_text
            3 -> 0.up_to row_count . map j->
                date = (Date.new 2020 1 1) + (Period.new days=(j%365))
                if date_as_text then date.to_text else date
            _ -> 0.up_to row_count . map j-> (j%2)==0
        ["c"+i.to_text, values]
    Table.new columns

## The baseline's widget queries: method and arguments. The last four are
   resolvers of other arguments (PR 6a), here with those arguments unset, as
   the IDE asks before the user sets them.
queries = [["select_columns", ["columns"]], ["sort", ["columns"]], ["get", ["selector"]], ["filter", ["column", "filter"]], ["set", ["value"]], ["aggregate", ["group_by", "columns"]], ["cross_tab", ["group_by", "names", "values"]], ["join", ["on"]], ["fill_nothing", ["columns", "default"]], ["rename_columns", ["column_map"]], ["format", ["columns", "format"]], ["parse", ["columns", "type", "format"]]]

## The queries with a dependency set: `filter`'s `filter` once its `column`
   names a text column (`c2`). The report cannot fake an expression id, so it
   resolves the argument directly, as `resolve_call` does for it.
dependency_queries = [["filter (column set)", "filter", "filter", "column", "c2"]]

## The tables, built when first used. `duckdb` is `Nothing` where DuckDB
   cannot start (the benchmark job also runs off Linux).
type Data
    Value ~memory ~recomputed ~sqlite ~duckdb

    create =
        upload table connection = if connection.is_nothing then Nothing else
            table.select_into_database_table connection ("t"+column_count.to_text) temporary=True
        memory = make_table column_count
        ## Same schema, new version hash: `c0` is recomputed.
        recomputed = memory.set (memory.at "c0" + 1) as="c0"
        Data.Value memory recomputed (upload (make_table column_count True) (Database.connect (SQLite.In_Memory))) (upload (make_table column_count) connect_duckdb)

## An in-memory DuckDB connection, or `Nothing` where DuckDB cannot start. Only
   the lazy `duckdb` field calls it, so compiling or setting up the benchmarks
   opens no connection.
connect_duckdb = (Panic.catch Any (Database.connect (DuckDB.In_Memory)) (_-> Nothing)).catch Any (_-> Nothing)

## A backend: its name, its table in `Data`, and the method pointer's module
   and type for it.
type Backend
    Value name:Text table:(Data -> Any) module_name:Text type_name:Text

## A database table's widgets resolve against `Standard.Table.Table`, not
   `DB_Table`.
backends =
    table_module = "Standard.Table.Table"
    table_type = "Standard.Table.Table.Table"
    [Backend.Value "In_Memory" (d-> d.memory) table_module table_type, Backend.Value "In_Memory_Recomputed" (d-> d.recomputed) table_module table_type, Backend.Value "SQLite" (d-> d.sqlite) table_module table_type, Backend.Value "DuckDB" (d-> d.duckdb) table_module table_type]

## One widget query, as the IDE makes it; `Nothing` when the backend is absent.
run_query (backend : Backend) data query =
    table = backend.table data
    if table.is_nothing then Nothing else
        Widget_Query.resolve_call table backend.module_name backend.type_name query.first query.second

## One query with a dependency set: `[label, method, argument, dependency,
   value]`; `Nothing` when the backend is absent.
run_dependency_query (backend : Backend) data query =
    table = backend.table data
    if table.is_nothing then Nothing else
        method = Widget_Method.Value backend.module_name backend.type_name (query.at 1)
        values = Widget_Query.values_from_lookup (name-> if name == (query.at 3) then query.at 4 else Nothing)
        call_arguments = Meta.get_method_argument_names backend.module_name backend.type_name (query.at 1)
        Widget_Query.resolve_argument method (query.at 2) table values "" call_arguments Nothing . to_json

collect_benches = Bench.build builder->
    data = Data.create
    backends.each backend->
        builder.group ("Widget_Query_" + backend.name + "_" + column_count.to_text) options group_builder->
            queries.each query->
                group_builder.specify query.first <|
                    run_query backend data query
            dependency_queries.each query->
                group_builder.specify (query.first.replace " " "_" . replace "(" "" . replace ")" "") <|
                    run_dependency_query backend data query

main = collect_benches . run_main
