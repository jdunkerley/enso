from Standard.Base import all
import Standard.Base.Metadata.Widget_Query
import Standard.Table.Rows_To_Read.Rows_To_Read

from Standard.Test import all

add_specs suite_builder =
    suite_builder.group "Excel_Section widgets resolve (#897)" group_builder->
        group_builder.specify "resolve_type of Rows_To_Read returns its widget, with the All_Rows option" <|
            json = Widget_Query.resolve_type (Meta.meta Rows_To_Read . qualified_name)
            result = json.parse_json
            result.get "error" . should_equal Nothing
            labels = result.get "widget" . get "values" . map o-> o.get "label"
            labels.should_contain "All_Rows"

main filter=Nothing =
    suite = Test.build suite_builder->
        add_specs suite_builder
    suite.run_with_filter filter
