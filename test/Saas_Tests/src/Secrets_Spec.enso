from Standard.Base import all
import Standard.Base.Enso_Cloud.Enso_Secret.Enso_Secret_Error
import Standard.Test.Test_Environment

from Standard.Saas import all

from Standard.Test import all

from enso_dev.Base_Tests.Network.Local_Secrets_Setup import with_local_secrets

## Resolving the password fails while the SMTP authenticator is set up, before
   any connection is made, so none of these need an SMTP server.
send_with password =
    provider = ..SMTP "smtp.invalid" "user" password
    Email.send (..Address "a@example.com" "A") ["b@example.com"] subject="s" body=(..Plain_Text "b") provider=provider

add_specs suite_builder =
    suite_builder.group "Email_Provider_SMTP with an unreadable local secret" group_builder->
        group_builder.specify "a locked store, another key or a deleted secret is an Enso_Secret_Error, not a panic" <| with_local_secrets <|
            secret = Enso_Secret.create "smtp-password" "not-a-real-password"
            Test_Environment.unsafe_with_environment_override "ENSO_SECRETS_KEY" Nothing <|
                send_with secret . catch . should_equal Enso_Secret_Error.Locked
            Test_Environment.unsafe_with_environment_override "ENSO_SECRETS_KEY" "AQECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8" <|
                send_with secret . catch . should_equal Enso_Secret_Error.Wrong_Key
            secret.delete . should_succeed
            send_with secret . catch . should_equal (Enso_Secret_Error.Not_Found "secret://smtp-password")

main filter=Nothing =
    suite = Test.build suite_builder->
        add_specs suite_builder
    suite.run_with_filter filter
