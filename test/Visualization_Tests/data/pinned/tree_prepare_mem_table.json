{"actions":[{"id":"open_row","label":"Get Row","icon":"select_row","kind":"chain","template":"get_row {{#index}}"},{"id":"open_column","label":"Get Column","icon":"select_column","kind":"chain","template":"at {{@column}}"},{"id":"open_cell","label":"Get Value","icon":"select_cell","kind":"chain","template":"get_value {{@column}} {{#index}}"},{"id":"sort","label":"Sort","icon":"","kind":"chain","template":"sort {{columns*}}"},{"id":"filter","label":"Filter","icon":"","kind":"chain","template":"filter {{@column}} {{condition}}"},{"id":"remove_columns","label":"Remove Columns","icon":"","kind":"chain","template":"remove_columns {{@columns*}}"},{"id":"reorder_columns","label":"Reorder Columns","icon":"","kind":"chain","template":"reorder_columns {{@columns*}}"},{"id":"brush_filter","label":"Filter To Selection","icon":"","kind":"chain","template":"filter {{@column}} (..Between {{#min}} {{#max}})"}],"root":{"kind":"object","size":3,"label":"Table (3 rows, 4 columns)"},"children":{"start":0,"size":3,"entries":[{"key":"row_count","kind":"leaf","value":3,"expr":".row_count"},{"key":"columns","kind":"array","size":4,"label":"[4 columns]","expr":".columns"},{"key":"rows","kind":"array","size":3,"label":"[3 rows]","expr":".rows"}]}}