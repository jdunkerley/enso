from Standard.Base import all

import Standard.Base.Metadata.Choice
import Standard.Base.Metadata.Widget

from Standard.Database import all
from Standard.SQLite import all
from Standard.Table import Table, expr
from Standard.Base.Metadata.Choice import Option

import Standard.Base.Metadata.Widget_Query
import Standard.Base.Metadata.Column_Kind.Column_Kind
import Standard.Base.Metadata.Widget_Columns.Widget_Columns

import Standard.Database.Internal.IR.SQL_IR_Expression.SQL_IR_Expression
import Standard.Database.Internal.IR.SQL_IR_Source.SQL_IR_Source
import Standard.Database.Internal.SQL_Type_Reference.SQL_Type_Reference

import Standard.Test.Test_Environment
from Standard.Test import all


sqlite_module = "Standard.SQLite.SQLite_Connection"
sqlite_type = "Standard.SQLite.SQLite_Connection.SQLite_Connection"
# A DB table resolves against the in-memory `Table`: `get`, `at` and `filter` are defined there, not on `DB_Table`.
table_module = "Standard.Table.Table"
table_type = "Standard.Table.Table.Table"

## The answer for one argument whose widget is `widget`.
answer argument widget columns_json="" = '{"arguments":[[' + argument.to_json + ',{"widget":' + widget.to_json + '}]]' + columns_json + '}'

## Checks that the type has a `Widget.from` conversion and that `resolve_type`
   answers exactly that widget.
check_default typ =
    widget = Widget.from typ
    widget.should_be_a Widget
    type_name = Meta.meta typ . qualified_name
    Widget_Query.resolve_type type_name . should_equal ('{"widget":' + widget.to_json + '}')

add_specs suite_builder =
    connection = Database.connect (SQLite.In_Memory)
    connection.execute_update 'CREATE TABLE "mock_table" ("A" VARCHAR, "B C" INTEGER, "D ""E""" BOOLEAN, "F.G/H\\I" REAL)'
    connection.execute_update 'CREATE TABLE "another" ("A" VARCHAR, "B C" INTEGER, "D ""E""" BOOLEAN, "F.G/H\\I" REAL)'
    connection.execute_update 'CREATE TABLE "a_table" ("A" VARCHAR, "B C" INTEGER, "D ""E""" BOOLEAN, "F.G/H\\I" REAL)'

    suite_builder.group "Widgets for In-Database Connection with table types" group_builder->
        group_builder.specify "works for `tables`" <|
            result = Widget_Query.resolve_call connection sqlite_module sqlite_type "tables" ["types"]
            result.should_contain "'TABLE'"
            result.should_contain "'VIEW'"

    suite_builder.group "Widgets for In-Database Connection with table name sets" group_builder->
        group_builder.specify "works for `query` and `read`" <|
            table_choices = ['a_table', 'another', 'mock_table'] . map n-> Choice.Option n n.pretty
            choices = table_choices + [Option '<Table_Name>' '..Table_Name ""', Option '<Raw_SQL>' '..Raw_SQL ""']
            expect = answer "query" (Widget.Single_Choice choices)
            Widget_Query.resolve_call connection sqlite_module sqlite_type "query" ["query"] . should_equal expect
            Widget_Query.resolve_call connection sqlite_module sqlite_type "read" ["query"] . should_equal expect

    suite_builder.group "Widgets for In-Database Table with column name sets" group_builder->
        mock_table = connection.query "mock_table"

        columns_json = ',"columns":{"":' + (Widget_Columns.from mock_table . to_json) + '}'

        group_builder.specify "works for `get` and `at`" <|
            expect = answer "selector" Widget.Column_Name columns_json
            Widget_Query.resolve_call mock_table table_module table_type "get" ["selector"] . should_equal expect
            Widget_Query.resolve_call mock_table table_module table_type "at" ["selector"] . should_equal expect

        group_builder.specify "works for `filter`" <|
            expect = answer "column" (Widget.Column_Name expression=True) columns_json
            Widget_Query.resolve_call mock_table table_module table_type "filter" ["column"] . should_equal expect

    suite_builder.group "Widgets for Database" group_builder->
        group_builder.specify "works for `connect`, listing every installed backend" <|
            result = Widget_Query.resolve_call Nothing "Standard.Database.Connection.Database" "Standard.Database.Connection.Database" "connect" ["details"] subject_is_type=True
            result.should_contain "SQLite"
            result.should_contain "Postgres"
            # No file of this project imports these libraries: discovery finds them.
            result.should_contain "Redshift"
            result.should_contain "DuckDB"
            result.should_contain "Snowflake"
            result.should_contain "Microsoft SQL Server"

    suite_builder.group "Type defaults by conversion" group_builder->
        group_builder.specify "Connection_Options" <| check_default Connection_Options
        group_builder.specify "Credentials" <| check_default Credentials

    suite_builder.group "Widget_Columns.from a database table" group_builder->
        group_builder.specify "reads the known schema and makes no query" <|
            connection = Database.connect (SQLite.In_Memory)
            t = (Table.new [["a", [1, 2]], ["b", ["x", "y"]]]).select_into_database_table connection "wc" temporary=True
            computed = t.set (expr "[a] + 1") as="c"
            log = File.create_temporary_file "widget_columns_sql" ".log"
            columns = Test_Environment.unsafe_with_environment_override "ENSO_SQL_LOG_PATH" log.path <|
                Widget_Columns.from computed
            columns.names . should_equal ["a", "b", "c"]
            columns.kinds.take 2 . should_equal [Column_Kind.Numeric, Column_Kind.Textual]
            (log.exists.not || log.read . is_empty) . should_be_true

        group_builder.specify "SQL_Type_Reference.known never queries for a type not yet fetched" <|
            connection = Database.connect (SQLite.In_Memory)
            reference = SQL_Type_Reference.new connection (SQL_IR_Source.for_table "wc_known" "") (SQL_IR_Expression.Literal "1")
            reference.should_be_a SQL_Type_Reference.Computed_By_Database
            log = File.create_temporary_file "widget_known_sql" ".log"
            known = Test_Environment.unsafe_with_environment_override "ENSO_SQL_LOG_PATH" log.path <|
                reference.known
            known.should_equal Nothing
            (log.exists.not || log.read . is_empty) . should_be_true
            SQL_Type_Reference.Null.known . should_equal Nothing

main filter=Nothing =
    suite = Test.build suite_builder->
        add_specs suite_builder
    suite.run_with_filter filter

