from Standard.Base import all
import Standard.Base.Enso_Cloud.Data_Link_Helpers
import Standard.Base.Enso_Cloud.Enso_Secret.Derived_Secret_Value
import Standard.Base.Enso_Cloud.Enso_Secret.Enso_Secret_Error
import Standard.Base.Errors.File_Error.File_Error
import Standard.Base.Errors.Illegal_Argument.Illegal_Argument
import Standard.Base.Errors.Illegal_State.Illegal_State

from Standard.Test import all
import Standard.Test.Test_Environment

from project.Network.Local_Secrets_Setup import fixture_key, with_local_secrets

polyglot java import org.enso.base.enso_cloud.EnsoSecretAccessDenied
polyglot java import org.enso.base.enso_cloud.ExternalLibrarySecretHelper

httpbin_pending =
    if Environment.get "ENSO_HTTP_TEST_HTTPBIN_URL" . is_nothing then "Needs ENSO_HTTP_TEST_HTTPBIN_URL" else Nothing

httpbin_uri -> URI =
    base_url = Environment.get "ENSO_HTTP_TEST_HTTPBIN_URL"
    if base_url.is_nothing then
        Panic.throw (Illegal_State.Error "ENSO_HTTP_TEST_HTTPBIN_URL environment variable is not defined.")
    with_slash = if base_url.ends_with "/" then base_url else base_url + "/"
    URI.from with_slash

add_specs suite_builder =
    suite_builder.group "Local secrets" group_builder->
        group_builder.specify "create, get, list, update and delete" <| with_local_secrets <|
            s = Enso_Secret.create "api-token" "abc"
            s.name . should_equal "api-token"
            s.path . should_equal "secret://api-token"
            Enso_Secret.get "api-token" . should_equal s
            Enso_Secret.get "secret://api-token" . should_equal s
            Enso_Secret.list . map .name . should_equal ["api-token"]
            Enso_Secret.exists "api-token" . should_be_true
            Enso_Secret.exists "secret://api-token" . should_be_true
            Enso_Secret.exists "secret://nope" . should_be_false
            s.update_value "def" . should_succeed
            s.delete . should_succeed
            Enso_Secret.exists "api-token" . should_be_false

        group_builder.specify "a missing secret is Not_Found" <| with_local_secrets <|
            Enso_Secret.get "nope" . should_fail_with Enso_Secret_Error
            Enso_Secret.get "secret://nope" . catch . to_display_text . should_equal "Cannot find secret: secret://nope"
            s = Enso_Secret.create "gone" "v"
            s.delete . should_succeed
            s.update_value "w" . catch . to_display_text . should_equal "Cannot find secret: secret://gone"
            s.delete . catch . should_equal (Enso_Secret_Error.Not_Found "secret://gone")

        group_builder.specify "a secret:// path cannot be combined with a cloud parent" <| with_local_secrets <|
            Enso_Secret.create "p" "v" . should_succeed
            Enso_Secret.get "secret://p" parent=Enso_File.root . should_fail_with Illegal_Argument

        group_builder.specify "an unreadable store is a File_Error, not a Java panic" <|
            dir = File.create_temporary_file "local-secrets" ".dir"
            dir.delete
            dir.create_directory
            Panic.with_finalizer (dir.delete recursive=True) <|
                ## The secrets "file" is a directory.
                Test_Environment.unsafe_with_environment_override "ENSO_SECRETS_FILE" dir.absolute.path <|
                    Test_Environment.unsafe_with_environment_override "ENSO_SECRETS_KEY" fixture_key <|
                        Enso_Secret.list . should_fail_with File_Error
                        Enso_Secret.create "x" "v" . should_fail_with File_Error

        group_builder.specify "a duplicate name is rejected" <| with_local_secrets <|
            Enso_Secret.create "dup" "1" . should_succeed
            Enso_Secret.create "dup" "2" . should_fail_with Illegal_Argument

        group_builder.specify "names follow the existing rules" <| with_local_secrets <|
            Enso_Secret.create "" "x" . should_fail_with Illegal_Argument
            Enso_Secret.create "a/b" "x" . should_fail_with Illegal_Argument
            Enso_Secret.create "connection-x" "x" . should_fail_with Illegal_Argument
            Enso_Secret.create "secret://x" "x" . should_fail_with Illegal_Argument
            Enso_Secret.create ("a" * 201) "x" . should_fail_with Illegal_Argument
            Enso_Secret.create ("a" * 200) "x" . should_succeed

        group_builder.specify "without a key, values are locked but names list" <|
            with_local_secrets (Enso_Secret.create "k" "v" . should_succeed)
            # A second environment with no key over the same kind of file:
            with_local_secrets key=Nothing <|
                r = Enso_Secret.create "k2" "v"
                r.should_fail_with Enso_Secret_Error
                r.catch . should_equal Enso_Secret_Error.Locked
                r.catch.to_display_text . should_equal "Local secrets are locked: set ENSO_SECRETS_KEY or use Enso on the desktop where they were created."
            # The same store, once it holds a secret and the key goes away:
            with_local_secrets <|
                Enso_Secret.create "k" "v" . should_succeed
                Test_Environment.unsafe_with_environment_override "ENSO_SECRETS_KEY" Nothing <|
                    Enso_Secret.list . map .name . should_equal ["k"]
                    Enso_Secret.get "k" . name . should_equal "k"
                    Enso_Secret.create "k2" "v" . catch . should_equal Enso_Secret_Error.Locked

        group_builder.specify "a store written with another key is Wrong_Key" <| with_local_secrets <|
            Enso_Secret.create "w" "v" . should_succeed
            Test_Environment.unsafe_with_environment_override "ENSO_SECRETS_KEY" "AQECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8" <|
                r = Enso_Secret.create "w2" "v"
                r.should_fail_with Enso_Secret_Error
                r.catch . should_equal Enso_Secret_Error.Wrong_Key
                r.catch.to_display_text . should_equal "The local secrets file was created with a different key."

        group_builder.specify "values never reach Enso" <| with_local_secrets <|
            s = Enso_Secret.create "hidden" "s3cr3t-xyz"
            v = Derived_Secret_Value.from s
            v.to_plain_text . should_fail_with Enso_Secret_Error
            s.to_text . should_not_contain "s3cr3t-xyz"
            s.to_display_text . should_not_contain "s3cr3t-xyz"
            s.to_js_object.to_text . should_not_contain "s3cr3t-xyz"
            Test.expect_panic EnsoSecretAccessDenied <|
                ExternalLibrarySecretHelper.resolveValue v

        group_builder.specify "serialises as a secret:// path" <| with_local_secrets <|
            s = Enso_Secret.create "ser" "v"
            s.to_js_object.to_text . should_contain '"path":"secret://ser"'
            s.pretty . should_equal "Enso_Secret.get 'secret://ser'"

        group_builder.specify "a datalink secretPath of secret:// resolves" <| with_local_secrets <|
            Enso_Secret.create "dl" "pw" . should_succeed
            json = JS_Object.from_pairs [["type", "secret"], ["secretPath", "secret://dl"]]
            Data_Link_Helpers.parse_secure_value json . should_equal (Enso_Secret.get "dl")

        group_builder.specify "a local datalink's password is saved as a local secret" <| with_local_secrets <|
            location = File.new "some-dir" / "my-db.datalink"
            s1 = Data_Link_Helpers.save_password_for_data_link location "pw"
            s1.path . should_equal "secret://my-db-password"
            s2 = Data_Link_Helpers.save_password_for_data_link location "pw"
            s2.path . should_equal "secret://my-db-password-1"
            Data_Link_Helpers.save_password_for_data_link location s1 . should_equal s1
            Data_Link_Helpers.secure_value_to_json s1 . to_text . should_contain '"secretPath":"secret://my-db-password"'

        ## That they do work over HTTPS is checked in Cloud_Tests
           (`Network/Enso_Cloud/Secrets_Spec.enso`). The HTTPS client has to
           trust the test server's self-signed certificate, and Base_Tests ships
           its own Java helpers, so under the native launcher its
           `polyglot java import`s resolve in a separate JVM whose SSLContext
           the native HTTP client cannot take.
        group_builder.specify "cannot be used in HTTP request headers" pending=httpbin_pending <| with_local_secrets <|
            secret = Enso_Secret.create "header-secret" "Yet another Mystery"
            secret.should_succeed

            r = (httpbin_uri / "get").fetch headers=[Header.new "X-My-Secret" secret]
            r.should_fail_with Illegal_Argument
            r.catch.to_display_text . should_contain "Secrets are not allowed in HTTP connections, use HTTPS instead."

main filter=Nothing =
    suite = Test.build suite_builder->
        add_specs suite_builder
    suite.run_with_filter filter
