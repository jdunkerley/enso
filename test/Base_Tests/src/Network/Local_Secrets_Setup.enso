from Standard.Base import all

import Standard.Test.Test_Environment

## A fixed 32-byte key (base64url) for test stores; never a real one.
fixture_key = "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8"

## Runs `action` against a fresh, temporary local secrets store unlocked with
   `key` (or locked, when `key` is `Nothing`), so that tests never touch the
   user's own `~/.enso/secrets.json`. The store is deleted afterwards.

   `ENSO_SECRETS_KEYCHAIN=off` keeps the OS keychain out of it, in every case:
   otherwise a missing `ENSO_SECRETS_KEY` would fall back to the key the
   desktop app keeps there, so a "locked" test would find a key, and the test
   store would be encrypted with the developer's real key.
with_local_secrets ~action key=fixture_key =
    dir = File.create_temporary_file "local-secrets" ".dir"
    dir.delete
    dir.create_directory
    file = dir / "secrets.json"
    Panic.with_finalizer (dir.delete recursive=True) <|
        Test_Environment.unsafe_with_environment_override "ENSO_SECRETS_KEYCHAIN" "off" <|
            Test_Environment.unsafe_with_environment_override "ENSO_SECRETS_FILE" file.absolute.path <|
                Test_Environment.unsafe_with_environment_override "ENSO_SECRETS_KEY" key <|
                    action
