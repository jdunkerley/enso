from Standard.Base import all
import Standard.Base.Data.Read.Return_As.Return_As
import Standard.Base.Errors.Common.No_Such_Conversion
import Standard.Base.Metadata.Widget
import Standard.Base.Metadata.Widget_Query
import Standard.Base.Network.Email.Email_Address.Email_Address
import Standard.Base.Network.Email.Email_Attachment.Email_Attachment
import Standard.Base.Network.Email.Email_Provider.Email_Provider
import Standard.Base.System.File.Generic.Writable_File.Writable_File

from Standard.Test import all

## Checks that the type has a `Widget.from` conversion and that `resolve_type`
   answers exactly that widget.
check_default typ =
    widget = Widget.from typ
    widget.should_be_a Widget
    type_name = Meta.meta typ . qualified_name
    Widget_Query.resolve_type type_name . should_equal ('{"widget":' + widget.to_json + '}')

add_specs suite_builder =
    suite_builder.group "Type defaults by conversion" group_builder->
        group_builder.specify "Locale" <| check_default Locale
        group_builder.specify "Return_As" <| check_default Return_As
        group_builder.specify "Case" <| check_default Case
        group_builder.specify "Encoding" <| check_default Encoding
        group_builder.specify "Text_Sub_Range" <| check_default Text_Sub_Range
        group_builder.specify "Duration" <| check_default Duration
        group_builder.specify "Time_Zone" <| check_default Time_Zone
        group_builder.specify "Email_Address" <| check_default Email_Address
        group_builder.specify "Email_Attachment" <| check_default Email_Attachment
        group_builder.specify "Email_Provider" <| check_default Email_Provider
        group_builder.specify "Header" <| check_default Header
        group_builder.specify "File_Format" <| check_default File_Format
        group_builder.specify "Filter_Condition" <| check_default Filter_Condition
        group_builder.specify "Index_Sub_Range" <| check_default Index_Sub_Range
        group_builder.specify "Filter_Condition takes its options as extra arguments" <|
            all = Widget.from Filter_Condition
            fewer = Widget.from Filter_Condition include_text=False include_boolean=False
            (fewer.values.length < all.values.length) . should_be_true
        group_builder.specify "Index_Sub_Range takes count" <|
            (Widget.from Index_Sub_Range count=10).to_json . should_not_equal (Widget.from Index_Sub_Range).to_json
        group_builder.specify "a type with no default has no conversion (a bare Vector stays with the GUI)" <|
            Panic.recover Any (Widget.from Vector) . should_fail_with No_Such_Conversion

    suite_builder.group "Regex type default" group_builder->
        group_builder.specify "Regex" <| (Widget.from Regex).to_json . should_equal '{"constructor":"Regex_Input"}'
        group_builder.specify "through resolve_type" <|
            Widget_Query.resolve_type "Standard.Base.Data.Text.Regex.Regex" . should_equal '{"widget":{"constructor":"Regex_Input"}}'
        group_builder.specify "Text still answers Text_Input" <|
            (Widget.from Text).to_json . should_equal '{"constructor":"Text_Input"}'

    suite_builder.group "Group D type defaults" group_builder->
        group_builder.specify "Boolean" <| (Widget.from Boolean).to_json . should_equal '{"constructor":"Boolean_Input"}'
        group_builder.specify "Integer, Float and Number" <|
            [Integer, Float, Number].each t-> (Widget.from t).to_json . should_equal '{"constructor":"Numeric_Input"}'
        group_builder.specify "Text" <| (Widget.from Text).to_json . should_equal '{"constructor":"Text_Input"}'
        group_builder.specify "Date" <| (Widget.from Date).to_json . should_equal '{"constructor":"Date_Input"}'
        group_builder.specify "Date_Time" <| (Widget.from Date_Time).to_json . should_equal '{"constructor":"Date_Time_Input"}'
        group_builder.specify "Time_Of_Day" <| (Widget.from Time_Of_Day).to_json . should_equal '{"constructor":"Time_Input"}'
        group_builder.specify "File" <|
            json = (Widget.from File).to_json . parse_json
            json.get "constructor" . should_equal "File_Browse"
            json.get "existing_only" . should_be_true
            json.get "action" . should_equal "Open"
        group_builder.specify "Writable_File" <|
            json = (Widget.from Writable_File).to_json . parse_json
            json.get "existing_only" . should_be_false
            json.get "action" . should_equal "Save"
        group_builder.specify "Enso_Secret" <| (Widget.from Enso_Secret).to_json . should_equal '{"constructor":"Secret_Browse"}'
        group_builder.specify "through resolve_type" <|
            Widget_Query.resolve_type "Standard.Base.Data.Time.Date.Date" . should_equal '{"widget":{"constructor":"Date_Input"}}'

main filter=Nothing =
    suite = Test.build suite_builder-> add_specs suite_builder
    suite.run_with_filter filter
