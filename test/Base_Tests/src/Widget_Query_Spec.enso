from Standard.Base import all
import Standard.Base.Errors.Common.Module_Does_Not_Exist
import Standard.Base.Errors.Common.No_Such_Method
import Standard.Base.Errors.Illegal_Argument.Illegal_Argument
import Standard.Base.Errors.Illegal_State.Illegal_State
import Standard.Base.Metadata.Choice
import Standard.Base.Metadata.Column_Kind.Column_Kind
import Standard.Base.Metadata.Widget
import Standard.Base.Metadata.Widget_Columns.Widget_Columns
import Standard.Base.Metadata.Widget_Query
from Standard.Base.Metadata.Widget_Query import Argument_Result, Widget_Failure, Widget_Method

from Standard.Test import all

polyglot java import org.enso.base.LogOnce

## This module as the IDE names it.
spec_module = "enso_dev.Base_Tests.Widget_Query_Spec"

add_three a b c = a + b + c

add_defaults a b=10 c=100 = a + b + c

is_error_value value = value.is_error


sample_type = spec_module + ".Sample"

type Sample
    @label (Widget.Text_Input)
    Value label

    @arg (Widget.Boolean_Input)
    probe self (arg = 0) = arg

    @arg (Widget.Numeric_Input)
    make (arg = 0) = Sample.Value arg

    @arg _choice_of_label
    of_self self (arg = 0) = arg

    @arg Bad_Resolvers.choice_of_cache
    of_cache self (arg = 0) (other = 0) = arg + other

    @arg (Error.throw (Illegal_Argument.Error "no choices" (Illegal_State.Error "the cause")))
    fails_with_error self (arg = 0) = arg

    @arg _panics
    fails_with_panic self (arg = 0) = arg

    @arg ("not a widget")
    not_a_widget self (arg = 0) = arg

    plain self (arg = 0) = arg

    @arg _choice_of_other
    of_other self (arg = 0) (other = 0) = arg + other

    @arg _choice_of_search
    searching self (arg = 0) = arg

    @arg Bad_Resolvers.misspelt
    misspelt self (arg = 0) (other = 0) = arg + other

    @arg (Widget.Resolver _choice_of_other)
    wrapped self (arg = 0) (other = 0) = arg + other

    @arg _not_a_widget
    resolver_not_a_widget self (arg = 0) = arg

    @first (Widget.Boolean_Input)
    @second (Error.throw (Illegal_Argument.Error "second fails"))
    two self (first = 0) (second = 0) = first + second

## Defined on `Any`: a `Sample` value has its own `probe`.
@arg (Widget.Folder_Browse)
Any.probe self (arg = 0) = arg

type Fake_Table
    Value names:(Vector Text)

    @column (Widget.Column_Name)
    @other (Widget.Column_Name from="other")
    pick self column other = [column, other]

    @column Widget.Text_Input
    plain self column = column

type Panicky_Table
    Value

Widget_Columns.from (that : Fake_Table) = Widget_Columns.Value that.names (that.names.map _-> Column_Kind.Other) (that.names.map _-> "")

Widget_Columns.from (that : Panicky_Table) =
    _ = that
    Panic.throw (Illegal_State.Error "conversion boom")

type Has_Default
    Value

Widget.from (that : Has_Default.type) (with_extra : Boolean = False) -> Widget =
    _ = that
    Widget.Single_Choice values=(if with_extra then [Choice.Option "A" "a", Choice.Option "B" "b"] else [Choice.Option "A" "a"])

type No_Default
    Value

type Broken_Default
    Value

type Nested_Missing
    Value

type Lacks_Conversion
    Value

Widget.from (that : Nested_Missing.type) -> Widget =
    _ = that
    Widget.from Lacks_Conversion

Widget.from (that : Broken_Default.type) -> Widget =
    _ = that
    Error.throw (Illegal_State.Error "broken on purpose")

## An extension method of a type defined elsewhere.
@range (Widget.Secret_Browse)
Text.widget_probe self (range = 0) = range

@arg (Widget.Text_Input)
module_probe (arg = 0) = arg

private _choice_of_label subject -> Widget =
    Widget.Single_Choice [Choice.Option subject.label]

## Resolvers that break the rule on purpose, to test the run-time check. A
   type's methods, which the compiler's lint (`ResolverSignatureCheck`, which
   reads module methods) does not see.
type Bad_Resolvers
    ## The old form, reading other arguments through `cache`.
    choice_of_cache _ cache=Nothing -> Widget =
        Widget.Single_Choice [Choice.Option (cache "other" . to_text)]

    ## A dependency that is not an argument.
    misspelt subject (othr = Nothing) -> Widget =
        _ = [subject, othr]
        Widget.Text_Input

private _choice_of_other subject (other = Nothing) -> Widget =
    _ = subject
    Widget.Single_Choice [Choice.Option other.to_text]

private _choice_of_search subject (search : Text = "") -> Widget =
    _ = subject
    Widget.Single_Choice [Choice.Option ("found " + search)]

private _not_a_widget subject = subject

## A type whose default widget needs the subject and another argument.
type Needs_Subject
    Value

private _needs_subject_widget table (right = Nothing) -> Widget =
    _ = [table, right]
    Widget.Text_Input

Widget.from (that : Needs_Subject.type) -> Widget =
    _ = that
    Widget.Resolver _needs_subject_widget

private _panics subject = Panic.throw (Illegal_State.Error "boom for "+subject.label)

## The answer for one argument whose widget is `widget`.
answer argument widget = '{"arguments":[[' + argument.to_json + ',{"widget":' + widget.to_json + '}]]}'

## A dataflow error standing for the user's own error as a query's subject.
the_user_error = Error.throw (Illegal_State.Error "the user's own error")

## The error part of the answer for the one argument asked for.
error_of answer_json = answer_json.parse_json . get "arguments" . first . second . get "error"

add_specs suite_builder =
    suite_builder.group "Meta.call_module_method" group_builder->
        group_builder.specify "applies a module's method to the value, then to the arguments" <|
            Meta.call_module_method spec_module "add_three" [2, 3] 1 . should_equal 6

        group_builder.specify "fills the defaults of the parameters no argument is given for, as a written call does" <|
            Meta.call_module_method spec_module "add_defaults" [2, 3] 1 . should_equal 6
            Meta.call_module_method spec_module "add_defaults" [2] 1 . should_equal 103
            Meta.call_module_method spec_module "add_defaults" [] 1 . should_equal 111
            Meta.call_module_method spec_module "add_defaults" [2, 3] 1 . should_equal (add_defaults 1 2 3)

        group_builder.specify "passes an error value to the method, as a written call does" <|
            Meta.call_module_method spec_module "is_error_value" [] (Error.throw "e") . should_equal True

        group_builder.specify "passes the warnings of the value through, as a written call does" <|
            result = Meta.call_module_method spec_module "add_defaults" [2] (Warning.attach "w" 1)
            result.should_equal 103
            Warning.get_all result . map .value . should_equal ["w"]

        group_builder.specify "fails for a module that is not loaded, or a method it lacks" <|
            Meta.call_module_method "enso_dev.Base_Tests.No_Such_Module" "f" [] 1 . should_fail_with Module_Does_Not_Exist
            Meta.call_module_method spec_module "no_such_method" [] 1 . should_fail_with No_Such_Method

    suite_builder.group "Meta.get_method_argument_names" group_builder->
        group_builder.specify "lists a method's parameters, self excluded" <|
            Meta.get_method_argument_names spec_module sample_type "two" . should_equal ["first", "second"]
            Meta.get_method_argument_names spec_module spec_module "add_defaults" . should_equal ["a", "b", "c"]
            Meta.get_method_argument_names spec_module sample_type "nope" . should_fail_with No_Such_Method

    suite_builder.group "Widget_Query.resolve_call finds exactly the method a call names" group_builder->
        sample = Sample.Value "a label"

        group_builder.specify "an instance method" <|
            Widget_Query.resolve_call sample spec_module sample_type "probe" ["arg"] . should_equal (answer "arg" Widget.Boolean_Input)

        group_builder.specify "a method of Any, although the value's own type defines one of that name" <|
            Meta.get_annotation sample .probe "arg" . should_equal Widget.Boolean_Input
            Widget_Query.resolve_call sample spec_module "Standard.Base.Any.Any" "probe" ["arg"] . should_equal (answer "arg" Widget.Folder_Browse)

        group_builder.specify "a static method, called on the type" <|
            Widget_Query.resolve_call Sample spec_module sample_type "make" ["arg"] . should_equal (answer "arg" Widget.Numeric_Input)

        group_builder.specify "a constructor, with the type as the subject (an autoscoped call)" <|
            Widget_Query.resolve_call Nothing spec_module sample_type "Value" ["label"] subject_is_type=True . should_equal (answer "label" Widget.Text_Input)

        group_builder.specify "an extension method defined in another module than its type" <|
            Widget_Query.resolve_call "abc" spec_module "Standard.Base.Data.Text.Text" "widget_probe" ["range"] . should_equal (answer "range" Widget.Secret_Browse)

        group_builder.specify "a module method" <|
            Widget_Query.resolve_call Nothing spec_module spec_module "module_probe" ["arg"] subject_is_type=True . should_equal (answer "arg" Widget.Text_Input)

    suite_builder.group "Widget_Query.resolve_call with an error as the subject" group_builder->
        sample = Sample.Value "a label"
        user_error = the_user_error
        fails_with_error = Widget_Method.Value spec_module sample_type "fails_with_error"
        # The inputs a failure is logged under for `subject`, as `resolve_call`
        # builds them (with no search).
        inputs_of subject uuids = ((Meta.type_of subject . to_text) . catch Any (_-> "<error>")) + "|" + uuids + "|"

        group_builder.specify "answers no widget for every argument, runs no annotation and logs nothing" <|
            uuids = '{"run":"' + Random.uuid + '"}'
            failure = (Widget_Query.resolve_argument fails_with_error "arg" sample (_-> Nothing)).failure
            # A plain subject's failure is logged, under the inputs this test builds.
            _ = Widget_Query.resolve_call sample spec_module sample_type "fails_with_error" ["arg"] uuids
            Widget_Query.log_failure failure (inputs_of sample uuids) . should_be_false
            # The user's error answers no widget, and nothing was logged for it.
            json = Widget_Query.resolve_call user_error spec_module sample_type "fails_with_error" ["arg", "other"] uuids
            json . should_equal '{"arguments":[["arg",{"widget":null}],["other",{"widget":null}]]}'
            Widget_Query.log_failure failure (inputs_of user_error uuids) . should_be_true

        group_builder.specify "with subject_is_type, an error value still answers: the type is the subject" <|
            Widget_Query.resolve_call user_error spec_module sample_type "probe" ["arg"] subject_is_type=True . should_equal (answer "arg" Widget.Boolean_Input)
            Widget_Query.resolve_call user_error spec_module spec_module "module_probe" ["arg"] subject_is_type=True . should_equal (answer "arg" Widget.Text_Input)
            error = error_of (Widget_Query.resolve_call user_error spec_module sample_type "fails_with_error" ["arg"] subject_is_type=True)
            error.get "step" . should_equal "annotation"

    suite_builder.group "Widget_Query.resolve_call evaluates annotations as before" group_builder->
        sample = Sample.Value "a label"

        group_builder.specify "a function of self, announced as a resolver of the subject" <|
            expected = '{"arguments":[["arg",{"widget":' + (Widget.Single_Choice [Choice.Option "a label"]).to_json + ',"resolver":{"dependencies":["self"],"searchable":false}}]]}'
            Widget_Query.resolve_call sample spec_module sample_type "of_self" ["arg"] . should_equal expected

        group_builder.specify "a function taking `cache` breaks the resolver rule" <|
            error = error_of (Widget_Query.resolve_call sample spec_module sample_type "of_cache" ["arg"] "{}")
            error.get "step" . should_equal "resolver"
            error.get "message" . should_contain "`cache`"

        group_builder.specify "no annotation gives a null widget" <|
            Widget_Query.resolve_call sample spec_module sample_type "plain" ["arg"] . should_equal '{"arguments":[["arg",{"widget":null}]]}'

        group_builder.specify "each argument independently, in the order asked" <|
            json = Widget_Query.resolve_call sample spec_module sample_type "two" ["second", "first"]
            arguments = json.parse_json . get "arguments"
            arguments.map .first . should_equal ["second", "first"]
            arguments.first.second.get "error" . get "message" . should_contain "second fails"
            arguments.second.second.get "widget" . get "constructor" . should_equal "Boolean_Input"

    suite_builder.group "Widget_Query.resolve_call runs resolvers" group_builder->
        sample = Sample.Value "a label"
        method name = Widget_Method.Value spec_module sample_type name
        resolver_json deps searchable = ',"resolver":{"dependencies":' + deps.to_json + ',"searchable":' + searchable.to_json + '}'

        group_builder.specify "a dependency's value reaches the resolver, and is announced" <|
            values = Widget_Query.values_from_lookup (name-> if name == "other" then 42 else Nothing)
            result = Widget_Query.resolve_argument (method "of_other") "arg" sample values "" ["arg", "other"] Nothing
            result.to_json . should_equal ('{"widget":' + (Widget.Single_Choice [Choice.Option "42"]).to_json + (resolver_json ["self", "other"] False) + '}')

        group_builder.specify "an unset dependency is Nothing" <|
            json = Widget_Query.resolve_call sample spec_module sample_type "of_other" ["arg"] . parse_json
            json.get "arguments" . first . second . get "widget" . get "values" . first . get "label" . should_equal "Nothing"

        group_builder.specify "a Widget.Resolver annotation runs the same way" <|
            values = Widget_Query.values_from_lookup (name-> if name == "other" then 7 else Nothing)
            result = Widget_Query.resolve_argument (method "wrapped") "arg" sample values "" ["arg", "other"] Nothing
            result.to_json . should_contain '"label":"7"'
            result.to_json . should_contain (resolver_json ["self", "other"] False)

        group_builder.specify "search reaches a searchable resolver" <|
            json = Widget_Query.resolve_call sample spec_module sample_type "searching" ["arg"] "{}" False "abc" . parse_json
            result = json.get "arguments" . first . second
            result.get "widget" . get "values" . first . get "label" . should_equal "found abc"
            result.get "resolver" . get "searchable" . should_be_true
            result.get "resolver" . get "dependencies" . should_equal ["self"]

        group_builder.specify "a dependency that is an error skips the resolver" <|
            values = Widget_Query.values_from_lookup (_-> Error.throw (Illegal_Argument.Error "bad right"))
            result = Widget_Query.resolve_argument (method "of_other") "arg" sample values "" ["arg", "other"] Nothing
            json = result.to_json . parse_json
            json.get "widget" . should_equal Nothing
            json.get "unavailable" . get "dependency" . should_equal "other"
            json.get "unavailable" . get "message" . should_contain "bad right"
            json.get "resolver" . get "dependencies" . should_equal ["self", "other"]

        group_builder.specify "a parameter that is no argument is the widget's error" <|
            json = Widget_Query.resolve_call sample spec_module sample_type "misspelt" ["arg"] . parse_json
            error = json.get "arguments" . first . second . get "error"
            error.get "step" . should_equal "resolver"
            error.get "message" . should_contain "`othr`"

        group_builder.specify "a resolver that gives no Widget fails at the resolver step, with its signature" <|
            json = Widget_Query.resolve_call sample spec_module sample_type "resolver_not_a_widget" ["arg"] . parse_json
            result = json.get "arguments" . first . second
            result.get "error" . get "step" . should_equal "resolver"
            result.get "resolver" . get "dependencies" . should_equal ["self"]

        group_builder.specify "column pickers announce their sources" <|
            json = Widget_Query.resolve_call (Fake_Table.Value ["A"]) spec_module (spec_module + ".Fake_Table") "pick" ["column", "other"] . parse_json
            json.get "arguments" . first . second . get "resolver" . get "dependencies" . should_equal ["self"]
            json.get "arguments" . second . second . get "resolver" . get "dependencies" . should_equal ["other"]

        group_builder.specify "search and revision are echoed, only when set" <|
            json = Widget_Query.resolve_call sample spec_module sample_type "searching" ["arg"] "{}" False "abc" "{}" "7" . parse_json
            json.get "search" . should_equal "abc"
            json.get "revision" . should_equal "7"
            Widget_Query.resolve_call sample spec_module sample_type "probe" ["arg"] . should_not_contain '"revision"'
            Widget_Query.resolve_call sample spec_module sample_type "probe" ["arg"] . should_not_contain '"search"'

        group_builder.specify "an error subject echoes too" <|
            json = Widget_Query.resolve_call (Error.throw "e") spec_module sample_type "probe" ["arg"] "{}" False "" "{}" "3"
            json . should_equal '{"arguments":[["arg",{"widget":null}]],"revision":"3"}'

        group_builder.specify "a static widget has no resolver field" <|
            Widget_Query.resolve_call sample spec_module sample_type "probe" ["arg"] . should_equal '{"arguments":[["arg",{"widget":{"constructor":"Boolean_Input"}}]]}'

        group_builder.specify "type_defaults resolves an unannotated argument through its type's resolver" <|
            json = Widget_Query.resolve_call sample spec_module sample_type "plain" ["arg"] "{}" False "" ('{"arg":"' + spec_module + '.Needs_Subject"}') . parse_json
            result = json.get "arguments" . first . second
            result.get "resolver" . get "dependencies" . should_equal ["self", "right"]
            result.get "widget" . get "constructor" . should_equal "Text_Input"

        group_builder.specify "type_defaults gives a static default as resolve_type would" <|
            json = Widget_Query.resolve_call sample spec_module sample_type "plain" ["arg"] "{}" False "" ('{"arg":"' + spec_module + '.Has_Default"}')
            json . should_equal (answer "arg" (Widget.from Has_Default))

        group_builder.specify "a run over the threshold is logged, and still answers" <|
            values = Widget_Query.values_from_lookup (_-> Nothing)
            result = Widget_Query.run_resolver (method "of_other") "arg" _choice_of_other sample values "" ["arg", "other"] slow_ms=-1
            result.to_json . should_contain '"Single_Choice"'
            Widget_Query.slow_message (method "of_other") "arg" 12500 . should_contain "took 12 s."

    suite_builder.group "Widget_Query.resolve_call gives errors as results" group_builder->
        sample = Sample.Value "a label"

        group_builder.specify "an annotation that is an error" <|
            error = error_of (Widget_Query.resolve_call sample spec_module sample_type "fails_with_error" ["arg"])
            error.get "step" . should_equal "annotation"
            error.get "message" . should_contain "no choices"

        group_builder.specify "a resolver that panics" <|
            error = error_of (Widget_Query.resolve_call sample spec_module sample_type "fails_with_panic" ["arg"])
            error.get "step" . should_equal "resolver"
            error.get "message" . should_contain "boom for a label"

        group_builder.specify "an annotation that is not a Widget" <|
            error = error_of (Widget_Query.resolve_call sample spec_module sample_type "not_a_widget" ["arg"])
            error.get "message" . should_contain "not a Widget"

        group_builder.specify "a method that does not exist" <|
            error = error_of (Widget_Query.resolve_call sample spec_module sample_type "missing" ["arg"])
            error.get "step" . should_equal "lookup"

    suite_builder.group "Widget_Query.resolve_call with an error as the subject" group_builder->
        group_builder.specify "gives no widget for every argument, and no error" <|
            subject = Error.throw (Illegal_Argument.Error "x")
            json = Widget_Query.resolve_call subject spec_module sample_type "two" ["second", "first"]
            json.should_equal '{"arguments":[["second",{"widget":null}],["first",{"widget":null}]]}'

        group_builder.specify "does not evaluate a function annotation of the subject" <|
            subject = Error.throw (Illegal_Argument.Error "x")
            json = Widget_Query.resolve_call subject spec_module sample_type "of_self" ["arg"]
            json.should_equal '{"arguments":[["arg",{"widget":null}]]}'

    suite_builder.group "Widget_Query.resolve_call on the standard library's annotations" group_builder->
        group_builder.specify "Data.fetch_many and Data.fetch_pages give a Numeric_Input for time_between_requests" <|
            ["fetch_many", "fetch_pages"].each method->
                json = Widget_Query.resolve_call Nothing "Standard.Base.Data" "Standard.Base.Data" method ["time_between_requests"] subject_is_type=True
                json.should_equal (answer "time_between_requests" Widget.Numeric_Input)

    suite_builder.group "Date.new's and Date_Time.new's day picker reads year and month" group_builder->
        date_module = "Standard.Base.Data.Time.Date"
        day_of module type year month =
            method = Widget_Method.Value module type "new"
            values = Widget_Query.values_from_lookup name-> case name of
                "year" -> year
                "month" -> month
                _ -> Nothing
            json = Widget_Query.resolve_argument method "day" Date values "" (Meta.get_method_argument_names module type "new") Nothing . to_json . parse_json
            json
        maximum json = json.get "widget" . get "maximum"

        group_builder.specify "February of a leap year has 29 days" <|
            json = day_of date_module date_module+".Date" 2024 2
            maximum json . should_equal 29
            json.get "resolver" . get "dependencies" . should_equal ["self", "year", "month"]

        group_builder.specify "February of another year has 28" <|
            maximum (day_of date_module date_module+".Date" 2023 2) . should_equal 28

        group_builder.specify "an unset month allows 31" <|
            maximum (day_of date_module date_module+".Date" Nothing Nothing) . should_equal 31

        group_builder.specify "Date_Time.new shares it" <|
            maximum (day_of "Standard.Base.Data.Time.Date_Time" "Standard.Base.Data.Time.Date_Time.Date_Time" 2023 4) . should_equal 30

    suite_builder.group "Widget_Query failures are logged once, with their causes and stack" group_builder->
        sample = Sample.Value "a label"
        method name = Widget_Method.Value spec_module sample_type name
        no_cache = _-> Nothing

        group_builder.specify "an error's entry has the method, the argument, the step, the message and the cause" <|
            result = Widget_Query.resolve_argument (method "fails_with_error") "arg" sample no_cache
            result.should_be_a Argument_Result.Failed
            text = result.failure.log_text
            text.should_contain "`arg` of enso_dev.Base_Tests.Widget_Query_Spec.Sample.fails_with_error"
            text.should_contain "failed at the annotation: "
            text.should_contain "no choices"
            text.should_contain "caused by: "
            text.should_contain "the cause"

        group_builder.specify "a panic's entry has its stack" <|
            result = Widget_Query.resolve_argument (method "fails_with_panic") "arg" sample no_cache
            result.failure.stack.is_empty . should_be_false
            result.failure.log_text . should_contain '\n    at '

        group_builder.specify "is logged once per method, argument, inputs, step and message" <|
            failure = (Widget_Query.resolve_argument (method "fails_with_error") "arg" sample no_cache).failure
            inputs = "test inputs " + Random.uuid
            Widget_Query.log_failure failure inputs . should_be_true
            Widget_Query.log_failure failure inputs . should_be_false
            Widget_Query.log_failure failure inputs+"2" . should_be_true


    suite_builder.group "Widget_Query.resolve_type" group_builder->
        group_builder.specify "answers a type's default widget" <|
            expected = '{"widget":' + (Widget.from Has_Default).to_json + '}'
            Widget_Query.resolve_type spec_module+".Has_Default" . should_equal expected
        group_builder.specify "answers null for a type without a default" <|
            Widget_Query.resolve_type spec_module+".No_Default" . should_equal '{"widget":null}'
        group_builder.specify "answers a lookup error for an unknown type" <|
            json = Widget_Query.resolve_type spec_module+".Nope" . parse_json
            json.get "error" . get "step" . should_equal "lookup"
        group_builder.specify "a resolver default is announced, not run" <|
            Widget_Query.resolve_type (spec_module + ".Needs_Subject") . should_equal '{"widget":null,"resolver":{"dependencies":["self","right"],"searchable":false}}'
        group_builder.specify "answers a type_default error when the conversion fails" <|
            json = Widget_Query.resolve_type spec_module+".Broken_Default" . parse_json
            json.get "error" . get "step" . should_equal "type_default"
            json.get "error" . get "message" . should_contain "broken on purpose"
        group_builder.specify "answers a type_default error when the conversion itself hits a missing conversion" <|
            json = Widget_Query.resolve_type spec_module+".Nested_Missing" . parse_json
            json.get "error" . get "step" . should_equal "type_default"
        group_builder.specify "a failing type default's log entry names the type" <|
            method = Widget_Method.Value spec_module+".Broken_Default" spec_module+".Broken_Default" "from"
            result = Widget_Query.resolve_type_argument method spec_module+".Broken_Default"
            result.failure.step . should_equal "type_default"
            result.failure.log_text . should_contain "The default widget of "+spec_module+".Broken_Default"
            inputs = "test inputs " + Random.uuid
            Widget_Query.log_failure result.failure inputs . should_be_true
            Widget_Query.log_failure result.failure inputs . should_be_false

    suite_builder.group "Widget_Query.resolve_call sends each column list once" group_builder->
        fake_type = spec_module + ".Fake_Table"

        group_builder.specify "the subject's columns, keyed by the empty source" <|
            json = Widget_Query.resolve_call (Fake_Table.Value ["A", "B"]) spec_module fake_type "pick" ["column"] . parse_json
            json.get "columns" . get "" . get "names" . should_equal ["A", "B"]
            json.get "arguments" . first . second . get "widget" . get "constructor" . should_equal "Column_Name"

        group_builder.specify "another argument's columns, by its name" <|
            mock_cache name = if name == "other" then Fake_Table.Value ["X"] else Nothing
            json = Widget_Query.columns_json [Nothing, "other"] (Fake_Table.Value ["A"]) mock_cache
            json . should_equal ',"columns":{"":{"names":["A"],"kinds":["Other"],"type_names":[""]},"other":{"names":["X"],"kinds":["Other"],"type_names":[""]}}'

        group_builder.specify "a source that is not set is absent" <|
            Widget_Query.columns_json ["other"] (Fake_Table.Value ["A"]) (_-> Nothing) . should_equal ""

        group_builder.specify "no picker, no columns field" <|
            Widget_Query.resolve_call (Fake_Table.Value ["A"]) spec_module fake_type "plain" ["column"] . should_equal '{"arguments":[["column",{"widget":{"constructor":"Text_Input"}}]]}'

        group_builder.specify "a source without a conversion is absent" <|
            Widget_Query.columns_json [Nothing] 42 (_-> Nothing) . should_equal ""

        group_builder.specify "an error source is absent" <|
            Widget_Query.columns_json ["other"] (Fake_Table.Value ["A"]) (_-> Error.throw "e") . should_equal ""

        group_builder.specify "a panicking conversion is logged and the source skipped" <|
            mock_cache name = if name == "other" then Fake_Table.Value ["X"] else Nothing
            inputs = "columns inputs " + Random.uuid
            method = Widget_Method.Value spec_module spec_module+".Fake_Table" "pick"
            Widget_Query.columns_json [Nothing, "other"] Panicky_Table.Value mock_cache method inputs . should_equal ',"columns":{"other":{"names":["X"],"kinds":["Other"],"type_names":[""]}}'
            # The failure was logged: logging it again is refused as a repeat.
            message = (Illegal_State.Error "conversion boom").to_display_text
            failure = Widget_Failure.Value method "columns" "columns" message [] []
            Widget_Query.log_failure failure inputs . should_be_false

    suite_builder.group "LogOnce" group_builder->
        group_builder.specify "is true only the first time it sees a key" <|
            key = "Widget_Query_Spec " + Random.uuid
            LogOnce.firstTime key . should_be_true
            LogOnce.firstTime key . should_be_false
            LogOnce.firstTime key+"x" . should_be_true

main filter=Nothing =
    suite = Test.build suite_builder->
        add_specs suite_builder
    suite.run_with_filter filter
