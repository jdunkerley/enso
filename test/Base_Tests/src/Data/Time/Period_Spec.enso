from Standard.Base import all
import Standard.Base.Errors.Common.Incomparable_Values
import Standard.Base.Errors.Common.Type_Error
import Standard.Base.Errors.Illegal_Argument.Illegal_Argument
import Standard.Base.Errors.Time_Error.Time_Error
import Standard.Base.Runtime.Debug

from Standard.Test import all


add_specs suite_builder =
    suite_builder.group "Period" group_builder->
        group_builder.specify "should create period years" <|
            period = (Period.new years=5)
            period.years . should_equal 5
            period.days . should_equal 0

        group_builder.specify "should add two Periods" <|
            ((Period.new years=1) + (Period.new years=2)).years . should_equal 3
            ((Period.new days=1) + (Period.new months=2)).days . should_equal 1
            ((Period.new days=1) + (Period.new months=2)).months . should_equal 2
            ((Period.new months=2) + (Period.new days=1)).days . should_equal 1
            ((Period.new months=2) + (Period.new days=1)).months . should_equal 2

        group_builder.specify "should subtract two Periods" <|
            ((Period.new years=2) - (Period.new years=1)).years . should_equal 1
            ((Period.new years=1) - (Period.new months=2)).months . should_equal (-2)
            ((Period.new years=1) - (Period.new months=2)).years . should_equal 1

        group_builder.specify "should get Period between two dates" <|
            (Period.between (Date.new year=100) (Date.new year=150)) . should_equal (Period.new years=50)
            (Period.between (Date.new year=150) (Date.new year=100)) . should_equal (Period.new years=(-50))
            (Period.between (Date.new 2022 10 19) (Date.new 2022 11 01)) . should_equal (Period.new days=13)

        group_builder.specify "should not compare between two periods" <|
            ((Period.new days=10) > (Period.new days=1)) . should_fail_with Incomparable_Values
            ((Period.new years=10) > (Period.new days=1)) . should_fail_with Incomparable_Values
            ((Period.new years=10 months=3) > (Period.new months=5)) . should_fail_with Incomparable_Values

        group_builder.specify "two Periods are equal iff their fields are equal" <|
            ((Period.new days=1) == (Period.new days=1)) . should_be_true
            ((Period.new months=12) == (Period.new years=1)) . should_be_false
            ((Period.new months=3) == (Period.new months=3)) . should_be_true
            ((Period.new days=(-5)) == (Period.new days=(-5))) . should_be_true
            ((Period.new years=1 days=10) == (Period.new years=1 days=10)) . should_be_true
            ((Period.new days=1) != (Period.new months=1)) . should_be_true

        group_builder.specify "an equal Period is the only one it can be ordered against" <|
            ((Period.new months=1) > (Period.new months=1)) . should_be_false
            ((Period.new months=1) >= (Period.new months=1)) . should_be_true
            ((Period.new months=1) < (Period.new months=1)) . should_be_false
            ((Period.new months=1) <= (Period.new months=1)) . should_be_true
            ((Period.new days=1) <= (Period.new months=1)) . should_fail_with Incomparable_Values
            ((Period.new days=1) >= (Duration.new hours=1)) . should_fail_with Incomparable_Values

        group_builder.specify "should multiply a Period by an Integer, and negate it" <|
            ((Period.new years=1 months=2 days=3) * 2) . should_equal (Period.new years=2 months=4 days=6)
            ((Period.new years=1 months=2 days=3) * (-1)) . should_equal (Period.new years=(-1) months=(-2) days=(-3))
            (Period.new years=1 months=2 days=3) . negate . should_equal (Period.new years=(-1) months=(-2) days=(-3))
            ((Period.new years=1000000000) * 100) . should_fail_with Time_Error

        group_builder.specify "should keep months and years apart, and give total_months" <|
            period = Period.new years=2 months=14 days=3
            period.years . should_equal 2
            period.months . should_equal 14
            period.total_months . should_equal 38
            period.days . should_equal 3
            Meta.type_of period.years . should_equal_type Integer
            Meta.type_of period.negate . should_equal_type Period

        group_builder.specify "should display a Period, with the sign on every part (#901)" <|
            Period.new . to_display_text . should_equal "0D"
            (Period.new years=2 months=3 days=4) . to_display_text . should_equal "2Y 3M 4D"
            (Period.new months=14) . to_display_text . should_equal "1Y 2M"
            (Period.new years=1 days=5) . to_display_text . should_equal "1Y 0M 5D"
            (Period.new months=3 days=5) . negate . to_display_text . should_equal "-3M -5D"
            (Period.new months=(-1) days=(-9)) . to_display_text . should_equal "-1M -9D"
            (Period.new months=(-15)) . to_display_text . should_equal "-1Y -3M"
            (Period.new years=(-1) days=(-5)) . to_display_text . should_equal "-1Y 0M -5D"
            (Period.new years=1 months=2 days=3) . negate . to_display_text . should_equal "-1Y -2M -3D"
            # A mixed-sign Period is shown by its total months.
            (Period.new years=1 months=(-1)) . to_display_text . should_equal "11M"
            (Period.new years=(-1) months=1) . to_display_text . should_equal "-11M"
            (Period.new months=5 days=(-2)) . to_display_text . should_equal "5M -2D"
            (Period.between (Date.new 2022 11 1) (Date.new 2022 8 1)) . to_display_text . should_equal "-3M"

        group_builder.specify "should not add or subtract anything but a Period" <|
            ((Period.new months=1) + (Duration.new hours=1)) . should_fail_with Time_Error
            ((Period.new months=1) - (Duration.new hours=1)) . should_fail_with Time_Error
            ((Period.new months=1) + 5) . should_fail_with Illegal_Argument
            ((Period.new months=1) - "a") . should_fail_with Illegal_Argument

        group_builder.specify "Period methods reject arguments of the wrong type" <|
            Test.expect_panic_with (Period.new "a") Type_Error
            Test.expect_panic_with (Period.new months=1.5) Type_Error
            Test.expect_panic_with (Period.between 5 (Date.new 2020 1 1)) Type_Error
            Test.expect_panic_with (Period.between (Date.new 2020 1 1) "a") Type_Error
            Test.expect_panic_with ((Period.new months=1) * 1.5) Type_Error
            Test.expect_panic_with ((Period.new months=1) * "a") Type_Error

        group_builder.specify "should render a friendly to display text" <|
            Period.new . to_display_text . should_equal "0D"
            Period.new years=2 . to_display_text . should_equal "2Y"
            Period.new months=24 . to_display_text . should_equal "2Y"
            Period.new months=4 . to_display_text . should_equal "4M"
            Period.new months=18 . to_display_text . should_equal "1Y 6M"
            Period.new years=2 days=3 . to_display_text . should_equal "2Y 0M 3D"
            Period.new days=18 . to_display_text . should_equal "18D"

        group_builder.specify "should render to Enso code" <|
            Period.new . pretty . should_equal "Period.new"
            Period.new years=2 . pretty . should_equal "Period.new 2"
            Period.new months=24 . pretty . should_equal "Period.new months=24"
            Period.new months=4 . pretty . should_equal "Period.new months=4"
            Period.new years=1 months=6 . pretty . should_equal "Period.new 1 6"
            Period.new years=2 days=3 . pretty . should_equal "Period.new 2 days=3"
            Period.new days=18 . pretty . should_equal "Period.new days=18"

            period = Period.new years=2 days=3
            Debug.eval period.pretty . should_equal period

main filter=Nothing =
    suite = Test.build suite_builder->
        add_specs suite_builder
    suite.run_with_filter filter

