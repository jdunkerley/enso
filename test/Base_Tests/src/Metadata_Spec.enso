from Standard.Base import all
import Standard.Base.Metadata.Choice
import Standard.Base.Metadata.Column_Kind.Column_Kind
import Standard.Base.Metadata.Widget

from Standard.Test import all

add_specs suite_builder =
    suite_builder.group "Choice.Option to_json" group_builder->
        group_builder.specify "is unchanged for an option without requires or patterns" <|
            Choice.Option "SQLite" "..SQLite" . to_json . should_equal '{"label":"SQLite","value":"..SQLite","parameters":[],"icon":""}'

        group_builder.specify "emits requires and patterns when both are set" <|
            option = Choice.Option "SQLite" "..SQLite" requires="Standard.SQLite.SQLite_Format.SQLite_Format" patterns=["*.sqlite", "*.db"]
            option.to_json . should_equal '{"label":"SQLite","value":"..SQLite","parameters":[],"icon":"","requires":"Standard.SQLite.SQLite_Format.SQLite_Format","patterns":["*.sqlite","*.db"]}'

        group_builder.specify "emits only the field that is set" <|
            Choice.Option "X" "..X" requires="A.B.C" . to_json . should_equal '{"label":"X","value":"..X","parameters":[],"icon":"","requires":"A.B.C"}'
            Choice.Option "X" "..X" patterns=["*.x"] . to_json . should_equal '{"label":"X","value":"..X","parameters":[],"icon":"","patterns":["*.x"]}'

        group_builder.specify "a grouped option serialises its nested options and their pickers with their own JSON" <|
            picker = Widget.Column_Name kinds=[Column_Kind.Textual]
            inner = Choice.Option "..Regex_Match" "..Regex_Match" [["pattern", picker]]
            json = Choice.Option "Text" [inner] . to_json
            json.should_equal ('{"label":"Text","value":[' + inner.to_json + '],"parameters":[],"icon":""}')
            json.should_contain '"kinds":["Textual"]'
            json.should_contain '"from":null'

    suite_builder.group "Column pickers to_json" group_builder->
        group_builder.specify "Column_Name with its defaults" <|
            Widget.Column_Name . to_json . should_equal '{"constructor":"Column_Name","kinds":[],"from":null,"expression":false,"reference":false,"extra":[],"columns_first":false}'

        group_builder.specify "Column_Name with kinds, a source and extras" <|
            w = Widget.Column_Name kinds=[Column_Kind.Numeric] from="right" reference=True extra=[Choice.Option "<Nothing>" "Nothing"]
            json = w.to_json . parse_json
            json.get "kinds" . should_equal ["Numeric"]
            json.get "from" . should_equal "right"
            json.get "reference" . should_be_true
            json.get "extra" . first . get "value" . should_equal "Nothing"

        group_builder.specify "Column_Names, Column_Vector and Order_By" <|
            Widget.Column_Names regex=True . to_json . should_equal '{"constructor":"Column_Names","kinds":[],"from":null,"regex":true,"by_type":false}'
            Widget.Column_Vector . to_json . should_equal '{"constructor":"Column_Vector","kinds":[],"from":null}'
            Widget.Order_By name_only=True . to_json . should_equal '{"constructor":"Order_By","from":null,"name_only":true}'

        group_builder.specify "column_sources finds pickers at any depth, once each" <|
            nested = Widget.Single_Choice [Choice.Option "Equals" "..Equals" [["left", Widget.Column_Name], ["right", Widget.Column_Name from="right"]]]
            editor = Widget.Vector_Editor item_editor=nested item_default="_"
            editor.column_sources . should_equal [Nothing, "right"]
            (Widget.Vector_Editor item_editor=Widget.Column_Name item_default="_").column_sources . should_equal [Nothing]
            Widget.Text_Input.column_sources . should_equal []

        group_builder.specify "column_sources looks through With_JSON_Cache and Multiple_Choice, and lists a repeated source once" <|
            cached = Widget.With_JSON_Cache (Widget.Column_Names from="right") "{}"
            cached.column_sources . should_equal ["right"]
            multiple = Widget.Multiple_Choice [Choice.Option "By" "..By" [["column", Widget.Order_By from="other"]]]
            multiple.column_sources . should_equal ["other"]
            Widget.Vector_Editor item_editor=(Widget.Column_Name from="right") item_default="_" . column_sources . should_equal ["right"]
            twice = Widget.Single_Choice [Choice.Option "A" "..A" [["x", Widget.Column_Name from="right"], ["y", Widget.Column_Name from="right"]]]
            twice.column_sources . should_equal ["right"]

        group_builder.specify "column_sources looks into the kinds of a Union" <|
            union = Widget.Union [Pair.new "Text" Widget.Text_Input, Pair.new "Column" (Widget.Column_Name from="right")] include_nothing=True
            union.column_sources . should_equal ["right"]
            (Widget.Union [Pair.new "Text" Widget.Text_Input]).column_sources . should_equal []

    suite_builder.group "Widget to_json" group_builder->
        group_builder.specify "widget JSON carries no display or label" <|
            json = (Widget.Single_Choice [Choice.Option "A" "'A'"]).to_json
            expected = '{"constructor":"Single_Choice","values":[' + (Choice.Option "A" "'A'").to_json + ']}'
            json . should_equal expected
            json . should_not_contain '"display"'
            json . should_not_contain '"label":null'
            (Widget.Text_Input).to_json . should_equal '{"constructor":"Text_Input"}'

        group_builder.specify "a Union lists its kinds in order, each with its widget" <|
            union = Widget.Union [Pair.new "Text" Widget.Text_Input, Pair.new "Integer" Widget.Numeric_Input] include_nothing=True
            union.to_json . should_equal '{"constructor":"Union","kinds":[["Text",{"constructor":"Text_Input"}],["Integer",{"constructor":"Numeric_Input"}]],"include_nothing":true}'

        group_builder.specify "a Union without Nothing says so" <|
            union = Widget.Union [Pair.new "Locale" (Widget.Single_Choice [Choice.Option "A" "'A'"])]
            json = union.to_json . parse_json
            json.get "include_nothing" . should_be_false
            json.get "kinds" . first . first . should_equal "Locale"

        group_builder.specify "a Regex_Input" <| Widget.Regex_Input.to_json . should_equal '{"constructor":"Regex_Input"}'

        group_builder.specify "a Union nests inside a Vector_Editor" <|
            union = Widget.Union [Pair.new "Text" Widget.Text_Input] include_nothing=True
            editor = Widget.Vector_Editor item_editor=union item_default="''"
            editor.to_json . should_contain '"item_editor":{"constructor":"Union"'

    suite_builder.group "File_Format.dropdown_options" group_builder->
        group_builder.specify "names a registered format's type and file patterns" <|
            options = File_Format.dropdown_options [Auto_Detect]
            json = options.find o-> o.label == "JSON"
            json.value . should_equal "Standard.Base.System.File_Format.JSON_Format"
            json.requires . should_equal "Standard.Base.System.File_Format.JSON_Format"
            json.patterns . should_equal ["*.json", "*.geojson"]

        group_builder.specify "leaves Auto_Detect and Raw_Response without them" <|
            options = File_Format.dropdown_options [Auto_Detect, Raw_Response]
            options.first.label . should_equal "Auto Detect"
            options.first.requires . should_equal ""
            options.first.patterns . should_equal []
            raw = options.find o-> o.label == "Raw HTTP Response"
            raw.requires . should_equal ""
            raw.patterns . should_equal []

        group_builder.specify "uses the registered types it is given" <|
            options = File_Format.dropdown_options [Auto_Detect] []
            options.map .label . should_equal ["Auto Detect"]

main filter=Nothing =
    suite = Test.build suite_builder->
        add_specs suite_builder
    suite.run_with_filter filter
