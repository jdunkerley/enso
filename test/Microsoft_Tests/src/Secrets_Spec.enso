from Standard.Base import all
import Standard.Base.Enso_Cloud.Enso_Secret.Enso_Secret_Error
import Standard.Test.Test_Environment

from Standard.Microsoft import all

from Standard.Test import all

from enso_dev.Base_Tests.Network.Local_Secrets_Setup import with_local_secrets

## Resolving a local secret fails while the Azure credential is built, before
   any request is made, so none of these need Azure credentials or a network.
check_secret_errors make_secret_value make_action =
    secret = Enso_Secret.create "azure-secret" "not-a-real-value"
    Test_Environment.unsafe_with_environment_override "ENSO_SECRETS_KEY" Nothing <|
        (make_action (make_secret_value secret)) . catch . should_equal Enso_Secret_Error.Locked
    Test_Environment.unsafe_with_environment_override "ENSO_SECRETS_KEY" "AQECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8" <|
        (make_action (make_secret_value secret)) . catch . should_equal Enso_Secret_Error.Wrong_Key
    secret.delete . should_succeed
    (make_action (make_secret_value secret)) . catch . should_equal (Enso_Secret_Error.Not_Found "secret://azure-secret")

add_specs suite_builder =
    suite_builder.group "Azure credentials with an unreadable local secret" group_builder->
        group_builder.specify "Azure_Credential.Client_Secret gives an Enso_Secret_Error, not a panic" <| with_local_secrets <|
            check_secret_errors (secret-> Azure.login (..Client_Secret "tenant" "client" secret)) (cred-> Azure.subscriptions cred)

        group_builder.specify "Azure_Blob_Storage.SAS_Token gives an Enso_Secret_Error, not a panic" <| with_local_secrets <|
            check_secret_errors (secret-> ..SAS_Token secret) (cred-> Azure_Storage.blob_containers "account" cred=cred)

main filter=Nothing =
    suite = Test.build suite_builder->
        add_specs suite_builder
    suite.run_with_filter filter
