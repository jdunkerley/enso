from Standard.Base import all
import Standard.Base.Enso_Cloud.Enso_Secret.Enso_Secret_Error

import Standard.Test.Test_Environment

from Standard.AWS import all

from Standard.Test import all

from enso_dev.Base_Tests.Network.Local_Secrets_Setup import with_local_secrets

## Resolving a local secret fails while the AWS client is built, before any
   request is made, so none of these need AWS credentials or a network.
check_secret_errors make_action =
    secret = Enso_Secret.create "aws-secret-key" "not-a-real-key"
    credential = AWS_Credential.Key "AKIAEXAMPLE" secret
    Test_Environment.unsafe_with_environment_override "ENSO_SECRETS_KEY" Nothing <|
        (make_action credential) . catch . should_equal Enso_Secret_Error.Locked
    Test_Environment.unsafe_with_environment_override "ENSO_SECRETS_KEY" "AQECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8" <|
        (make_action credential) . catch . should_equal Enso_Secret_Error.Wrong_Key
    secret.delete . should_succeed
    (make_action credential) . catch . should_equal (Enso_Secret_Error.Not_Found "secret://aws-secret-key")

add_specs suite_builder =
    suite_builder.group "AWS_Credential.Key with an unreadable local secret" group_builder->
        group_builder.specify "AWS.signed_fetch gives an Enso_Secret_Error, not a panic" <| with_local_secrets <|
            check_secret_errors credential->
                AWS.signed_fetch "https://s3.us-east-1.amazonaws.com/example-bucket/key" credentials=credential

        group_builder.specify "S3.list_buckets gives an Enso_Secret_Error, not a panic" <| with_local_secrets <|
            check_secret_errors credential->
                S3.list_buckets credential

        group_builder.specify "sending email through SES gives an Enso_Secret_Error, not a panic" <| with_local_secrets <|
            check_secret_errors credential->
                provider = ..Amazon_SES (..Region "us-east-1") credentials=credential
                Email.send (..Address "a@example.com" "A") ["b@example.com"] subject="s" body=(..Plain_Text "b") provider=provider

main filter=Nothing =
    suite = Test.build suite_builder->
        add_specs suite_builder
    suite.run_with_filter filter
