from Standard.Base import all
import Standard.Base.Errors.Illegal_Argument.Illegal_Argument
import Standard.Base.Metadata.Choice
from Standard.Base.Metadata.Choice import Option
import Standard.Base.Metadata.Widget
import Standard.Base.Metadata.Widget_Query
import Standard.Base.Metadata.Column_Kind.Column_Kind
import Standard.Base.Metadata.Widget_Columns.Widget_Columns
from Standard.Base.Metadata.Widget_Query import Widget_Method

from Standard.Table import Table, Value_Type
import Standard.Table.Internal.Widget_Helpers
from Standard.Table.Columns_To_Add import Columns_To_Add
from Standard.Table.Columns_To_Keep import Columns_To_Keep
from Standard.Table.Join_Kind import Join_Kind
from Standard.Table.Rows_To_Read import Rows_To_Read

from Standard.Test import all

table_module = "Standard.Table.Table"
table_type = "Standard.Table.Table.Table"

@columns (Widget.Column_Names)
Table.widget_test_pick self columns = columns

Table.widget_test_expression self expression = expression

answer argument widget columns_json="" resolver="" = '{"arguments":[[' + argument.to_json + ',{"widget":' + widget.to_json + resolver + '}]]' + columns_json + '}'

## The `resolver` part of an answer whose widget depends on `dependencies`.
resolver_of dependencies searchable=False = ',"resolver":{"dependencies":' + dependencies.to_json + ',"searchable":' + searchable.to_json + '}'

## The result of the widget query for one argument of a Table method, with
   the other arguments' values given by `values` (a name to value function).
resolved table method argument values =
    call_arguments = Meta.get_method_argument_names table_module table_type method
    Widget_Query.resolve_argument (Widget_Method.Value table_module table_type method) argument table (Widget_Query.values_from_lookup values) "" call_arguments Nothing

## The `columns` block of an answer whose pickers all read the subject table.
subject_columns table = ',"columns":{"":' + (Widget_Columns.from table . to_json) + '}'

## Checks that the type has a `Widget.from` conversion and that `resolve_type`
   answers exactly that widget.
check_default typ =
    widget = Widget.from typ
    widget.should_be_a Widget
    type_name = Meta.meta typ . qualified_name
    Widget_Query.resolve_type type_name . should_equal ('{"widget":' + widget.to_json + '}')


## The widget resolved for `argument` of `method`, as parsed JSON.
widget_of table method argument =
    json = Widget_Query.resolve_call table table_module table_type method [argument] . parse_json
    json.get "arguments" . first . second . get "widget"

## The nested `parameter` widget of the option labelled `option`, found by
   looking for the option's own JSON in the answer.
answer_contains table method argument option_label parameter_widget =
    json = Widget_Query.resolve_call table table_module table_type method [argument]
    option = Option option_label option_label [[ "column", parameter_widget ]]
    json.contains option.to_json

add_specs suite_builder =
    suite_builder.group "Widgets for In-Memory with column name sets" group_builder->
        mock_table = Table.from_rows ["A", "B C", 'D "E"', "F.G/H\I"] []

        group_builder.specify "works for `get` and `at`" <|
            expect = answer "selector" Widget.Column_Name (subject_columns mock_table) (resolver_of ["self"])
            Widget_Query.resolve_call mock_table table_module table_type "get" ["selector"] . should_equal expect
            Widget_Query.resolve_call mock_table table_module table_type "at" ["selector"] . should_equal expect

        group_builder.specify "works for `filter`" <|
            expect = answer "column" (Widget.Column_Name expression=True) (subject_columns mock_table) (resolver_of ["self"])
            Widget_Query.resolve_call mock_table table_module table_type "filter" ["column"] . should_equal expect

        group_builder.specify "works for `join` with `right` table" <|
            abc = ["A", "B", "C"]
            uvw = ["U", "V", "W", "A"]
            self_mock_table = Table.from_rows abc []
            right_mock_table = Table.from_rows uvw []

            res = Standard.Table.Internal.Widget_Helpers.make_join_condition_selector self_mock_table right=right_mock_table
            res.should_be_a Widget.Vector_Editor

            arr = case res of
                Widget.Vector_Editor item _ -> item.values
                _ -> Test.fail "Expecting Vector_Editor"

            arr.length . should_equal 3

            labels = arr.map e->
                Meta.type_of e . should_equal Choice

                e.parameters.map f->
                    ignore_case = e.label == "Equals (Ignore Case)"
                    kinds = if ignore_case then [Column_Kind.Textual] else []
                    case f.first of
                        "left" -> f.second . should_equal (Widget.Column_Name kinds=kinds)
                        "right" -> f.second . should_equal (Widget.Column_Name kinds=kinds from="right")
                        "right_lower" -> f.second . should_equal (Widget.Column_Name from="right")
                        "right_upper" -> f.second . should_equal (Widget.Column_Name from="right")
                        _ -> Test.fail "Unexpected parameter "+f.first+" for "+e.first

                e.label

            labels . should_equal ['Equals', 'Equals (Ignore Case)', 'Between']

    suite_builder.group "Column pickers filter by the kinds their method accepts" group_builder->
        mock_table = Table.from_rows ["A", "B"] []
        textual = [Column_Kind.Textual]
        numeric = [Column_Kind.Numeric]

        group_builder.specify "aggregate offers numeric columns to numeric statistics and text columns to text ones" <|
            ["..Sum", "..Average", "..Median", "..Percentile", "..Standard_Deviation"].each label->
                answer_contains mock_table "aggregate" "columns" label (Widget.Column_Name kinds=numeric expression=True) . should_be_true
            ["..Count_Not_Empty", "..Count_Empty", "..Shortest", "..Longest"].each label->
                answer_contains mock_table "aggregate" "columns" label (Widget.Column_Name kinds=textual expression=True) . should_be_true
            ["..Count_Not_Nothing", "..Count_Nothing", "..Mode", "..Maximum", "..Minimum"].each label->
                answer_contains mock_table "aggregate" "columns" label (Widget.Column_Name expression=True) . should_be_true

        group_builder.specify "aggregate's Concatenate offers text columns" <|
            json = Widget_Query.resolve_call mock_table table_module table_type "aggregate" ["columns"]
            json.contains (Widget.Column_Name kinds=textual expression=True).to_json . should_be_true
            json.contains '"..Concatenate"' . should_be_true

        group_builder.specify "cross_tab's values shares the aggregate pickers" <|
            answer_contains mock_table "cross_tab" "values" "..Sum" (Widget.Column_Name kinds=numeric expression=True) . should_be_true

        group_builder.specify "text-only methods offer text columns" <|
            ["parse", "parse_json", "split_to_columns", "tokenize_to_columns", "fill_empty", "text_replace", "text_cleanse"].each method->
                (widget_of mock_table method "columns").get "kinds" . should_equal ["Textual"]
            ["split_to_rows", "tokenize_to_rows", "parse_to_columns"].each method->
                (widget_of mock_table method "column").get "kinds" . should_equal ["Textual"]
            ["term", "new_text"].each argument->
                (widget_of mock_table "text_replace" argument).get "kinds" . should_equal ["Textual"]

        group_builder.specify "methods taking any column keep every kind" <|
            [["select_columns", "columns"], ["distinct", "columns"], ["cast", "columns"], ["format", "columns"], ["filter", "column"]].each p->
                (widget_of mock_table p.first p.second).get "kinds" . should_equal []

        group_builder.specify "methods that look as if they need one kind but take every kind keep them" <|
            ## Each of these accepts a column of any kind: `expand_column` and `expand_to_rows` pass a
               value that is no object or aggregate through, `format` and `json_stringify` convert any
               value, `running`'s default statistic (`Count`) and `cross_tab`'s `names` take any column.
            [["expand_column", "columns"], ["expand_to_rows", "column"], ["json_stringify", "columns"], ["auto_cast", "columns"], ["transpose", "key_columns"], ["cross_tab", "names"], ["running", "of"], ["fill_nothing", "columns"], ["offset", "columns"], ["replace", "columns"]].each p->
                Test.with_clue p.first+" "+p.second+": " <|
                    (widget_of mock_table p.first p.second).get "kinds" . should_equal []

        group_builder.specify "join's Ignore Case condition offers text columns, Equals offers every kind" <|
            abc = Table.from_rows ["A", "B", "C"] []
            item = Standard.Table.Internal.Widget_Helpers.make_join_condition_selector abc right=abc . item_editor
            equals = item.values.find o-> o.label == "Equals"
            ci = item.values.find o-> o.label == "Equals (Ignore Case)"
            ci.parameters.map .second . should_equal [Widget.Column_Name kinds=textual, Widget.Column_Name kinds=textual from="right"]
            equals.parameters.map .second . should_equal [Widget.Column_Name, Widget.Column_Name from="right"]

        group_builder.specify "filter's Regex_Match pattern offers text columns" <|
            choice = Standard.Table.Internal.Widget_Helpers.make_filter_condition_selector mock_table
            text_group = choice.values.find o-> o.label == "Text"
            regex = text_group.value.find o-> o.label == "..Regex_Match"
            pattern = regex.parameters.first.second
            pattern.kinds . should_equal [Column_Kind.Textual]
            pattern.extra.map .label . should_equal ["<Regular Expression>"]

        group_builder.specify "the nested Regex_Match pattern picker travels as a picker in the filter answer" <|
            json = Widget_Query.resolve_call mock_table table_module table_type "filter" ["filter"] . parse_json
            choice = json.get "arguments" . first . second . get "widget"
            text_group = choice.get "values" . find o-> o.get "label" == "Text"
            regex = text_group.get "value" . find o-> o.get "label" == "..Regex_Match"
            pattern = regex.get "parameters" . first . second
            pattern.get "constructor" . should_equal "Column_Name"
            pattern.get "kinds" . should_equal ["Textual"]
            pattern.get "from" . should_equal Nothing

        group_builder.specify "set's Simple_Expression operands offer the kinds the operation accepts" <|
            json = Widget_Query.resolve_call mock_table table_module table_type "set" ["value"]
            kinds_for label parameter kinds_vector =
                Option label parameter [["rhs", Standard.Table.Internal.Widget_Helpers.make_column_ref_by_name_selector mock_table add_number=True kinds=kinds_vector]]
            json.contains (kinds_for "multiply" "..Multiply" numeric).to_json . should_be_true
            json.contains (kinds_for "divide" "..Divide" numeric).to_json . should_be_true
            json.contains (kinds_for "subtract" "..Subtract" [Column_Kind.Numeric, Column_Kind.Date_Only, Column_Kind.Date_And_Time, Column_Kind.Time_Only]).to_json . should_be_true
            json.contains '"kinds":["Logical"]' . should_be_true
            json.contains '"kinds":["Date_Only","Date_And_Time","Time_Only"]' . should_be_true
            json.contains '"kinds":["Numeric","Textual"]' . should_be_true

        group_builder.specify "generate_rows ranges offer numeric and date columns" <|
            json = Widget_Query.resolve_call mock_table table_module table_type "generate_rows" ["over"] "{}" False "" '{"over":"Standard.Table.Generate_Rows_Range.Generate_Rows_Range"}'
            json.contains '"kinds":["Numeric"]' . should_be_true
            json.contains '"kinds":["Date_Only"]' . should_be_true

    suite_builder.group "Table's resolvers read their dependencies by name" group_builder->
        t = Table.new [["A", [1, 2]], ["B", ["x", "y"]], ["D", [Date.new 2020, Date.new 2021]]]
        labels json = json.parse_json . get "widget" . get "values" . map (o-> o.get "label")

        group_builder.specify "filter's conditions follow the column's type" <|
            on_text = resolved t "filter" "filter" (name-> if name == "column" then "B" else Nothing) . to_json
            on_text . should_contain (resolver_of ["self", "column"])
            (labels on_text) . should_contain "Text"
            (labels on_text) . should_not_contain "Numeric"
            unset = resolved t "filter" "filter" (_-> Nothing) . to_json
            (labels unset) . should_contain "Numeric"
            (labels unset) . should_contain "Text"

        group_builder.specify "filter's column that is an error makes the argument unavailable" <|
            json = resolved t "filter" "filter" (_-> Error.throw (Illegal_Argument.Error "no column")) . to_json . parse_json
            json.get "widget" . should_equal Nothing
            json.get "unavailable" . get "dependency" . should_equal "column"

        group_builder.specify "join's right columns are offered only when right is set" <|
            with_right = resolved t "join" "on" (name-> if name == "right" then t else Nothing) . to_json
            with_right . should_contain (resolver_of ["self", "right"])
            with_right . should_contain (Widget.Column_Name from="right").to_json
            unset = resolved t "join" "on" (_-> Nothing) . to_json
            unset . should_not_contain '"from":"right"'

        group_builder.specify "rename_columns' new pair starts at the first name the map does not use" <|
            json = resolved t "rename_columns" "column_map" (name-> if name == "column_map" then ["X"] else Nothing) . to_json
            json . should_contain (resolver_of ["self", "column_map"])
            json.parse_json . get "widget" . get "item_default" . should_equal "(Pair.Value 'B' 'New Name')"

        group_builder.specify "format's formats follow the selected columns' types" <|
            json = resolved t "format" "format" (name-> if name == "columns" then ["D"] else Nothing) . to_json
            json . should_contain (resolver_of ["self", "columns"])
            json . should_contain (Widget_Helpers.make_format_chooser_for_type [Value_Type.Date]).to_json

        group_builder.specify "parse's formats follow the type argument" <|
            json = resolved t "parse" "format" (name-> if name == "type" then Value_Type.Date else Nothing) . to_json
            json . should_contain (resolver_of ["self", "type"])
            json . should_contain (Widget_Helpers.make_format_chooser_for_type Value_Type.Date).to_json

        group_builder.specify "fill_nothing's default follows the selected columns' types" <|
            json = resolved t "fill_nothing" "default" (name-> if name == "columns" then ["B"] else Nothing) . to_json
            json . should_contain (resolver_of ["self", "columns"])
            json . should_contain (Widget_Helpers.make_fill_default_value_selector t value_types=[(t.at "B").value_type]).to_json

    suite_builder.group "Group C type defaults are resolvers of the table" group_builder->
        t = Table.new [["A", [1]], ["B", ["x"]]]

        group_builder.specify "Simple_Expression's type default is a resolver of the table" <|
            Widget_Query.resolve_type "Standard.Table.Simple_Expression.Simple_Expression" . should_equal '{"widget":null,"resolver":{"dependencies":["self"],"searchable":false}}'

        group_builder.specify "set's value resolves Simple_Expression's widget against the table" <|
            json = Widget_Query.resolve_call t table_module table_type "set" ["value"] . parse_json
            result = json.get "arguments" . first . second
            result.get "resolver" . get "dependencies" . should_equal ["self"]
            result.get "widget" . get "constructor" . should_equal "Single_Choice"

        group_builder.specify "Generate_Rows_Range's type default is a resolver of the table" <|
            Widget_Query.resolve_type "Standard.Table.Generate_Rows_Range.Generate_Rows_Range" . should_equal '{"widget":null,"resolver":{"dependencies":["self"],"searchable":false}}'

        group_builder.specify "generate_rows' over resolves Generate_Rows_Range's widget against the table, through its type default" <|
            json = Widget_Query.resolve_call t table_module table_type "generate_rows" ["over"] "{}" False "" '{"over":"Standard.Table.Generate_Rows_Range.Generate_Rows_Range"}' . parse_json
            result = json.get "arguments" . first . second
            result.get "resolver" . get "dependencies" . should_equal ["self"]
            result.get "widget" . get "values" . map (o-> o.get "label") . should_equal ["..Integer_Range", "..Date_Range"]

        group_builder.specify "generate_rows' over has no annotation repeating its type default" <|
            Meta.get_method_annotation table_module table_type "generate_rows" "over" . should_equal Nothing

        group_builder.specify "type_defaults resolves an unannotated argument of that type against the table" <|
            json = Widget_Query.resolve_call t "enso_dev.Table_Tests.In_Memory.Table_Widgets_Spec" table_type "widget_test_expression" ["expression"] "{}" False "" '{"expression":"Standard.Table.Simple_Expression.Simple_Expression"}' . parse_json
            result = json.get "arguments" . first . second
            result.get "resolver" . get "dependencies" . should_equal ["self"]
            result.get "widget" . get "constructor" . should_equal "Single_Choice"

    suite_builder.group "Type defaults by conversion" group_builder->
        group_builder.specify "Columns_To_Add" <| check_default Columns_To_Add
        group_builder.specify "Columns_To_Keep" <| check_default Columns_To_Keep
        group_builder.specify "Join_Kind" <| check_default Join_Kind
        group_builder.specify "Rows_To_Read" <| check_default Rows_To_Read

    suite_builder.group "Widget_Columns.from" group_builder->
        group_builder.specify "an in-memory table: names, kinds and Value_Type names, in order" <|
            t = Table.new [["i", [1, 2]], ["f", [1.5, 2]], ["s", ["a", "b"]], ["b", [True, False]], ["d", [Date.new 2020, Date.new 2021]], ["m", [1, "a"]]]
            columns = Widget_Columns.from t
            columns.names . should_equal ["i", "f", "s", "b", "d", "m"]
            columns.kinds . should_equal [Column_Kind.Numeric, Column_Kind.Numeric, Column_Kind.Textual, Column_Kind.Logical, Column_Kind.Date_Only, Column_Kind.Other]
            columns.type_names . should_equal ["Integer", "Float", "Char", "Boolean", "Date", "Mixed"]

        group_builder.specify "a row: names, kinds from its values" <|
            row = (Table.new [["i", [1]], ["s", ["a"]]]).rows.first
            columns = Widget_Columns.from row
            columns.names . should_equal ["i", "s"]
            columns.kinds . should_equal [Column_Kind.Numeric, Column_Kind.Textual]
            columns.type_names . should_equal ["", ""]

        group_builder.specify "a recomputed table with the same schema converts equal" <|
            t1 = Table.new [["a", [1]], ["b", ["x"]]]
            t2 = t1.set (t1.at "a" + 1) as="a"
            (Widget_Columns.from t1) . should_equal (Widget_Columns.from t2)

        group_builder.specify "a recomputed table with a changed schema converts unequal" <|
            t1 = Table.new [["a", [1]], ["b", ["x"]]]
            retyped = t1.set (t1.at "a" . cast Value_Type.Char) as="a"
            (Widget_Columns.from t1) . should_not_equal (Widget_Columns.from retyped)
            added = t1.set (t1.at "a" + 1) as="c"
            (Widget_Columns.from t1) . should_not_equal (Widget_Columns.from added)

    suite_builder.group "Widget_Query.resolve_call on a Table" group_builder->
        group_builder.specify "a Table's answer carries its columns once" <|
            t = Table.new [["a", [1]], ["b", ["x"]]]
            json = Widget_Query.resolve_call t "enso_dev.Table_Tests.In_Memory.Table_Widgets_Spec" table_type "widget_test_pick" ["columns"] . parse_json
            json.get "columns" . get "" . get "kinds" . should_equal ["Numeric", "Textual"]

main filter=Nothing =
    suite = Test.build suite_builder->
        add_specs suite_builder
    suite.run_with_filter filter
