from Standard.Base import all
import Standard.Base.Metadata.Widget_Query

from Standard.Test import all

from enso_dev.Helpers.Widget_Table import make_table

## Every method the baseline measured, with its arguments.
queries = [["select_columns", ["columns"]], ["sort", ["columns"]], ["get", ["selector"]], ["filter", ["column", "filter"]], ["set", ["value"]], ["aggregate", ["group_by", "columns"]], ["cross_tab", ["group_by", "names", "values"]], ["join", ["on", "join_kind"]], ["fill_nothing", ["columns", "default"]], ["rename_columns", ["column_map"]], ["format", ["columns", "format"]], ["parse", ["columns", "type", "format"]]]

add_specs suite_builder =
    suite_builder.group "Widget answers for 500 columns stay under 50 KB" group_builder->
        table = make_table 500
        queries.each query->
            group_builder.specify query.first <|
                answer = Widget_Query.resolve_call table "Standard.Table.Table" "Standard.Table.Table.Table" query.first query.second
                answer.should_not_contain '"error"'
                (answer.length < 50*1024) . should_be_true
