from Standard.Base import all
import Standard.Base.Metadata.Widget_Query

from Standard.Table import Table

from Standard.Test import all

## A table of `width` columns of five kinds (integer, float, text, date,
   boolean) and 1000 rows. Copied from
   `test/Benchmarks/src/Widgets/Widget_Query_Bench.enso`: a test project cannot
   import the Benchmarks project.
make_table width =
    columns = 0.up_to width . map i->
        values = case i % 5 of
            0 -> 0.up_to 1000 . map j-> j+i
            1 -> 0.up_to 1000 . map j-> (j*0.5)+i
            2 -> 0.up_to 1000 . map j-> "t"+(j%50).to_text
            3 -> 0.up_to 1000 . map j-> (Date.new 2020 1 1) + (Period.new days=(j%365))
            _ -> 0.up_to 1000 . map j-> (j%2)==0
        ["c"+i.to_text, values]
    Table.new columns

## Every method the baseline measured, with its arguments.
queries = [["select_columns", ["columns"]], ["sort", ["columns"]], ["get", ["selector"]], ["filter", ["column", "filter"]], ["set", ["value"]], ["aggregate", ["group_by", "columns"]], ["cross_tab", ["group_by", "names", "values"]], ["join", ["on", "join_kind"]]]

add_specs suite_builder =
    suite_builder.group "Widget answers for 500 columns stay under 50 KB" group_builder->
        table = make_table 500
        queries.each query->
            group_builder.specify query.first <|
                answer = Widget_Query.resolve_call table "Standard.Table.Table" "Standard.Table.Table.Table" query.first query.second
                answer.should_not_contain '"error"'
                (answer.length < 50*1024) . should_be_true
